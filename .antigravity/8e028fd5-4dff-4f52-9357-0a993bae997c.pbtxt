        }
        lines {
          text: "      let badgeClass = \'bg-slate-200 text-slate-800\';"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      if (type === \'BUY\') {"
