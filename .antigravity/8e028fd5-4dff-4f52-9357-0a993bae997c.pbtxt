          text: "      const currentUpper = Number((baseline + atr * paramsRef.current.atrMultiplier).toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const currentLower = Number((baseline - atr * paramsRef.current.atrMultiplier).toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Dynamic stop loss: if in position, trail from entry price; otherwise below lower band"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      let currentStopLoss = currentLower - atr * paramsRef.current.stopLossMultiplier;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (positionRef.current.amount > 0 && positionRef.current.entryPrice) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        currentStopLoss = positionRef.current.entryPrice - atr * paramsRef.current.stopLossMultiplier;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      currentStopLoss = Number(currentStopLoss.toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      let eventType: \'BUY\' | \'SELL\' | \'STOP_LOSS\' | undefined = undefined;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Automated Strategy Execution Logic"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (paramsRef.current.isBotActive) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const { amount, entryPrice: posEntry } = positionRef.current;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Condition 1: BUY Signal (Price touches or drops below Lower ATR Band when FLAT)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (amount === 0 && nextPrice <= currentLower) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const allocateBudget = paramsRef.current.balance * (paramsRef.current.orderRatio / 100);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const buyQty = Number((allocateBudget / nextPrice).toFixed(4));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          if (allocateBudget > 10 && buyQty > 0) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            setBalance((b) => Number((b - allocateBudget).toFixed(2)));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            setPositionAmount(buyQty);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            setEntryPrice(nextPrice);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            eventType = \'BUY\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            playBeep(\'BUY\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            addLog({"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              type: \'BUY\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              price: nextPrice,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              amount: buyQty,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              reason: `\355\225\230\353\213\250 \353\247\244\354\210\230 \353\260\264\353\223\234 \355\204\260\354\271\230 (${formatPrice(currentLower)}) - \354\247\204\354\236\205 \353\271\204\354\234\250 ${paramsRef.current.orderRatio}% \353\247\244\354\210\230 \354\262\264\352\262\260`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Condition 2: TAKE PROFIT Signal (Price hits or exceeds Upper Band when LONG)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        else if (amount > 0 && posEntry && nextPrice >= currentUpper) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const sellProceeds = amount * nextPrice;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const invested = amount * posEntry;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const pnl = sellProceeds - invested;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const pnlPercent = ((nextPrice - posEntry) / posEntry) * 100;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          setBalance((b) => Number((b + sellProceeds).toFixed(2)));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          setTotalRealizedPnl((prev) => Number((prev + pnl).toFixed(2)));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          setTotalTrades((t) => t + 1);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          if (pnl > 0) setWinTrades((w) => w + 1);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          setPositionAmount(0);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          setEntryPrice(null);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          eventType = \'SELL\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          playBeep(\'SELL\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          addLog({"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            type: \'SELL\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            price: nextPrice,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            amount,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            pnl,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            pnlPercent,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            reason: `\354\203\201\353\213\250 \354\235\265\354\240\210 \353\260\264\353\223\234 \353\217\204\353\213\254 (${formatPrice(currentUpper)}) - \354\240\204\353\237\211 \354\235\265\354\240\210 \354\231\204\353\243\214 (+${pnlPercent.toFixed(2)}%)`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Condition 3: STOP LOSS Signal (Price drops below trailing Dynamic Stop Loss)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        else if (amount > 0 && posEntry && nextPrice <= currentStopLoss) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const sellProceeds = amount * nextPrice;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const invested = amount * posEntry;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const pnl = sellProceeds - invested;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const pnlPercent = ((nextPrice - posEntry) / posEntry) * 100;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          setBalance((b) => Number((b + sellProceeds).toFixed(2)));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          setTotalRealizedPnl((prev) => Number((prev + pnl).toFixed(2)));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          setTotalTrades((t) => t + 1);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          setPositionAmount(0);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          setEntryPrice(null);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          eventType = \'STOP_LOSS\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          playBeep(\'STOP\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          addLog({"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            type: \'STOP_LOSS\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            price: nextPrice,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            amount,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            pnl,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            pnlPercent,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            reason: `\353\217\231\354\240\201 \354\206\220\354\240\210\354\204\240 \354\235\264\355\203\210 (${formatPrice(currentStopLoss)}) - \353\246\254\354\212\244\355\201\254 \353\260\251\354\226\264 \354\240\204\353\237\211 \354\206\220\354\240\210 (-${Math.abs(pnlPercent).toFixed(2)}%)`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Append new tick to history"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const now = Date.now();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const dateObj = new Date(now);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const timeLabel = `${dateObj.getHours().toString().padStart(2, \'0\')}:${dateObj.getMinutes().toString().padStart(2, \'0\')}:${dateObj.getSeconds().toString().padStart(2, \'0\')}`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      setCurrentPrice(nextPrice);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      setPriceHistory((prev) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const updated = ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          ...prev.slice(-45),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            time: now,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            timeLabel,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            price: nextPrice,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            baseline,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            upperBand: currentUpper,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            lowerBand: currentLower,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            stopLoss: currentStopLoss,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            event: eventType"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        return updated;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }, tickSpeed);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return () => clearInterval(interval);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }, [market, tickSpeed, volatilityScale, selectedCoin]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Canvas Chart Renderer"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  useEffect(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const canvas = canvasRef.current;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (!canvas) return;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const ctx = canvas.getContext(\'2d\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (!ctx) return;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Handle high DPI"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const rect = canvas.getBoundingClientRect();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const dpr = window.devicePixelRatio || 1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    canvas.width = rect.width * dpr;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    canvas.height = rect.height * dpr;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ctx.scale(dpr, dpr);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const width = rect.width;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const height = rect.height;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const padding = { top: 28, right: 90, bottom: 32, left: 16 };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const chartWidth = width - padding.left - padding.right;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const chartHeight = height - padding.top - padding.bottom;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Clear"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ctx.clearRect(0, 0, width, height);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (priceHistory.length < 2) return;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Min / Max computation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let minPrice = Infinity;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let maxPrice = -Infinity;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    priceHistory.forEach((p) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      minPrice = Math.min(minPrice, p.price, p.lowerBand, p.stopLoss);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      maxPrice = Math.max(maxPrice, p.price, p.upperBand);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const priceRange = maxPrice - minPrice || 1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const paddedMin = minPrice - priceRange * 0.08;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const paddedMax = maxPrice + priceRange * 0.08;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const fullRange = paddedMax - paddedMin;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const getY = (val: number) => padding.top + chartHeight - ((val - paddedMin) / fullRange) * chartHeight;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const getX = (index: number) => padding.left + (index / (priceHistory.length - 1)) * chartWidth;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // 1. Draw Grid Lines"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ctx.strokeStyle = \'#f1f5f9\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ctx.lineWidth = 1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const gridSteps = 5;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    for (let i = 0; i <= gridSteps; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const y = padding.top + (i / gridSteps) * chartHeight;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.beginPath();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.moveTo(padding.left, y);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.lineTo(width - padding.right, y);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.stroke();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const priceVal = paddedMax - (i / gridSteps) * fullRange;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.fillStyle = \'#94a3b8\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.font = \'11px \"JetBrains Mono\", monospace\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.textAlign = \'left\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.fillText(formatPrice(priceVal, selectedCoin), width - padding.right + 10, y + 4);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // 2. Draw ATR Volatility Cloud (Shaded Area between Upper & Lower Band)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ctx.beginPath();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    for (let i = 0; i < priceHistory.length; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const x = getX(i);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const y = getY(priceHistory[i].upperBand);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (i === 0) ctx.moveTo(x, y);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      else ctx.lineTo(x, y);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    for (let i = priceHistory.length - 1; i >= 0; i--) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const x = getX(i);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const y = getY(priceHistory[i].lowerBand);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.lineTo(x, y);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ctx.closePath();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
