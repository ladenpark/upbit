        }
        lines {
          text: "      } else if (type === \'STOP_LOSS\') {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        colorClass = \'text-rose-900 bg-rose-50/70 border-rose-200\';"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        badgeClass = \'bg-rose-600 text-white\';"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      const item = document.createElement(\'div\');"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      item.className = \'p-2 rounded-lg border text-[11px] flex items-start gap-2 \' + colorClass;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      item.innerHTML = \\`"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        <span class=\"text-slate-400 shrink-0\">\\${timeStr}</span>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
