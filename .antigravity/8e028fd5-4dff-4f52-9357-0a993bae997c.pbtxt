      replacement_content: "import React, { useState, useEffect, useRef, useMemo } from \'react\';\nimport {\n  Play,\n  Square,\n  TrendingUp,\n  TrendingDown,\n  Activity,\n  Sliders,\n  Terminal,\n  RefreshCw,\n  Zap,\n  ArrowUpRight,\n  ArrowDownRight,\n  ShieldAlert,\n  Wallet,\n  DollarSign,\n  PieChart,\n  Copy,\n  Check,\n  Code,\n  Download,\n  AlertCircle,\n  BarChart2,\n  ChevronDown,\n  Volume2,\n  VolumeX,\n  Layers\n} from \'lucide-react\';\n\ninterface TradeLog {\n  id: string;\n  time: string;\n  type: \'BUY\' | \'SELL\' | \'STOP_LOSS\' | \'SYSTEM\' | \'SIGNAL\';\n  price: number;\n  reason: string;\n  amount?: number;\n  pnl?: number;\n  pnlPercent?: number;\n}\n\ninterface MarketData {\n  symbol: string;\n  name: string;\n  price: number;\n  basePrice: number;\n  atr: number;\n  change24h: number;\n  high24h: number;\n  low24h: number;\n  volatility: number;\n}\n\ninterface PricePoint {\n  time: number;\n  timeLabel: string;\n  price: number;\n  upperBand: number;\n  baseline: number;\n  lowerBand: number;\n  stopLoss: number;\n  event?: \'BUY\' | \'SELL\' | \'STOP_LOSS\';\n}\n\nconst COIN_CONFIGS: Record<string, MarketData> = {\n  \'BTC/USDT\': {\n    symbol: \'BTC/USDT\',\n    name: \'Bitcoin\',\n    price: 96450.0,\n    basePrice: 96450.0,\n    atr: 1250.0,\n    change24h: 3.42,\n    high24h: 97800.0,\n    low24h: 94100.0,\n    volatility: 0.012\n  },\n  \'ETH/USDT\': {\n    symbol: \'ETH/USDT\',\n    name: \'Ethereum\',\n    price: 2780.5,\n    basePrice: 2780.5,\n    atr: 48.0,\n    change24h: -1.15,\n    high24h: 2840.0,\n    low24h: 2710.0,\n    volatility: 0.018\n  },\n  \'SOL/USDT\': {\n    symbol: \'SOL/USDT\',\n    name: \'Solana\',\n    price: 194.2,\n    basePrice: 194.2,\n    atr: 4.8,\n    change24h: 5.68,\n    high24h: 198.5,\n    low24h: 182.0,\n    volatility: 0.025\n  },\n  \'XRP/USDT\': {\n    symbol: \'XRP/USDT\',\n    name: \'Ripple\',\n    price: 2.45,\n    basePrice: 2.45,\n    atr: 0.085,\n    change24h: 0.82,\n    high24h: 2.58,\n    low24h: 2.38,\n    volatility: 0.032\n  }\n};\n\nexport default function App() {\n  // Market & Coin state\n  const [selectedCoin, setSelectedCoin] = useState<string>(\'BTC/USDT\');\n  const market = COIN_CONFIGS[selectedCoin];\n\n  // Bot Configuration Parameters\n  const [isBotActive, setIsBotActive] = useState<boolean>(false);\n  const [atrMultiplier, setAtrMultiplier] = useState<number>(2.0);\n  const [orderRatio, setOrderRatio] = useState<number>(25); // % of balance\n  const [stopLossMultiplier, setStopLossMultiplier] = useState<number>(1.5);\n  const [tickSpeed, setTickSpeed] = useState<number>(1000); // 1 sec\n  const [volatilityScale, setVolatilityScale] = useState<number>(1.0);\n  const [soundEnabled, setSoundEnabled] = useState<boolean>(true);\n\n  // Financial & Trading State\n  const [balance, setBalance] = useState<number>(10000.0);\n  const [initialBalance] = useState<number>(10000.0);\n  const [positionAmount, setPositionAmount] = useState<number>(0);\n  const [entryPrice, setEntryPrice] = useState<number | null>(null);\n  const [totalRealizedPnl, setTotalRealizedPnl] = useState<number>(0);\n  const [totalTrades, setTotalTrades] = useState<number>(0);\n  const [winTrades, setWinTrades] = useState<number>(0);\n\n  // Price & History State\n  const [currentPrice, setCurrentPrice] = useState<number>(market.price);\n  const [priceHistory, setPriceHistory] = useState<PricePoint[]>([]);\n  const [logs, setLogs] = useState<TradeLog[]>([]);\n  const [logFilter, setLogFilter] = useState<\'ALL\' | \'BUY\' | \'SELL\' | \'STOP_LOSS\'>(\'ALL\');\n  const [showExportModal, setShowExportModal] = useState<boolean>(false);\n  const [copiedHtml, setCopiedHtml] = useState<boolean>(false);\n\n  // Refs for tracking state inside intervals\n  const currentPriceRef = useRef<number>(market.price);\n  const positionRef = useRef({ amount: positionAmount, entryPrice });\n  const paramsRef = useRef({ atrMultiplier, orderRatio, stopLossMultiplier, isBotActive, balance });\n  const logsEndRef = useRef<HTMLDivElement>(null);\n  const canvasRef = useRef<HTMLCanvasElement>(null);\n\n  // Sync refs\n  useEffect(() => {\n    currentPriceRef.current = currentPrice;\n  }, [currentPrice]);\n\n  useEffect(() => {\n    positionRef.current = { amount: positionAmount, entryPrice };\n  }, [positionAmount, entryPrice]);\n\n  useEffect(() => {\n    paramsRef.current = { atrMultiplier, orderRatio, stopLossMultiplier, isBotActive, balance };\n  }, [atrMultiplier, orderRatio, stopLossMultiplier, isBotActive, balance]);\n\n  // Audio tone synthesizer for simulated trading sounds\n  const playBeep = (type: \'BUY\' | \'SELL\' | \'STOP\') => {\n    if (!soundEnabled) return;\n    try {\n      const AudioContext = window.AudioContext || (window as unknown as { webkitAudioContext: typeof window.AudioContext }).webkitAudioContext;\n      if (!AudioContext) return;\n      const ctx = new AudioContext();\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.connect(gain);\n      gain.connect(ctx.destination);\n\n      if (type === \'BUY\') {\n        osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5\n        osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.15); // A5\n        gain.gain.setValueAtTime(0.12, ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.2);\n        osc.start();\n        osc.stop(ctx.currentTime + 0.2);\n      } else if (type === \'SELL\') {\n        osc.frequency.setValueAtTime(880, ctx.currentTime); // A5\n        osc.frequency.exponentialRampToValueAtTime(1174.66, ctx.currentTime + 0.18); // D6\n        gain.gain.setValueAtTime(0.15, ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);\n        osc.start();\n        osc.stop(ctx.currentTime + 0.25);\n      } else {\n        osc.frequency.setValueAtTime(440, ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(220, ctx.currentTime + 0.2);\n        gain.gain.setValueAtTime(0.15, ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);\n        osc.start();\n        osc.stop(ctx.currentTime + 0.25);\n      }\n    } catch {\n      // Audio context might be restricted before interaction\n    }\n  };\n\n  // Helper to format currency\n  const formatPrice = (p: number, coin = selectedCoin) => {\n    if (coin.includes(\'XRP\')) return `$${p.toFixed(4)}`;\n    if (coin.includes(\'SOL\') || coin.includes(\'ETH\')) return `$${p.toLocaleString(\'en-US\', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\n    return `$${p.toLocaleString(\'en-US\', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}`;\n  };\n\n  // Initialize Price History\n  useEffect(() => {\n    const base = market.price;\n    const atr = market.atr;\n    const initialPoints: PricePoint[] = [];\n    const now = Date.now();\n\n    let tempPrice = base;\n    for (let i = 40; i >= 0; i--) {\n      const time = now - i * 1000;\n      const noise = (Math.random() - 0.5) * (atr * 0.35);\n      tempPrice = Math.max(tempPrice + noise, base * 0.85);\n\n      const baseline = base + Math.sin(i * 0.2) * (atr * 0.4);\n      const upper = baseline + atr * atrMultiplier;\n      const lower = baseline - atr * atrMultiplier;\n      const stop = lower - atr * stopLossMultiplier;\n\n      const dateObj = new Date(time);\n      const timeLabel = `${dateObj.getHours().toString().padStart(2, \'0\')}:${dateObj.getMinutes().toString().padStart(2, \'0\')}:${dateObj.getSeconds().toString().padStart(2, \'0\')}`;\n\n      initialPoints.push({\n        time,\n        timeLabel,\n        price: Number(tempPrice.toFixed(2)),\n        baseline: Number(baseline.toFixed(2)),\n        upperBand: Number(upper.toFixed(2)),\n        lowerBand: Number(lower.toFixed(2)),\n        stopLoss: Number(stop.toFixed(2))\n      });\n    }\n\n    setPriceHistory(initialPoints);\n    setCurrentPrice(tempPrice);\n    currentPriceRef.current = tempPrice;\n\n    // Reset bot state when changing coin\n    setPositionAmount(0);\n    setEntryPrice(null);\n    setLogs((prev) => [\n      {\n        id: Math.random().toString(36).substring(7),\n        time: new Date().toLocaleTimeString(),\n        type: \'SYSTEM\',\n        price: tempPrice,\n        reason: `${selectedCoin} \355\216\230\354\226\264 \354\240\204\355\231\230 \354\231\204\353\243\214 | \352\270\260\354\244\200\352\260\200: ${formatPrice(tempPrice, selectedCoin)} | ATR: ${market.atr}`\n      },\n      ...prev\n    ]);\n  }, [selectedCoin]);\n\n  // Log handler\n  const addLog = (log: Omit<TradeLog, \'id\' | \'time\'>) => {\n    const newLog: TradeLog = {\n      ...log,\n      id: Math.random().toString(36).substring(7),\n      time: new Date().toLocaleTimeString()\n    };\n    setLogs((prev) => [newLog, ...prev.slice(0, 99)]);\n  };\n\n  // Bot Execution Loop\n  useEffect(() => {\n    const interval = setInterval(() => {\n      // Calculate next simulated price step using Ornstein-Uhlenbeck random walk around baseline\n      const base = market.basePrice;\n      const atr = market.atr;\n      const prevPrice = currentPriceRef.current;\n\n      // Random price motion\n      const meanReversion = (base - prevPrice) * 0.05;\n      const volatilityStep = (Math.random() - 0.49) * atr * 0.45 * volatilityScale;\n      const nextPrice = Number((prevPrice + meanReversion + volatilityStep).toFixed(selectedCoin.includes(\'XRP\') ? 4 : 2));\n\n      // Compute dynamic ATR bands\n      const baseline = Number((base + Math.sin(Date.now() / 8000) * (atr * 0.3)).toFixed(2));\n      const currentUpper = Number((baseline + atr * paramsRef.current.atrMultiplier).toFixed(2));\n      const currentLower = Number((baseline - atr * paramsRef.current.atrMultiplier).toFixed(2));\n\n      // Dynamic stop loss: if in position, trail from entry price; otherwise below lower band\n      let currentStopLoss = currentLower - atr * paramsRef.current.stopLossMultiplier;\n      if (positionRef.current.amount > 0 && positionRef.current.entryPrice) {\n        currentStopLoss = positionRef.current.entryPrice - atr * paramsRef.current.stopLossMultiplier;\n      }\n      currentStopLoss = Number(currentStopLoss.toFixed(2));\n\n      let eventType: \'BUY\' | \'SELL\' | \'STOP_LOSS\' | undefined = undefined;\n\n      // Automated Strategy Execution Logic\n      if (paramsRef.current.isBotActive) {\n        const { amount, entryPrice: posEntry } = positionRef.current;\n\n        // Condition 1: BUY Signal (Price touches or drops below Lower ATR Band when FLAT)\n        if (amount === 0 && nextPrice <= currentLower) {\n          const allocateBudget = paramsRef.current.balance * (paramsRef.current.orderRatio / 100);\n          const buyQty = Number((allocateBudget / nextPrice).toFixed(4));\n\n          if (allocateBudget > 10 && buyQty > 0) {\n            setBalance((b) => Number((b - allocateBudget).toFixed(2)));\n            setPositionAmount(buyQty);\n            setEntryPrice(nextPrice);\n            eventType = \'BUY\';\n            playBeep(\'BUY\');\n\n            addLog({\n              type: \'BUY\',\n              price: nextPrice,\n              amount: buyQty,\n              reason: `\355\225\230\353\213\250 \353\247\244\354\210\230 \353\260\264\353\223\234 \355\204\260\354\271\230 (${formatPrice(currentLower)}) - \354\247\204\354\236\205 \353\271\204\354\234\250 ${paramsRef.current.orderRatio}% \353\247\244\354\210\230 \354\262\264\352\262\260`\n            });\n          }\n        }\n        // Condition 2: TAKE PROFIT Signal (Price hits or exceeds Upper Band when LONG)\n        else if (amount > 0 && posEntry && nextPrice >= currentUpper) {\n          const sellProceeds = amount * nextPrice;\n          const invested = amount * posEntry;\n          const pnl = sellProceeds - invested;\n          const pnlPercent = ((nextPrice - posEntry) / posEntry) * 100;\n\n          setBalance((b) => Number((b + sellProceeds).toFixed(2)));\n          setTotalRealizedPnl((prev) => Number((prev + pnl).toFixed(2)));\n          setTotalTrades((t) => t + 1);\n          if (pnl > 0) setWinTrades((w) => w + 1);\n          setPositionAmount(0);\n          setEntryPrice(null);\n          eventType = \'SELL\';\n          playBeep(\'SELL\');\n\n          addLog({\n            type: \'SELL\',\n            price: nextPrice,\n            amount,\n            pnl,\n            pnlPercent,\n            reason: `\354\203\201\353\213\250 \354\235\265\354\240\210 \353\260\264\353\223\234 \353\217\204\353\213\254 (${formatPrice(currentUpper)}) - \354\240\204\353\237\211 \354\235\265\354\240\210 \354\231\204\353\243\214 (+${pnlPercent.toFixed(2)}%)`\n          });\n        }\n        // Condition 3: STOP LOSS Signal (Price drops below trailing Dynamic Stop Loss)\n        else if (amount > 0 && posEntry && nextPrice <= currentStopLoss) {\n          const sellProceeds = amount * nextPrice;\n          const invested = amount * posEntry;\n          const pnl = sellProceeds - invested;\n          const pnlPercent = ((nextPrice - posEntry) / posEntry) * 100;\n\n          setBalance((b) => Number((b + sellProceeds).toFixed(2)));\n          setTotalRealizedPnl((prev) => Number((prev + pnl).toFixed(2)));\n          setTotalTrades((t) => t + 1);\n          setPositionAmount(0);\n          setEntryPrice(null);\n          eventType = \'STOP_LOSS\';\n          playBeep(\'STOP\');\n\n          addLog({\n            type: \'STOP_LOSS\',\n            price: nextPrice,\n            amount,\n            pnl,\n            pnlPercent,\n            reason: `\353\217\231\354\240\201 \354\206\220\354\240\210\354\204\240 \354\235\264\355\203\210 (${formatPrice(currentStopLoss)}) - \353\246\254\354\212\244\355\201\254 \353\260\251\354\226\264 \354\240\204\353\237\211 \354\206\220\354\240\210 (-${Math.abs(pnlPercent).toFixed(2)}%)`\n          });\n        }\n      }\n\n      // Append new tick to history\n      const now = Date.now();\n      const dateObj = new Date(now);\n      const timeLabel = `${dateObj.getHours().toString().padStart(2, \'0\')}:${dateObj.getMinutes().toString().padStart(2, \'0\')}:${dateObj.getSeconds().toString().padStart(2, \'0\')}`;\n\n      setCurrentPrice(nextPrice);\n      setPriceHistory((prev) => {\n        const updated = [\n          ...prev.slice(-45),\n          {\n            time: now,\n            timeLabel,\n            price: nextPrice,\n            baseline,\n            upperBand: currentUpper,\n            lowerBand: currentLower,\n            stopLoss: currentStopLoss,\n            event: eventType\n          }\n        ];\n        return updated;\n      });\n    }, tickSpeed);\n\n    return () => clearInterval(interval);\n  }, [market, tickSpeed, volatilityScale, selectedCoin]);\n\n  // Canvas Chart Renderer\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    // Handle high DPI\n    const rect = canvas.getBoundingClientRect();\n    const dpr = window.devicePixelRatio || 1;\n    canvas.width = rect.width * dpr;\n    canvas.height = rect.height * dpr;\n    ctx.scale(dpr, dpr);\n\n    const width = rect.width;\n    const height = rect.height;\n    const padding = { top: 28, right: 90, bottom: 32, left: 16 };\n    const chartWidth = width - padding.left - padding.right;\n    const chartHeight = height - padding.top - padding.bottom;\n\n    // Clear\n    ctx.clearRect(0, 0, width, height);\n\n    if (priceHistory.length < 2) return;\n\n    // Min / Max computation\n    let minPrice = Infinity;\n    let maxPrice = -Infinity;\n\n    priceHistory.forEach((p) => {\n      minPrice = Math.min(minPrice, p.price, p.lowerBand, p.stopLoss);\n      maxPrice = Math.max(maxPrice, p.price, p.upperBand);\n    });\n\n    const priceRange = maxPrice - minPrice || 1;\n    const paddedMin = minPrice - priceRange * 0.08;\n    const paddedMax = maxPrice + priceRange * 0.08;\n    const fullRange = paddedMax - paddedMin;\n\n    const getY = (val: number) => padding.top + chartHeight - ((val - paddedMin) / fullRange) * chartHeight;\n    const getX = (index: number) => padding.left + (index / (priceHistory.length - 1)) * chartWidth;\n\n    // 1. Draw Grid Lines\n    ctx.strokeStyle = \'#f1f5f9\';\n    ctx.lineWidth = 1;\n    const gridSteps = 5;\n    for (let i = 0; i <= gridSteps; i++) {\n      const y = padding.top + (i / gridSteps) * chartHeight;\n      ctx.beginPath();\n      ctx.moveTo(padding.left, y);\n      ctx.lineTo(width - padding.right, y);\n      ctx.stroke();\n\n      const priceVal = paddedMax - (i / gridSteps) * fullRange;\n      ctx.fillStyle = \'#94a3b8\';\n      ctx.font = \'11px \"JetBrains Mono\", monospace\';\n      ctx.textAlign = \'left\';\n      ctx.fillText(formatPrice(priceVal, selectedCoin), width - padding.right + 10, y + 4);\n    }\n\n    // 2. Draw ATR Volatility Cloud (Shaded Area between Upper & Lower Band)\n    ctx.beginPath();\n    for (let i = 0; i < priceHistory.length; i++) {\n      const x = getX(i);\n      const y = getY(priceHistory[i].upperBand);\n      if (i === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    }\n    for (let i = priceHistory.length - 1; i >= 0; i--) {\n      const x = getX(i);\n      const y = getY(priceHistory[i].lowerBand);\n      ctx.lineTo(x, y);\n    }\n    ctx.closePath();\n    ctx.fillStyle = \'rgba(59, 130, 246, 0.04)\';\n    ctx.fill();\n\n    // 3. Draw Dynamic Stop Loss Line (Dashed Red/Rose)\n    ctx.beginPath();\n    ctx.strokeStyle = \'#f43f5e\';\n    ctx.lineWidth = 1.5;\n    ctx.setLineDash([4, 4]);\n    for (let i = 0; i < priceHistory.length; i++) {\n      const x = getX(i);\n      const y = getY(priceHistory[i].stopLoss);\n      if (i === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    }\n    ctx.stroke();\n    ctx.setLineDash([]); // Reset\n\n    // 4. Draw Lower Band (Buy Target: Indigo/Violet)\n    ctx.beginPath();\n    ctx.strokeStyle = \'#6366f1\';\n    ctx.lineWidth = 1.8;\n    ctx.setLineDash([5, 3]);\n    for (let i = 0; i < priceHistory.length; i++) {\n      const x = getX(i);\n      const y = getY(priceHistory[i].lowerBand);\n      if (i === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    }\n    ctx.stroke();\n    ctx.setLineDash([]);\n\n    // 5. Draw Baseline (Central EMA: Slate/Blue)\n    ctx.beginPath();\n    ctx.strokeStyle = \'#94a3b8\';\n    ctx.lineWidth = 1.2;\n    for (let i = 0; i < priceHistory.length; i++) {\n      const x = getX(i);\n      const y = getY(priceHistory[i].baseline);\n      if (i === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    }\n    ctx.stroke();\n\n    // 6. Draw Upper Band (Take Profit Target: Emerald Green)\n    ctx.beginPath();\n    ctx.strokeStyle = \'#10b981\';\n    ctx.lineWidth = 1.8;\n    ctx.setLineDash([5, 3]);\n    for (let i = 0; i < priceHistory.length; i++) {\n      const x = getX(i);\n      const y = getY(priceHistory[i].upperBand);\n      if (i === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    }\n    ctx.stroke();\n    ctx.setLineDash([]);\n\n    // 7. Draw Main Price Line with subtle gradient glow\n    ctx.beginPath();\n    for (let i = 0; i < priceHistory.length; i++) {\n      const x = getX(i);\n      const y = getY(priceHistory[i].price);\n      if (i === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    }\n    ctx.strokeStyle = \'#2563eb\';\n    ctx.lineWidth = 2.5;\n    ctx.lineJoin = \'round\';\n    ctx.lineCap = \'round\';\n    ctx.stroke();\n\n    // 8. Draw Buy/Sell Trade Event Markers on Chart\n    priceHistory.forEach((p, idx) => {\n      if (!p.event) return;\n      const x = getX(idx);\n      const y = getY(p.price);\n\n      ctx.save();\n      if (p.event === \'BUY\') {\n        // Green buy triangle\n        ctx.fillStyle = \'#10b981\';\n        ctx.beginPath();\n        ctx.moveTo(x, y + 14);\n        ctx.lineTo(x - 6, y + 26);\n        ctx.lineTo(x + 6, y + 26);\n        ctx.closePath();\n        ctx.fill();\n        ctx.fillStyle = \'#065f46\';\n        ctx.font = \'bold 9px sans-serif\';\n        ctx.textAlign = \'center\';\n        ctx.fillText(\'BUY\', x, y + 36);\n      } else if (p.event === \'SELL\') {\n        // Green take-profit sell triangle\n        ctx.fillStyle = \'#059669\';\n        ctx.beginPath();\n        ctx.moveTo(x, y - 14);\n        ctx.lineTo(x - 6, y - 26);\n        ctx.lineTo(x + 6, y - 26);\n        ctx.closePath();\n        ctx.fill();\n        ctx.fillStyle = \'#047857\';\n        ctx.font = \'bold 9px sans-serif\';\n        ctx.textAlign = \'center\';\n        ctx.fillText(\'TP SELL\', x, y - 30);\n      } else if (p.event === \'STOP_LOSS\') {\n        // Red stop loss triangle\n        ctx.fillStyle = \'#e11d48\';\n        ctx.beginPath();\n        ctx.moveTo(x, y + 14);\n        ctx.lineTo(x - 6, y + 26);\n        ctx.lineTo(x + 6, y + 26);\n        ctx.closePath();\n        ctx.fill();\n        ctx.fillStyle = \'#9f1239\';\n        ctx.font = \'bold 9px sans-serif\';\n        ctx.textAlign = \'center\';\n        ctx.fillText(\'STOP\', x, y + 36);\n      }\n      ctx.restore();\n    });\n\n    // 9. Draw Current Price Tag on Right Axis\n    const lastPoint = priceHistory[priceHistory.length - 1];\n    const currentY = getY(lastPoint.price);\n    const upperY = getY(lastPoint.upperBand);\n    const lowerY = getY(lastPoint.lowerBand);\n    const stopY = getY(lastPoint.stopLoss);\n\n    // Current price badge on axis\n    ctx.fillStyle = \'#2563eb\';\n    ctx.beginPath();\n    ctx.roundRect(width - padding.right + 4, currentY - 11, padding.right - 10, 22, 4);\n    ctx.fill();\n    ctx.fillStyle = \'#ffffff\';\n    ctx.font = \'bold 11px \"JetBrains Mono\", monospace\';\n    ctx.textAlign = \'left\';\n    ctx.fillText(formatPrice(lastPoint.price, selectedCoin), width - padding.right + 10, currentY + 4);\n\n    // Guide horizontal dashed line to current price\n    ctx.beginPath();\n    ctx.strokeStyle = \'rgba(37, 99, 235, 0.4)\';\n    ctx.lineWidth = 1;\n    ctx.setLineDash([3, 3]);\n    ctx.moveTo(padding.left, currentY);\n    ctx.lineTo(width - padding.right, currentY);\n    ctx.stroke();\n    ctx.setLineDash([]);\n\n    // Band Level Tags on right\n    ctx.font = \'9px \"JetBrains Mono\", monospace\';\n    // Upper\n    ctx.fillStyle = \'#059669\';\n    ctx.fillText(`TP ${formatPrice(lastPoint.upperBand, selectedCoin)}`, width - padding.right + 6, upperY - 4);\n    // Lower\n    ctx.fillStyle = \'#4f46e5\';\n    ctx.fillText(`BUY ${formatPrice(lastPoint.lowerBand, selectedCoin)}`, width - padding.right + 6, lowerY + 12);\n    // Stop\n    ctx.fillStyle = \'#e11d48\';\n    ctx.fillText(`SL ${formatPrice(lastPoint.stopLoss, selectedCoin)}`, width - padding.right + 6, stopY + 12);\n  }, [priceHistory, selectedCoin, atrMultiplier, stopLossMultiplier]);\n\n  // Position calculations\n  const unrealizedPnl = useMemo(() => {\n    if (positionAmount === 0 || !entryPrice) return 0;\n    return (currentPrice - entryPrice) * positionAmount;\n  }, [positionAmount, entryPrice, currentPrice]);\n\n  const unrealizedPnlPercent = useMemo(() => {\n    if (positionAmount === 0 || !entryPrice) return 0;\n    return ((currentPrice - entryPrice) / entryPrice) * 100;\n  }, [positionAmount, entryPrice, currentPrice]);\n\n  const currentEquity = balance + positionAmount * currentPrice;\n  const totalReturnPercent = ((currentEquity - initialBalance) / initialBalance) * 100;\n  const winRate = totalTrades > 0 ? ((winTrades / totalTrades) * 100).toFixed(1) : \'0.0\';\n\n  // Manual Trigger controls\n  const handleManualBuy = () => {\n    if (positionAmount > 0) return;\n    const allocateBudget = balance * (orderRatio / 100);\n    const buyQty = Number((allocateBudget / currentPrice).toFixed(4));\n    if (allocateBudget <= 0) return;\n\n    setBalance((b) => Number((b - allocateBudget).toFixed(2)));\n    setPositionAmount(buyQty);\n    setEntryPrice(currentPrice);\n    playBeep(\'BUY\');\n    addLog({\n      type: \'BUY\',\n      price: currentPrice,\n      amount: buyQty,\n      reason: `[\354\210\230\353\217\231 \354\243\274\353\254\270] \354\213\234\354\236\245\352\260\200 \353\247\244\354\210\230 \354\262\264\352\262\260 - \355\210\254\354\236\220\352\270\210 $${allocateBudget.toFixed(2)}`\n    });\n  };\n\n  const handleManualSell = () => {\n    if (positionAmount === 0 || !entryPrice) return;\n    const proceeds = positionAmount * currentPrice;\n    const invested = positionAmount * entryPrice;\n    const pnl = proceeds - invested;\n    const pnlPercent = ((currentPrice - entryPrice) / entryPrice) * 100;\n\n    setBalance((b) => Number((b + proceeds).toFixed(2)));\n    setTotalRealizedPnl((prev) => Number((prev + pnl).toFixed(2)));\n    setTotalTrades((t) => t + 1);\n    if (pnl > 0) setWinTrades((w) => w + 1);\n    setPositionAmount(0);\n    setEntryPrice(null);\n    playBeep(\'SELL\');\n\n    addLog({\n      type: \'SELL\',\n      price: currentPrice,\n      amount: positionAmount,\n      pnl,\n      pnlPercent,\n      reason: `[\354\210\230\353\217\231 \354\262\255\354\202\260] \354\213\234\354\236\245\352\260\200 \354\240\204\353\237\211 \353\247\244\353\217\204 \354\262\264\352\262\260 (${pnl >= 0 ? \'+\' : \'\'}$${pnl.toFixed(2)}, ${pnlPercent.toFixed(2)}%)`\n    });\n  };\n\n  const handleToggleBot = () => {\n    const nextState = !isBotActive;\n    setIsBotActive(nextState);\n    addLog({\n      type: \'SYSTEM\',\n      price: currentPrice,\n      reason: nextState\n        ? `\360\237\244\226 ATR \353\263\200\353\217\231\354\204\261 \355\212\270\353\240\210\354\235\264\353\224\251 \353\264\207 \352\260\200\353\217\231 \354\213\234\354\236\221 [\353\260\260\354\210\230: ${atrMultiplier}x | \354\243\274\353\254\270\353\271\204\354\234\250: ${orderRatio}% | \354\243\274\352\270\260: ${tickSpeed / 1000}s]`\n        : `\360\237\233\221 ATR \355\212\270\353\240\210\354\235\264\353\224\251 \353\264\207 \352\260\200\353\217\231 \354\240\225\354\247\200 (\354\210\230\353\217\231 \353\214\200\352\270\260 \353\252\250\353\223\234)`\n    });\n  };\n\n  const handleResetSimulation = () => {\n    setBalance(10000);\n    setPositionAmount(0);\n    setEntryPrice(null);\n    setTotalRealizedPnl(0);\n    setTotalTrades(0);\n    setWinTrades(0);\n    setLogs([\n      {\n        id: Math.random().toString(36).substring(7),\n        time: new Date().toLocaleTimeString(),\n        type: \'SYSTEM\',\n        price: currentPrice,\n        reason: \'\360\237\224\204 \354\213\234\353\256\254\353\240\210\354\235\264\354\205\230 \353\260\217 \352\260\200\354\203\201 \354\236\224\352\263\240 \354\264\210\352\270\260\355\231\224 ($10,000 USD)\'\n      }\n    ]);\n  };\n\n  // Generate self-contained Single HTML snippet for download/view\n  const singleHtmlCode = useMemo(() => {\n    return `<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>ATR Volatility Trading Bot - Single HTML Prototype</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <!-- Lucide Icons -->\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n  <!-- Google Fonts -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n  <style>\n    body { font-family: \'Plus Jakarta Sans\', sans-serif; }\n    .mono { font-family: \'JetBrains Mono\', monospace; }\n    @keyframes pulse-ring {\n      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.7); }\n      70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(37, 99, 235, 0); }\n      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0); }\n    }\n    .pulse-dot {\n      animation: pulse-ring 1.5s cubic-bezier(0.45, 0, 0.55, 1) infinite;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen\">\n  <!-- Top Navigation -->\n  <header class=\"bg-white border-b border-slate-200 px-6 py-3 sticky top-0 z-30 flex items-center justify-between shadow-sm\">\n    <div class=\"flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-blue-600 flex items-center justify-center text-white shadow-sm font-bold\">\n        <i data-lucide=\"activity\" class=\"w-5 h-5\"></i>\n      </div>\n      <div>\n        <h1 class=\"font-bold text-slate-900 leading-none text-base\">ATR QUANT BOT</h1>\n        <span class=\"text-xs text-slate-500 font-medium\">\353\263\200\353\217\231\354\204\261 \353\260\264\353\223\234 \354\236\220\353\217\231\353\247\244\353\247\244 \355\224\204\353\241\234\355\206\240\355\203\200\354\236\205</span>\n      </div>\n    </div>\n\n    <!-- Active Asset Indicator -->\n    <div class=\"flex items-center gap-6\">\n      <div class=\"flex items-center gap-2 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200\">\n        <span class=\"text-xs font-semibold text-slate-600\">PAIR:</span>\n        <select id=\"coinSelect\" class=\"bg-transparent font-bold text-sm text-slate-900 focus:outline-none cursor-pointer\">\n          <option value=\"BTC/USDT\">BTC / USDT</option>\n          <option value=\"ETH/USDT\">ETH / USDT</option>\n          <option value=\"SOL/USDT\">SOL / USDT</option>\n        </select>\n      </div>\n\n      <div class=\"flex items-center gap-3\">\n        <div class=\"text-right\">\n          <div id=\"livePriceHeader\" class=\"text-base font-extrabold mono text-slate-900\">$96,450.0</div>\n          <div id=\"liveChangeHeader\" class=\"text-xs font-semibold text-emerald-600\">+3.42% (24h)</div>\n        </div>\n\n        <!-- Bot Toggle Button -->\n        <button id=\"botToggleBtn\" class=\"flex items-center gap-2 px-4 py-2 rounded-lg font-bold text-sm bg-blue-600 text-white hover:bg-blue-700 transition shadow-sm\">\n          <i data-lucide=\"play\" class=\"w-4 h-4\"></i>\n          <span id=\"botToggleLabel\">\353\264\207 \352\260\200\353\217\231 (START)</span>\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Main Container -->\n  <main class=\"max-w-7xl mx-auto px-6 py-6 space-y-6\">\n    <!-- Stat Metrics Row -->\n    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n      <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm\">\n        <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1\">\354\264\235 \354\236\220\354\202\260 \352\260\200\354\271\230 (Equity)</div>\n        <div id=\"equityDisplay\" class=\"text-2xl font-bold mono text-slate-900\">$10,000.00</div>\n        <div id=\"totalReturnDisplay\" class=\"text-xs font-medium text-slate-500 mt-1\">\354\210\230\354\235\265\353\245\240: 0.00%</div>\n      </div>\n      <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm\">\n        <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1\">\353\263\264\354\234\240 \355\217\254\354\247\200\354\205\230 (Position)</div>\n        <div id=\"positionDisplay\" class=\"text-2xl font-bold mono text-slate-900\">FLAT (0.00)</div>\n        <div id=\"unrealizedPnlDisplay\" class=\"text-xs font-medium text-slate-500 mt-1\">\353\257\270\354\213\244\355\230\204 \354\206\220\354\235\265: $0.00 (0.00%)</div>\n      </div>\n      <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm\">\n        <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1\">\355\230\204\354\236\254 ATR \354\247\200\355\221\234 (\353\263\200\353\217\231\355\217\255)</div>\n        <div id=\"atrDisplay\" class=\"text-2xl font-bold mono text-blue-600\">$1,250.0</div>\n        <div class=\"text-xs font-medium text-slate-500 mt-1\">\353\217\231\354\240\201 \354\261\204\353\204\220 \355\217\255: \302\2612.0x ATR</div>\n      </div>\n      <div class=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm\">\n        <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1\">\353\210\204\354\240\201 \354\262\264\352\262\260 \353\260\217 \354\212\271\353\245\240</div>\n        <div id=\"winRateDisplay\" class=\"text-2xl font-bold mono text-emerald-600\">0.0% <span class=\"text-xs text-slate-500 font-normal\">(0\355\232\214 \354\262\264\352\262\260)</span></div>\n        <div id=\"realizedPnlDisplay\" class=\"text-xs font-medium text-slate-500 mt-1\">\354\213\244\355\230\204 \354\206\220\354\235\265: $0.00</div>\n      </div>\n    </div>\n\n    <!-- Chart Canvas Section -->\n    <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4\">\n      <div class=\"flex items-center justify-between\">\n        <div class=\"flex items-center gap-4\">\n          <h2 class=\"font-bold text-slate-900 text-lg flex items-center gap-2\">\n            <span>\353\263\200\353\217\231\354\204\261 ATR \353\260\264\353\223\234 \354\213\244\354\213\234\352\260\204 \354\213\234\352\260\201\355\231\224</span>\n            <span id=\"botStatusBadge\" class=\"text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600\">\353\214\200\352\270\260 \354\244\221 (IDLE)</span>\n          </h2>\n          <!-- Legend -->\n          <div class=\"hidden sm:flex items-center gap-4 text-xs font-medium\">\n            <span class=\"flex items-center gap-1 text-emerald-600\"><span class=\"w-3 h-0.5 bg-emerald-500 inline-block\"></span> \354\203\201\353\213\250 \353\260\264\353\223\234 (\354\235\265\354\240\210\354\204\240)</span>\n            <span class=\"flex items-center gap-1 text-slate-500\"><span class=\"w-3 h-0.5 bg-slate-400 inline-block\"></span> \352\270\260\354\244\200\354\204\240 (EMA)</span>\n            <span class=\"flex items-center gap-1 text-indigo-600\"><span class=\"w-3 h-0.5 bg-indigo-500 inline-block\"></span> \355\225\230\353\213\250 \353\260\264\353\223\234 (\353\247\244\354\210\230\354\204\240)</span>\n            <span class=\"flex items-center gap-1 text-rose-500\"><span class=\"w-3 h-0.5 bg-rose-500 inline-block\"></span> \353\217\231\354\240\201 \354\206\220\354\240\210\354\204\240 (Stop-Loss)</span>\n          </div>\n        </div>\n\n        <div class=\"flex items-center gap-2\">\n          <button id=\"manualBuyBtn\" class=\"px-3 py-1.5 text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg hover:bg-emerald-100 transition\">\n            \354\210\230\353\217\231 \353\247\244\354\210\230 (BUY)\n          </button>\n          <button id=\"manualSellBtn\" class=\"px-3 py-1.5 text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200 rounded-lg hover:bg-rose-100 transition\">\n            \354\210\230\353\217\231 \354\262\255\354\202\260 (SELL)\n          </button>\n        </div>\n      </div>\n\n      <!-- Chart Container -->\n      <div class=\"relative w-full h-[360px] bg-slate-50 rounded-xl border border-slate-200 overflow-hidden\">\n        <canvas id=\"tradingChart\" class=\"w-full h-full block\"></canvas>\n      </div>\n    </div>\n\n    <!-- Bottom Controls & Logs Grid -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n      <!-- Strategy Parameter Sliders -->\n      <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-5\">\n        <div class=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n          <h3 class=\"font-bold text-slate-900 text-sm flex items-center gap-2\">\n            <i data-lucide=\"sliders\" class=\"w-4 h-4 text-blue-600\"></i>\n            \354\240\204\353\236\265 \355\214\214\353\235\274\353\257\270\355\204\260 \354\241\260\354\240\210\n          </h3>\n          <button id=\"resetParamsBtn\" class=\"text-xs text-slate-500 hover:text-blue-600 font-medium\">\354\264\210\352\270\260\355\231\224</button>\n        </div>\n\n        <!-- ATR Multiplier Slider -->\n        <div class=\"space-y-2\">\n          <div class=\"flex justify-between text-xs font-semibold\">\n            <span class=\"text-slate-600\">ATR \353\260\264\353\223\234 \353\260\260\354\210\230 (Multiplier)</span>\n            <span id=\"atrMultiplierVal\" class=\"text-blue-600 mono font-bold\">2.0x</span>\n          </div>\n          <input id=\"atrMultiplierInput\" type=\"range\" min=\"1.0\" max=\"4.0\" step=\"0.1\" value=\"2.0\" class=\"w-full accent-blue-600 cursor-pointer\">\n          <div class=\"flex justify-between text-[10px] text-slate-400 font-mono\">\n            <span>1.0x (\355\203\200\354\235\264\355\212\270\355\225\234 \354\261\204\353\204\220)</span>\n            <span>4.0x (\353\204\223\354\235\200 \354\261\204\353\204\220)</span>\n          </div>\n        </div>\n\n        <!-- Order Ratio Slider -->\n        <div class=\"space-y-2\">\n          <div class=\"flex justify-between text-xs font-semibold\">\n            <span class=\"text-slate-600\">1\355\232\214 \354\243\274\353\254\270 \354\236\220\354\202\260 \353\271\204\354\244\221 (Order Size)</span>\n            <span id=\"orderRatioVal\" class=\"text-blue-600 mono font-bold\">25%</span>\n          </div>\n          <input id=\"orderRatioInput\" type=\"range\" min=\"5\" max=\"100\" step=\"5\" value=\"25\" class=\"w-full accent-blue-600 cursor-pointer\">\n          <div class=\"flex justify-between text-[10px] text-slate-400 font-mono\">\n            <span>5% (\353\266\204\355\225\240 \353\263\264\354\210\230\354\240\201)</span>\n            <span>100% (\354\240\204\353\237\211 \353\252\260\353\271\265)</span>\n          </div>\n        </div>\n\n        <!-- Stop Loss Multiplier Slider -->\n        <div class=\"space-y-2\">\n          <div class=\"flex justify-between text-xs font-semibold\">\n            <span class=\"text-slate-600\">\353\217\231\354\240\201 \354\206\220\354\240\210 \353\260\260\354\210\230 (Stop Loss ATR)</span>\n            <span id=\"stopLossVal\" class=\"text-rose-600 mono font-bold\">1.5x</span>\n          </div>\n          <input id=\"stopLossInput\" type=\"range\" min=\"0.5\" max=\"3.0\" step=\"0.1\" value=\"1.5\" class=\"w-full accent-rose-600 cursor-pointer\">\n          <div class=\"flex justify-between text-[10px] text-slate-400 font-mono\">\n            <span>0.5x (\353\271\240\353\245\270 \354\206\220\354\240\210)</span>\n            <span>3.0x (\354\227\254\354\234\240 \354\206\220\354\240\210)</span>\n          </div>\n        </div>\n\n        <!-- Simulation Speed -->\n        <div class=\"pt-2 border-t border-slate-100 flex items-center justify-between\">\n          <span class=\"text-xs font-semibold text-slate-600\">\355\213\261 \352\260\261\354\213\240 \354\243\274\352\270\260</span>\n          <div class=\"flex gap-1\">\n            <button class=\"speed-btn px-2.5 py-1 text-xs font-bold rounded bg-blue-50 text-blue-600 border border-blue-200\" data-speed=\"1000\">1\354\264\210</button>\n            <button class=\"speed-btn px-2.5 py-1 text-xs font-medium rounded bg-slate-100 text-slate-600 hover:bg-slate-200\" data-speed=\"500\">0.5\354\264\210</button>\n          </div>\n        </div>\n      </div>\n\n      <!-- Real-time Virtual Trading Logs -->\n      <div class=\"lg:col-span-2 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col h-[340px]\">\n        <div class=\"flex items-center justify-between border-b border-slate-100 pb-3 mb-3\">\n          <div class=\"flex items-center gap-2\">\n            <i data-lucide=\"terminal\" class=\"w-4 h-4 text-slate-700\"></i>\n            <h3 class=\"font-bold text-slate-900 text-sm\">\354\213\244\354\213\234\352\260\204 \352\260\200\354\203\201 \354\262\264\352\262\260 \353\241\234\352\267\270</h3>\n            <span id=\"logCountBadge\" class=\"text-[10px] font-mono font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full\">0\352\261\264</span>\n          </div>\n          <button id=\"clearLogsBtn\" class=\"text-xs text-slate-400 hover:text-slate-700 font-medium\">\354\247\200\354\232\260\352\270\260</button>\n        </div>\n\n        <div id=\"logsContainer\" class=\"flex-1 overflow-y-auto space-y-2 pr-1 mono text-xs\">\n          <!-- Live Logs Rendered via JS -->\n        </div>\n      </div>\n    </div>\n  </main>\n\n  <script>\n    // Initialize Lucide Icons\n    lucide.createIcons();\n\n    // Application State\n    const state = {\n      isBotActive: false,\n      selectedCoin: \'BTC/USDT\',\n      price: 96450.0,\n      basePrice: 96450.0,\n      atr: 1250.0,\n      atrMultiplier: 2.0,\n      orderRatio: 25,\n      stopLossMultiplier: 1.5,\n      balance: 10000.0,\n      initialBalance: 10000.0,\n      positionAmount: 0,\n      entryPrice: null,\n      realizedPnl: 0,\n      totalTrades: 0,\n      winTrades: 0,\n      tickSpeed: 1000,\n      history: []\n    };\n\n    // DOM References\n    const livePriceHeader = document.getElementById(\'livePriceHeader\');\n    const botToggleBtn = document.getElementById(\'botToggleBtn\');\n    const botToggleLabel = document.getElementById(\'botToggleLabel\');\n    const botStatusBadge = document.getElementById(\'botStatusBadge\');\n    const equityDisplay = document.getElementById(\'equityDisplay\');\n    const positionDisplay = document.getElementById(\'positionDisplay\');\n    const unrealizedPnlDisplay = document.getElementById(\'unrealizedPnlDisplay\');\n    const atrDisplay = document.getElementById(\'atrDisplay\');\n    const winRateDisplay = document.getElementById(\'winRateDisplay\');\n    const realizedPnlDisplay = document.getElementById(\'realizedPnlDisplay\');\n    const logsContainer = document.getElementById(\'logsContainer\');\n    const logCountBadge = document.getElementById(\'logCountBadge\');\n    const canvas = document.getElementById(\'tradingChart\');\n    const ctx = canvas.getContext(\'2d\');\n\n    // Sliders\n    const atrMultiplierInput = document.getElementById(\'atrMultiplierInput\');\n    const atrMultiplierVal = document.getElementById(\'atrMultiplierVal\');\n    const orderRatioInput = document.getElementById(\'orderRatioInput\');\n    const orderRatioVal = document.getElementById(\'orderRatioVal\');\n    const stopLossInput = document.getElementById(\'stopLossInput\');\n    const stopLossVal = document.getElementById(\'stopLossVal\');\n\n    // Format helper\n    function fmt(num) {\n      return \'$\' + Number(num).toLocaleString(\'en-US\', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n    }\n\n    // Add log\n    let logCounter = 0;\n    function appendLog(type, text, price) {\n      logCounter++;\n      logCountBadge.textContent = logCounter + \'\352\261\264\';\n      const timeStr = new Date().toLocaleTimeString();\n      let colorClass = \'text-slate-700 bg-slate-50 border-slate-200\';\n      let badgeClass = \'bg-slate-200 text-slate-800\';\n\n      if (type === \'BUY\') {\n        colorClass = \'text-emerald-900 bg-emerald-50/70 border-emerald-200\';\n        badgeClass = \'bg-emerald-600 text-white\';\n      } else if (type === \'SELL\') {\n        colorClass = \'text-blue-900 bg-blue-50/70 border-blue-200\';\n        badgeClass = \'bg-blue-600 text-white\';\n      } else if (type === \'STOP_LOSS\') {\n        colorClass = \'text-rose-900 bg-rose-50/70 border-rose-200\';\n        badgeClass = \'bg-rose-600 text-white\';\n      }\n\n      const item = document.createElement(\'div\');\n      item.className = \'p-2 rounded-lg border text-[11px] flex items-start gap-2 \' + colorClass;\n      item.innerHTML = \\`\n        <span class=\"text-slate-400 shrink-0\">\\${timeStr}</span>\n        <span class=\"px-1.5 py-0.2 rounded font-bold uppercase text-[9px] shrink-0 \\${badgeClass}\">[\\${type}]</span>\n        <span class=\"flex-1 font-medium\">\\${text}</span>\n        <span class=\"font-bold shrink-0\">\\${fmt(price)}</span>\n      \\`;\n      logsContainer.insertBefore(item, logsContainer.firstChild);\n    }\n\n    // Generate initial history\n    const now = Date.now();\n    for (let i = 40; i >= 0; i--) {\n      const p = state.basePrice + (Math.random() - 0.5) * (state.atr * 0.4);\n      const baseline = state.basePrice + Math.sin(i * 0.2) * (state.atr * 0.3);\n      state.history.push({\n        time: now - i * 1000,\n        price: p,\n        baseline: baseline,\n        upperBand: baseline + state.atr * state.atrMultiplier,\n        lowerBand: baseline - state.atr * state.atrMultiplier,\n        stopLoss: baseline - state.atr * (state.atrMultiplier + state.stopLossMultiplier)\n      });\n    }\n    state.price = state.history[state.history.length - 1].price;\n\n    appendLog(\'SYSTEM\', \'\354\213\234\354\212\244\355\205\234 \354\264\210\352\270\260\355\231\224 \354\231\204\353\243\214 \353\260\217 \352\260\200\354\203\201 \355\212\270\353\240\210\354\235\264\353\224\251 \353\214\200\354\213\234\353\263\264\353\223\234 \353\241\234\353\223\234\353\220\250\', state.price);\n\n    // Render Canvas\n    function renderChart() {\n      const rect = canvas.getBoundingClientRect();\n      const dpr = window.devicePixelRatio || 1;\n      canvas.width = rect.width * dpr;\n      canvas.height = rect.height * dpr;\n      ctx.scale(dpr, dpr);\n\n      const w = rect.width;\n      const h = rect.height;\n      const pad = { top: 24, right: 80, bottom: 24, left: 16 };\n      const cw = w - pad.left - pad.right;\n      const ch = h - pad.top - pad.bottom;\n\n      ctx.clearRect(0, 0, w, h);\n\n      let minP = Infinity, maxP = -Infinity;\n      state.history.forEach(pt => {\n        minP = Math.min(minP, pt.price, pt.lowerBand, pt.stopLoss);\n        maxP = Math.max(maxP, pt.price, pt.upperBand);\n      });\n      const range = (maxP - minP) || 1;\n      const pMin = minP - range * 0.08;\n      const pMax = maxP + range * 0.08;\n      const fRange = pMax - pMin;\n\n      const getY = (val) => pad.top + ch - ((val - pMin) / fRange) * ch;\n      const getX = (idx) => pad.left + (idx / (state.history.length - 1)) * cw;\n\n      // Grid\n      ctx.strokeStyle = \'#e2e8f0\';\n      ctx.lineWidth = 1;\n      for (let i = 0; i <= 4; i++) {\n        const y = pad.top + (i / 4) * ch;\n        ctx.beginPath();\n        ctx.moveTo(pad.left, y);\n        ctx.lineTo(w - pad.right, y);\n        ctx.stroke();\n      }\n\n      // Shaded Band\n      ctx.beginPath();\n      for (let i = 0; i < state.history.length; i++) {\n        const x = getX(i);\n        const y = getY(state.history[i].upperBand);\n        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n      }\n      for (let i = state.history.length - 1; i >= 0; i--) {\n        const x = getX(i);\n        const y = getY(state.history[i].lowerBand);\n        ctx.lineTo(x, y);\n      }\n      ctx.closePath();\n      ctx.fillStyle = \'rgba(59, 130, 246, 0.05)\';\n      ctx.fill();\n\n      // Bands\n      const drawLine = (prop, color, dash = []) => {\n        ctx.beginPath();\n        ctx.strokeStyle = color;\n        ctx.lineWidth = 1.6;\n        ctx.setLineDash(dash);\n        state.history.forEach((pt, i) => {\n          const x = getX(i), y = getY(pt[prop]);\n          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n        });\n        ctx.stroke();\n        ctx.setLineDash([]);\n      };\n\n      drawLine(\'stopLoss\', \'#f43f5e\', [4, 4]);\n      drawLine(\'lowerBand\', \'#6366f1\', [5, 3]);\n      drawLine(\'baseline\', \'#94a3b8\', []);\n      drawLine(\'upperBand\', \'#10b981\', [5, 3]);\n\n      // Price Line\n      ctx.beginPath();\n      ctx.strokeStyle = \'#2563eb\';\n      ctx.lineWidth = 2.4;\n      state.history.forEach((pt, i) => {\n        const x = getX(i), y = getY(pt.price);\n        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n      });\n      ctx.stroke();\n\n      // Pulsing Dot on Current Price\n      const lastIdx = state.history.length - 1;\n      const lastPt = state.history[lastIdx];\n      const curX = getX(lastIdx);\n      const curY = getY(lastPt.price);\n\n      ctx.save();\n      ctx.beginPath();\n      ctx.arc(curX, curY, 8, 0, Math.PI * 2);\n      ctx.fillStyle = \'rgba(37, 99, 235, 0.25)\';\n      ctx.fill();\n\n      ctx.beginPath();\n      ctx.arc(curX, curY, 4.5, 0, Math.PI * 2);\n      ctx.fillStyle = \'#2563eb\';\n      ctx.fill();\n      ctx.restore();\n\n      // Axis Price\n      ctx.fillStyle = \'#2563eb\';\n      ctx.fillRect(w - pad.right + 4, curY - 10, pad.right - 8, 20);\n      ctx.fillStyle = \'#ffffff\';\n      ctx.font = \'bold 10px monospace\';\n      ctx.fillText(fmt(lastPt.price), w - pad.right + 8, curY + 4);\n    }\n\n    // Tick Loop\n    let timer = null;\n    function step() {\n      const meanReversion = (state.basePrice - state.price) * 0.05;\n      const noise = (Math.random() - 0.49) * state.atr * 0.45;\n      state.price = Number((state.price + meanReversion + noise).toFixed(2));\n\n      const baseline = Number((state.basePrice + Math.sin(Date.now() / 8000) * (state.atr * 0.3)).toFixed(2));\n      const upper = Number((baseline + state.atr * state.atrMultiplier).toFixed(2));\n      const lower = Number((baseline - state.atr * state.atrMultiplier).toFixed(2));\n      let stop = lower - state.atr * state.stopLossMultiplier;\n      if (state.positionAmount > 0 && state.entryPrice) {\n        stop = state.entryPrice - state.atr * state.stopLossMultiplier;\n      }\n\n      // Automated Strategy execution\n      if (state.isBotActive) {\n        if (state.positionAmount === 0 && state.price <= lower) {\n          // BUY\n          const budget = state.balance * (state.orderRatio / 100);\n          const qty = Number((budget / state.price).toFixed(4));\n          state.balance -= budget;\n          state.positionAmount = qty;\n          state.entryPrice = state.price;\n          appendLog(\'BUY\', \'\355\225\230\353\213\250 \353\247\244\354\210\230 \353\260\264\353\223\234 \355\204\260\354\271\230 \354\247\204\354\236\205 \354\262\264\352\262\260\', state.price);\n        } else if (state.positionAmount > 0 && state.entryPrice && state.price >= upper) {\n          // TAKE PROFIT\n          const proceeds = state.positionAmount * state.price;\n          const invested = state.positionAmount * state.entryPrice;\n          const pnl = proceeds - invested;\n          state.balance += proceeds;\n          state.realizedPnl += pnl;\n          state.totalTrades++;\n          if (pnl > 0) state.winTrades++;\n          state.positionAmount = 0;\n          state.entryPrice = null;\n          appendLog(\'SELL\', \'\354\203\201\353\213\250 \354\235\265\354\240\210 \353\260\264\353\223\234 \353\217\204\353\213\254 \354\240\204\353\237\211 \354\235\265\354\240\210\', state.price);\n        } else if (state.positionAmount > 0 && state.entryPrice && state.price <= stop) {\n          // STOP LOSS\n          const proceeds = state.positionAmount * state.price;\n          const invested = state.positionAmount * state.entryPrice;\n          const pnl = proceeds - invested;\n          state.balance += proceeds;\n          state.realizedPnl += pnl;\n          state.totalTrades++;\n          state.positionAmount = 0;\n          state.entryPrice = null;\n          appendLog(\'STOP_LOSS\', \'\353\217\231\354\240\201 \354\206\220\354\240\210\354\204\240 \354\235\264\355\203\210 \353\260\251\354\226\264 \354\206\220\354\240\210\', state.price);\n        }\n      }\n\n      state.history.push({\n        time: Date.now(),\n        price: state.price,\n        baseline,\n        upperBand: upper,\n        lowerBand: lower,\n        stopLoss: stop\n      });\n      if (state.history.length > 50) state.history.shift();\n\n      updateUI();\n      renderChart();\n    }\n\n    function updateUI() {\n      livePriceHeader.textContent = fmt(state.price);\n      const equity = state.balance + state.positionAmount * state.price;\n      equityDisplay.textContent = fmt(equity);\n      const ret = ((equity - state.initialBalance) / state.initialBalance) * 100;\n      document.getElementById(\'totalReturnDisplay\').textContent = \'\354\210\230\354\235\265\353\245\240: \' + (ret >= 0 ? \'+\' : \'\') + ret.toFixed(2) + \'%\';\n\n      if (state.positionAmount > 0) {\n        positionDisplay.textContent = \'LONG (\' + state.positionAmount + \')\';\n        const unPnl = (state.price - state.entryPrice) * state.positionAmount;\n        const unPct = ((state.price - state.entryPrice) / state.entryPrice) * 100;\n        unrealizedPnlDisplay.textContent = \'\353\257\270\354\213\244\355\230\204 \354\206\220\354\235\265: \' + (unPnl >= 0 ? \'+\' : \'\') + fmt(unPnl) + \' (\' + unPct.toFixed(2) + \'%)\';\n        unrealizedPnlDisplay.className = unPnl >= 0 ? \'text-xs font-semibold text-emerald-600 mt-1\' : \'text-xs font-semibold text-rose-600 mt-1\';\n      } else {\n        positionDisplay.textContent = \'FLAT (\353\214\200\352\270\260)\';\n        unrealizedPnlDisplay.textContent = \'\353\257\270\354\213\244\355\230\204 \354\206\220\354\235\265: $0.00 (0.00%)\';\n        unrealizedPnlDisplay.className = \'text-xs font-medium text-slate-500 mt-1\';\n      }\n\n      realizedPnlDisplay.textContent = \'\354\213\244\355\230\204 \354\206\220\354\235\265: \' + (state.realizedPnl >= 0 ? \'+\' : \'\') + fmt(state.realizedPnl);\n      const wr = state.totalTrades > 0 ? ((state.winTrades / state.totalTrades) * 100).toFixed(1) : \'0.0\';\n      winRateDisplay.innerHTML = wr + \'% <span class=\"text-xs text-slate-500 font-normal\">(\' + state.totalTrades + \'\355\232\214 \354\262\264\352\262\260)</span>\';\n    }\n\n    // Toggle Bot\n    botToggleBtn.addEventListener(\'click\', () => {\n      state.isBotActive = !state.isBotActive;\n      if (state.isBotActive) {\n        botToggleBtn.className = \'flex items-center gap-2 px-4 py-2 rounded-lg font-bold text-sm bg-rose-600 text-white hover:bg-rose-700 transition shadow-sm\';\n        botToggleLabel.textContent = \'\353\264\207 \354\240\225\354\247\200 (STOP)\';\n        botStatusBadge.className = \'text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 animate-pulse\';\n        botStatusBadge.textContent = \'\342\227\217 \354\236\220\353\217\231 \352\260\200\353\217\231 \354\244\221 (RUNNING)\';\n        appendLog(\'SYSTEM\', \'\354\236\220\353\217\231\353\247\244\353\247\244 \353\264\207 \355\231\234\354\204\261\355\231\224\353\220\250 (1\354\264\210 \354\243\274\352\270\260 \354\240\204\353\236\265 \354\262\264\355\201\254)\', state.price);\n      } else {\n        botToggleBtn.className = \'flex items-center gap-2 px-4 py-2 rounded-lg font-bold text-sm bg-blue-600 text-white hover:bg-blue-700 transition shadow-sm\';\n        botToggleLabel.textContent = \'\353\264\207 \352\260\200\353\217\231 (START)\';\n        botStatusBadge.className = \'text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600\';\n        botStatusBadge.textContent = \'\353\214\200\352\270\260 \354\244\221 (IDLE)\';\n        appendLog(\'SYSTEM\', \'\354\236\220\353\217\231\353\247\244\353\247\244 \353\264\207 \353\271\204\355\231\234\354\204\261\355\231\224\353\220\250\', state.price);\n      }\n    });\n\n    // Sliders Event Listeners\n    atrMultiplierInput.addEventListener(\'input\', (e) => {\n      state.atrMultiplier = parseFloat(e.target.value);\n      atrMultiplierVal.textContent = state.atrMultiplier.toFixed(1) + \'x\';\n    });\n    orderRatioInput.addEventListener(\'input\', (e) => {\n      state.orderRatio = parseInt(e.target.value);\n      orderRatioVal.textContent = state.orderRatio + \'%\';\n    });\n    stopLossInput.addEventListener(\'input\', (e) => {\n      state.stopLossMultiplier = parseFloat(e.target.value);\n      stopLossVal.textContent = state.stopLossMultiplier.toFixed(1) + \'x\';\n    });\n\n    // Manual controls\n    document.getElementById(\'manualBuyBtn\').addEventListener(\'click\', () => {\n      if (state.positionAmount > 0) return;\n      const budget = state.balance * (state.orderRatio / 100);\n      const qty = Number((budget / state.price).toFixed(4));\n      state.balance -= budget;\n      state.positionAmount = qty;\n      state.entryPrice = state.price;\n      appendLog(\'BUY\', \'[\354\210\230\353\217\231 \353\247\244\354\210\230] \354\213\234\354\236\245\352\260\200 \354\262\264\352\262\260\', state.price);\n      updateUI();\n    });\n\n    document.getElementById(\'manualSellBtn\').addEventListener(\'click\', () => {\n      if (state.positionAmount === 0 || !state.entryPrice) return;\n      const proceeds = state.positionAmount * state.price;\n      const invested = state.positionAmount * state.entryPrice;\n      const pnl = proceeds - invested;\n      state.balance += proceeds;\n      state.realizedPnl += pnl;\n      state.totalTrades++;\n      if (pnl > 0) state.winTrades++;\n      state.positionAmount = 0;\n      state.entryPrice = null;\n      appendLog(\'SELL\', \'[\354\210\230\353\217\231 \354\262\255\354\202\260] \354\213\234\354\236\245\352\260\200 \354\240\204\353\237\211 \353\247\244\353\217\204 \354\262\264\352\262\260\', state.price);\n      updateUI();\n    });\n\n    document.getElementById(\'clearLogsBtn\').addEventListener(\'click\', () => {\n      logsContainer.innerHTML = \'\';\n      logCounter = 0;\n      logCountBadge.textContent = \'0\352\261\264\';\n    });\n\n    // Start interval\n    timer = setInterval(step, 1000);\n    window.addEventListener(\'resize\', renderChart);\n    renderChart();\n    updateUI();\n  </script>\n</body>\n</html>`;\n  }, []);\n\n  const handleCopyCode = () => {\n    navigator.clipboard.writeText(singleHtmlCode);\n    setCopiedHtml(true);\n    setTimeout(() => setCopiedHtml(false), 2000);\n  };\n\n  const handleDownloadHtml = () => {\n    const blob = new Blob([singleHtmlCode], { type: \'text/html;charset=utf-8;\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.download = \'atr-trading-bot-dashboard.html\';\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n    URL.revokeObjectURL(url);\n  };\n\n  const filteredLogs = useMemo(() => {\n    if (logFilter === \'ALL\') return logs;\n    return logs.filter((l) => l.type === logFilter);\n  }, [logs, logFilter]);\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-800 flex flex-col selection:bg-blue-100 selection:text-blue-900 font-[\'Plus_Jakarta_Sans\',sans-serif]\">\n      {/* Top Header Bar */}\n      <header className=\"bg-white border-b border-slate-200 px-4 lg:px-8 py-3.5 sticky top-0 z-30 flex items-center justify-between shadow-xs\">\n        {/* Zone 1: Brand title */}\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-sm ring-4 ring-blue-50\">\n            <Activity className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"font-extrabold text-slate-900 text-base tracking-tight\">ATR QUANT BOT</span>\n              <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200\">\n                PROTOTYPE\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-500 font-medium\">\353\217\231\354\240\201 ATR \353\260\264\353\223\234 \352\270\260\353\260\230 \352\260\200\354\203\201 \354\236\220\353\217\231\353\247\244\353\247\244 \354\235\270\355\204\260\353\236\231\355\213\260\353\270\214 \353\214\200\354\213\234\353\263\264\353\223\234</p>\n          </div>\n        </div>\n\n        {/* Zone 2: Pair selection & Live Ticker */}\n        <div className=\"hidden md:flex items-center gap-6\">\n          <div className=\"flex items-center gap-2 bg-slate-100/80 px-3 py-1.5 rounded-xl border border-slate-200\">\n            <span className=\"text-xs font-semibold text-slate-500\">\354\242\205\353\252\251 \354\204\240\355\203\235:</span>\n            <div className=\"relative\">\n              <select\n                value={selectedCoin}\n                onChange={(e) => setSelectedCoin(e.target.value)}\n                className=\"bg-transparent font-bold text-sm text-slate-900 pr-6 focus:outline-hidden cursor-pointer appearance-none\"\n              >\n                {Object.keys(COIN_CONFIGS).map((pair) => (\n                  <option key={pair} value={pair}>\n                    {pair}\n                  </option>\n                ))}\n              </select>\n              <ChevronDown className=\"w-3.5 h-3.5 text-slate-500 absolute right-0 top-1/2 -translate-y-1/2 pointer-events-none\" />\n            </div>\n          </div>\n\n          {/* Current Ticker display */}\n          <div className=\"flex items-center gap-4 border-l border-slate-200 pl-6\">\n            <div>\n              <div className=\"text-xs font-semibold text-slate-400\">\354\213\244\354\213\234\352\260\204 \354\262\264\352\262\260\352\260\200</div>\n              <div className=\"text-base font-extrabold text-slate-900 font-[\'JetBrains_Mono\',monospace] flex items-center gap-1.5\">\n                {formatPrice(currentPrice, selectedCoin)}\n                <span className=\"relative flex h-2 w-2\">\n                  <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75\"></span>\n                  <span className=\"relative inline-flex rounded-full h-2 w-2 bg-blue-600\"></span>\n                </span>\n              </div>\n            </div>\n\n            <div>\n              <div className=\"text-xs font-semibold text-slate-400\">24H \353\263\200\353\217\231</div>\n              <div\n                className={`text-xs font-bold flex items-center ${\n                  market.change24h >= 0 ? \'text-emerald-600\' : \'text-rose-600\'\n                }`}\n              >\n                {market.change24h >= 0 ? <ArrowUpRight className=\"w-3.5 h-3.5 mr-0.5\" /> : <ArrowDownRight className=\"w-3.5 h-3.5 mr-0.5\" />}\n                {market.change24h >= 0 ? \'+\' : \'\'}\n                {market.change24h}%\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Zone 3: Bot ON/OFF Action & Single HTML Export */}\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={() => setSoundEnabled(!soundEnabled)}\n            className=\"p-2 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition border border-slate-200\"\n            title={soundEnabled ? \'\354\202\254\354\232\264\353\223\234 \353\201\204\352\270\260\' : \'\354\202\254\354\232\264\353\223\234 \354\274\234\352\270\260\'}\n          >\n            {soundEnabled ? <Volume2 className=\"w-4 h-4 text-blue-600\" /> : <VolumeX className=\"w-4 h-4\" />}\n          </button>\n\n          <button\n            onClick={() => setShowExportModal(true)}\n            className=\"hidden sm:flex items-center gap-1.5 px-3 py-2 text-xs font-bold text-slate-700 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 transition shadow-2xs\"\n          >\n            <Code className=\"w-4 h-4 text-blue-600\" />\n            <span>\353\213\250\354\235\274 HTML \353\263\264\352\270\260/\353\213\244\354\232\264\353\241\234\353\223\234</span>\n          </button>\n\n          {/* Master Bot ON/OFF Toggle */}\n          <button\n            onClick={handleToggleBot}\n            className={`flex items-center gap-2 px-5 py-2 rounded-xl font-bold text-sm transition-all shadow-sm ${\n              isBotActive\n                ? \'bg-rose-600 hover:bg-rose-700 text-white ring-4 ring-rose-100\'\n                : \'bg-blue-600 hover:bg-blue-700 text-white ring-4 ring-blue-100\'\n            }`}\n          >\n            {isBotActive ? (\n              <>\n                <Square className=\"w-4 h-4 fill-white\" />\n                <span>\353\264\207 \354\240\225\354\247\200 (STOP)</span>\n              </>\n            ) : (\n              <>\n                <Play className=\"w-4 h-4 fill-white\" />\n                <span>\353\264\207 \352\260\200\353\217\231 (START)</span>\n              </>\n            )}\n          </button>\n        </div>\n      </header>\n\n      {/* Main Content Dashboard */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto p-4 lg:p-6 space-y-6\">\n        {/* Metric Cards Row */}\n        <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n          {/* Card 1: Equity & Balance */}\n          <div className=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-slate-500 mb-2\">\n              <span className=\"text-xs font-semibold uppercase tracking-wider\">\354\264\235 \354\236\220\354\202\260 \352\260\200\354\271\230 (Equity)</span>\n              <Wallet className=\"w-4 h-4 text-blue-600\" />\n            </div>\n            <div>\n              <div className=\"text-2xl font-extrabold text-slate-900 font-[\'JetBrains_Mono\',monospace]\">\n                ${currentEquity.toLocaleString(\'en-US\', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}\n              </div>\n              <div className=\"flex items-center justify-between text-xs mt-1\">\n                <span className=\"text-slate-500\">\352\260\200\354\232\251 \355\230\204\352\270\210: ${balance.toLocaleString(\'en-US\', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>\n                <span className={`font-bold ${totalReturnPercent >= 0 ? \'text-emerald-600\' : \'text-rose-600\'}`}>\n                  {totalReturnPercent >= 0 ? \'+\' : \'\'}\n                  {totalReturnPercent.toFixed(2)}%\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* Card 2: Current Position */}\n          <div className=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-slate-500 mb-2\">\n              <span className=\"text-xs font-semibold uppercase tracking-wider\">\355\217\254\354\247\200\354\205\230 \354\203\201\355\203\234 (Position)</span>\n              <Layers className=\"w-4 h-4 text-indigo-600\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span\n                  className={`text-xl font-extrabold font-[\'JetBrains_Mono\',monospace] ${\n                    positionAmount > 0 ? \'text-indigo-600\' : \'text-slate-600\'\n                  }`}\n                >\n                  {positionAmount > 0 ? `LONG (${positionAmount})` : \'FLAT (\353\254\264\355\217\254\354\247\200\354\205\230)\'}\n                </span>\n              </div>\n              <div className=\"flex items-center justify-between text-xs mt-1\">\n                {positionAmount > 0 && entryPrice ? (\n                  <>\n                    <span className=\"text-slate-500\">\354\247\204\354\236\205\352\260\200: {formatPrice(entryPrice, selectedCoin)}</span>\n                    <span className={`font-bold ${unrealizedPnl >= 0 ? \'text-emerald-600\' : \'text-rose-600\'}`}>\n                      {unrealizedPnl >= 0 ? \'+\' : \'\'}${unrealizedPnl.toFixed(2)} ({unrealizedPnlPercent.toFixed(2)}%)\n                    </span>\n                  </>\n                ) : (\n                  <span className=\"text-slate-400\">\355\225\230\353\213\250 \353\260\264\353\223\234 \353\247\244\354\210\230 \353\214\200\352\270\260 \354\244\221</span>\n                )}\n              </div>\n            </div>\n          </div>\n\n          {/* Card 3: ATR & Volatility */}\n          <div className=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-slate-500 mb-2\">\n              <span className=\"text-xs font-semibold uppercase tracking-wider\">ATR \354\247\200\355\221\234 (\353\263\200\353\217\231\354\204\261 \355\217\255)</span>\n              <TrendingUp className=\"w-4 h-4 text-emerald-600\" />\n            </div>\n            <div>\n              <div className=\"text-2xl font-extrabold text-blue-600 font-[\'JetBrains_Mono\',monospace]\">\n                {formatPrice(market.atr, selectedCoin)}\n              </div>\n              <div className=\"flex items-center justify-between text-xs mt-1\">\n                <span className=\"text-slate-500\">\354\204\244\354\240\225 \354\261\204\353\204\220: \302\261{(market.atr * atrMultiplier).toFixed(1)}</span>\n                <span className=\"font-semibold text-blue-600 mono\">\353\260\260\354\210\230: {atrMultiplier}x</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Card 4: Trade Stats & Realized PnL */}\n          <div className=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-slate-500 mb-2\">\n              <span className=\"text-xs font-semibold uppercase tracking-wider\">\353\210\204\354\240\201 \353\247\244\353\247\244 \354\212\271\353\245\240 (Win Rate)</span>\n              <PieChart className=\"w-4 h-4 text-emerald-600\" />\n            </div>\n            <div>\n              <div className=\"text-2xl font-extrabold text-emerald-600 font-[\'JetBrains_Mono\',monospace] flex items-baseline gap-2\">\n                {winRate}%\n                <span className=\"text-xs font-normal text-slate-500 font-sans\">({totalTrades}\355\232\214 \354\262\264\352\262\260)</span>\n              </div>\n              <div className=\"flex items-center justify-between text-xs mt-1\">\n                <span className=\"text-slate-500\">\354\213\244\355\230\204 \354\206\220\354\235\265:</span>\n                <span className={`font-bold mono ${totalRealizedPnl >= 0 ? \'text-emerald-600\' : \'text-rose-600\'}`}>\n                  {totalRealizedPnl >= 0 ? \'+\' : \'\'}${totalRealizedPnl.toFixed(2)}\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Chart Visualization Section */}\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs space-y-4\">\n          {/* Chart Header Controls */}\n          <div className=\"flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"flex items-center gap-2\">\n                <BarChart2 className=\"w-5 h-5 text-blue-600\" />\n                <h2 className=\"font-bold text-slate-900 text-base\">ATR \353\263\200\353\217\231\354\204\261 \353\213\244\354\235\264\353\202\264\353\257\271 \353\260\264\353\223\234</h2>\n              </div>\n              <span\n                className={`text-xs font-bold px-2.5 py-0.5 rounded-full flex items-center gap-1.5 ${\n                  isBotActive\n                    ? \'bg-emerald-100 text-emerald-800 ring-1 ring-emerald-300\'\n                    : \'bg-slate-100 text-slate-600\'\n                }`}\n              >\n                <span\n                  className={`w-2 h-2 rounded-full ${\n                    isBotActive ? \'bg-emerald-500 animate-ping\' : \'bg-slate-400\'\n                  }`}\n                ></span>\n                {isBotActive ? \'\354\236\220\353\217\231 \353\264\207 \352\260\200\353\217\231 \354\244\221 (ACTIVE)\' : \'\353\214\200\352\270\260 \353\252\250\353\223\234 (IDLE)\'}\n              </span>\n            </div>\n\n            {/* Band Legend */}\n            <div className=\"flex flex-wrap items-center gap-3 text-xs font-medium\">\n              <div className=\"flex items-center gap-1 text-emerald-700 bg-emerald-50 px-2 py-1 rounded-md border border-emerald-200\">\n                <span className=\"w-3 h-0.5 bg-emerald-500 inline-block border-t border-dashed\"></span>\n                <span>\354\203\201\353\213\250 \353\260\264\353\223\234 (\354\235\265\354\240\210\354\204\240 TP)</span>\n              </div>\n              <div className=\"flex items-center gap-1 text-slate-600 bg-slate-100 px-2 py-1 rounded-md border border-slate-200\">\n                <span className=\"w-3 h-0.5 bg-slate-400 inline-block\"></span>\n                <span>\354\244\221\354\213\254\354\204\240 (EMA Baseline)</span>\n              </div>\n              <div className=\"flex items-center gap-1 text-indigo-700 bg-indigo-50 px-2 py-1 rounded-md border border-indigo-200\">\n                <span className=\"w-3 h-0.5 bg-indigo-500 inline-block border-t border-dashed\"></span>\n                <span>\355\225\230\353\213\250 \353\260\264\353\223\234 (\353\247\244\354\210\230\354\204\240 BUY)</span>\n              </div>\n              <div className=\"flex items-center gap-1 text-rose-700 bg-rose-50 px-2 py-1 rounded-md border border-rose-200\">\n                <span className=\"w-3 h-0.5 bg-rose-500 inline-block border-t border-dashed\"></span>\n                <span>\353\217\231\354\240\201 \354\206\220\354\240\210\354\204\240 (Stop-Loss)</span>\n              </div>\n            </div>\n\n            {/* Manual Test Order Buttons */}\n            <div className=\"flex items-center gap-2\">\n              <button\n                onClick={handleManualBuy}\n                disabled={positionAmount > 0}\n                className=\"px-3 py-1.5 text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-300 rounded-lg hover:bg-emerald-100 disabled:opacity-40 disabled:cursor-not-allowed transition\"\n              >\n                + \354\210\230\353\217\231 \353\247\244\354\210\230 (BUY)\n              </button>\n              <button\n                onClick={handleManualSell}\n                disabled={positionAmount === 0}\n                className=\"px-3 py-1.5 text-xs font-bold bg-rose-50 text-rose-700 border border-rose-300 rounded-lg hover:bg-rose-100 disabled:opacity-40 disabled:cursor-not-allowed transition\"\n              >\n                - \354\210\230\353\217\231 \354\262\255\354\202\260 (SELL)\n              </button>\n            </div>\n          </div>\n\n          {/* Canvas Chart Area */}\n          <div className=\"relative w-full h-[380px] bg-slate-50/70 rounded-xl border border-slate-200 overflow-hidden\">\n            <canvas ref={canvasRef} className=\"w-full h-full block\" />\n\n            {/* Bottom Chart Footer Overlay */}\n            <div className=\"absolute bottom-2 left-4 text-[11px] text-slate-400 font-mono flex items-center gap-4\">\n              <span>\342\227\217 1\354\264\210 \354\213\244\354\213\234\352\260\204 \355\213\261 \352\260\261\354\213\240</span>\n              <span>\342\227\217 \355\216\204\354\212\244 \354\240\220: \354\213\244\354\213\234\352\260\204 \352\260\200\352\262\251 \353\263\200\353\217\231</span>\n              <span>\342\227\217 \355\204\260\354\271\230 \352\260\220\354\247\200: \353\260\264\353\223\234 \353\217\204\353\213\254 \354\213\234 \354\236\220\353\217\231 \354\243\274\353\254\270 \355\212\270\353\246\254\352\261\260</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Bottom Split: Parameter Sliders & Live Logs Console */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n          {/* Column 1: Parameter Tuning Sliders */}\n          <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n              <div className=\"flex items-center gap-2\">\n                <Sliders className=\"w-4 h-4 text-blue-600\" />\n                <h3 className=\"font-bold text-slate-900 text-sm\">\354\240\204\353\236\265 \355\214\214\353\235\274\353\257\270\355\204\260 \354\241\260\354\240\210</h3>\n              </div>\n              <button\n                onClick={() => {\n                  setAtrMultiplier(2.0);\n                  setOrderRatio(25);\n                  setStopLossMultiplier(1.5);\n                  setVolatilityScale(1.0);\n                }}\n                className=\"text-xs text-slate-400 hover:text-blue-600 font-medium\"\n              >\n                \352\270\260\353\263\270\352\260\222 \353\263\265\354\233\220\n              </button>\n            </div>\n\n            <div className=\"space-y-4\">\n              {/* Slider 1: ATR Multiplier */}\n              <div className=\"space-y-1.5\">\n                <div className=\"flex justify-between text-xs font-semibold\">\n                  <span className=\"text-slate-700\">ATR \353\260\264\353\223\234 \353\260\260\354\210\230 (Multiplier)</span>\n                  <span className=\"text-blue-600 font-[\'JetBrains_Mono\',monospace] font-bold\">\n                    {atrMultiplier.toFixed(1)}x\n                  </span>\n                </div>\n                <input\n                  type=\"range\"\n                  min=\"1.0\"\n                  max=\"4.0\"\n                  step=\"0.1\"\n                  value={atrMultiplier}\n                  onChange={(e) => setAtrMultiplier(parseFloat(e.target.value))}\n                  className=\"w-full accent-blue-600 cursor-pointer h-1.5 bg-slate-200 rounded-lg appearance-none\"\n                />\n                <div className=\"flex justify-between text-[10px] text-slate-400 font-mono\">\n                  <span>1.0x (\354\236\246\354\235\200 \353\247\244\353\247\244)</span>\n                  <span>4.0x (\354\225\210\354\240\204\355\225\234 \354\212\244\354\234\231)</span>\n                </div>\n              </div>\n\n              {/* Slider 2: Order Ratio */}\n              <div className=\"space-y-1.5\">\n                <div className=\"flex justify-between text-xs font-semibold\">\n                  <span className=\"text-slate-700\">1\355\232\214 \354\243\274\353\254\270 \353\271\204\354\244\221 (Order Size)</span>\n                  <span className=\"text-blue-600 font-[\'JetBrains_Mono\',monospace] font-bold\">{orderRatio}%</span>\n                </div>\n                <input\n                  type=\"range\"\n                  min=\"5\"\n                  max=\"100\"\n                  step=\"5\"\n                  value={orderRatio}\n                  onChange={(e) => setOrderRatio(parseInt(e.target.value))}\n                  className=\"w-full accent-blue-600 cursor-pointer h-1.5 bg-slate-200 rounded-lg appearance-none\"\n                />\n                <div className=\"flex justify-between text-[10px] text-slate-400 font-mono\">\n                  <span>5% (\353\266\204\355\225\240 \353\246\254\354\212\244\355\201\254)</span>\n                  <span>100% (\354\240\204\354\225\241 \353\262\240\355\214\205)</span>\n                </div>\n              </div>\n\n              {/* Slider 3: Dynamic Stop Loss */}\n              <div className=\"space-y-1.5\">\n                <div className=\"flex justify-between text-xs font-semibold\">\n                  <span className=\"text-slate-700\">\353\217\231\354\240\201 \354\206\220\354\240\210 \353\260\260\354\210\230 (Stop Loss ATR)</span>\n                  <span className=\"text-rose-600 font-[\'JetBrains_Mono\',monospace] font-bold\">\n                    {stopLossMultiplier.toFixed(1)}x\n                  </span>\n                </div>\n                <input\n                  type=\"range\"\n                  min=\"0.5\"\n                  max=\"3.0\"\n                  step=\"0.1\"\n                  value={stopLossMultiplier}\n                  onChange={(e) => setStopLossMultiplier(parseFloat(e.target.value))}\n                  className=\"w-full accent-rose-600 cursor-pointer h-1.5 bg-slate-200 rounded-lg appearance-none\"\n                />\n                <div className=\"flex justify-between text-[10px] text-slate-400 font-mono\">\n                  <span>0.5x (\355\203\200\354\235\264\355\212\270\355\225\234 \353\260\251\354\226\264)</span>\n                  <span>3.0x (\354\227\254\354\234\240 \354\206\220\354\240\210\354\204\240)</span>\n                </div>\n              </div>\n\n              {/* Simulation Controls: Speed & Volatility */}\n              <div className=\"pt-2 border-t border-slate-100 flex items-center justify-between\">\n                <span className=\"text-xs font-semibold text-slate-600\">\354\213\234\353\256\254\353\240\210\354\235\264\354\205\230 \352\260\261\354\213\240 \354\206\215\353\217\204</span>\n                <div className=\"flex gap-1.5\">\n                  <button\n                    onClick={() => setTickSpeed(1000)}\n                    className={`px-2.5 py-1 text-xs font-bold rounded-lg border transition ${\n                      tickSpeed === 1000\n                        ? \'bg-blue-50 text-blue-700 border-blue-200\'\n                        : \'bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100\'\n                    }`}\n                  >\n                    1\354\264\210 (\352\270\260\353\263\270)\n                  </button>\n                  <button\n                    onClick={() => setTickSpeed(500)}\n                    className={`px-2.5 py-1 text-xs font-bold rounded-lg border transition ${\n                      tickSpeed === 500\n                        ? \'bg-blue-50 text-blue-700 border-blue-200\'\n                        : \'bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100\'\n                    }`}\n                  >\n                    0.5\354\264\210 (\352\263\240\354\206\215)\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            {/* Reset Simulation button */}\n            <button\n              onClick={handleResetSimulation}\n              className=\"w-full py-2 px-3 text-xs font-bold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-xl transition flex items-center justify-center gap-1.5\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5\" />\n              <span>\352\260\200\354\203\201 \354\236\224\352\263\240 \353\260\217 \355\206\265\352\263\204 \354\264\210\352\270\260\355\231\224 ($10,000)</span>\n            </button>\n          </div>\n\n          {/* Column 2 & 3: Real-Time Virtual Trading Log Console */}\n          <div className=\"lg:col-span-2 bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-col h-[400px]\">\n            {/* Log Header */}\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-3 mb-3\">\n              <div className=\"flex items-center gap-3\">\n                <Terminal className=\"w-4 h-4 text-slate-700\" />\n                <h3 className=\"font-bold text-slate-900 text-sm\">\354\213\244\354\213\234\352\260\204 \352\260\200\354\203\201 \353\247\244\353\247\244 \353\260\217 \354\213\234\352\267\270\353\204\220 \353\241\234\352\267\270</h3>\n                <span className=\"text-[11px] font-mono font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full\">\n                  {logs.length}\352\261\264 \352\270\260\353\241\235\n                </span>\n              </div>\n\n              {/* Log Filters */}\n              <div className=\"flex items-center gap-1.5 text-xs\">\n                {([\'ALL\', \'BUY\', \'SELL\', \'STOP_LOSS\'] as const).map((filter) => (\n                  <button\n                    key={filter}\n                    onClick={() => setLogFilter(filter)}\n                    className={`px-2 py-0.5 rounded-md font-semibold transition ${\n                      logFilter === filter\n                        ? \'bg-slate-900 text-white\'\n                        : \'text-slate-500 hover:text-slate-900 hover:bg-slate-100\'\n                    }`}\n                  >\n                    {filter === \'ALL\'\n                      ? \'\354\240\204\354\262\264\'\n                      : filter === \'BUY\'\n                      ? \'\353\247\244\354\210\230\'\n                      : filter === \'SELL\'\n                      ? \'\354\235\265\354\240\210\'\n                      : \'\354\206\220\354\240\210\'}\n                  </button>\n                ))}\n                <button\n                  onClick={() => setLogs([])}\n                  className=\"text-slate-400 hover:text-slate-700 ml-2 text-xs font-medium\"\n                >\n                  \354\247\200\354\232\260\352\270\260\n                </button>\n              </div>\n            </div>\n\n            {/* Scrollable Log Terminal List */}\n            <div className=\"flex-1 overflow-y-auto space-y-2 pr-1 font-[\'JetBrains_Mono\',monospace] text-xs\">\n              {filteredLogs.length === 0 ? (\n                <div className=\"h-full flex flex-col items-center justify-center text-slate-400 gap-2\">\n                  <AlertCircle className=\"w-6 h-6 stroke-1\" />\n                  <p className=\"text-xs\">\354\262\264\352\262\260\353\220\234 \353\247\244\353\247\244 \353\241\234\352\267\270\352\260\200 \354\227\206\354\212\265\353\213\210\353\213\244. \354\203\201\353\213\250\354\235\230 \'\353\264\207 \352\260\200\353\217\231\'\354\235\204 \353\210\214\353\237\254\353\263\264\354\204\270\354\232\224.</p>\n                </div>\n              ) : (\n                filteredLogs.map((log) => (\n                  <div\n                    key={log.id}\n                    className={`p-2.5 rounded-xl border text-[11px] flex items-start gap-2.5 transition-all ${\n                      log.type === \'BUY\'\n                        ? \'bg-emerald-50/70 border-emerald-200 text-emerald-950\'\n                        : log.type === \'SELL\'\n                        ? \'bg-blue-50/70 border-blue-200 text-blue-950\'\n                        : log.type === \'STOP_LOSS\'\n                        ? \'bg-rose-50/70 border-rose-200 text-rose-950\'\n                        : \'bg-slate-50 border-slate-200 text-slate-700\'\n                    }`}\n                  >\n                    <span className=\"text-slate-400 shrink-0 select-none text-[10px] mt-0.5\">{log.time}</span>\n                    <span\n                      className={`px-1.5 py-0.5 rounded-md font-extrabold uppercase text-[9px] shrink-0 tracking-wider ${\n                        log.type === \'BUY\'\n                          ? \'bg-emerald-600 text-white\'\n                          : log.type === \'SELL\'\n                          ? \'bg-blue-600 text-white\'\n                          : log.type === \'STOP_LOSS\'\n                          ? \'bg-rose-600 text-white\'\n                          : \'bg-slate-200 text-slate-700\'\n                      }`}\n                    >\n                      [{log.type}]\n                    </span>\n                    <span className=\"flex-1 font-medium leading-relaxed\">{log.reason}</span>\n                    <div className=\"text-right shrink-0 font-bold\">\n                      <div>{formatPrice(log.price, selectedCoin)}</div>\n                      {log.pnl !== undefined && (\n                        <div\n                          className={`text-[10px] ${\n                            log.pnl >= 0 ? \'text-emerald-600\' : \'text-rose-600\'\n                          }`}\n                        >\n                          {log.pnl >= 0 ? \'+\' : \'\'}${log.pnl.toFixed(2)}\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                ))\n              )}\n              <div ref={logsEndRef} />\n            </div>\n          </div>\n        </div>\n      </main>\n\n      {/* Export / Single HTML Modal */}\n      {showExportModal && (\n        <div className=\"fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-slate-200 space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n              <div className=\"flex items-center gap-2\">\n                <Code className=\"w-5 h-5 text-blue-600\" />\n                <h3 className=\"font-bold text-slate-900 text-base\">\353\213\250\354\235\274 \355\214\214\354\235\274 (Single HTML) \354\235\270\355\204\260\353\236\231\355\213\260\353\270\214 \353\252\251\354\227\205</h3>\n              </div>\n              <button\n                onClick={() => setShowExportModal(false)}\n                className=\"text-slate-400 hover:text-slate-600 text-sm font-bold\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              Tailwind CDN, Lucide CDN, Canvas \353\240\214\353\215\224\353\237\254, \352\260\200\354\203\201 \355\213\261 \355\203\200\354\235\264\353\250\270\352\260\200 \355\217\254\355\225\250\353\220\230\354\226\264 \354\236\210\354\226\264, \353\263\204\353\217\204 \353\271\214\353\223\234 \353\217\204\352\265\254 \354\227\206\354\235\264\n              \353\270\214\353\235\274\354\232\260\354\240\200\354\227\220\354\204\234 \354\247\201\354\240\221 \353\260\224\353\241\234 \354\227\264 \354\210\230 \354\236\210\353\212\224 \353\217\205\353\246\275 \354\213\244\355\226\211\355\230\225(Standalone) \353\213\250\354\235\274 HTML \354\275\224\353\223\234\354\236\205\353\213\210\353\213\244.\n            </p>\n\n            {/* Code Box */}\n            <div className=\"relative\">\n              <pre className=\"bg-slate-900 text-slate-200 p-4 rounded-xl text-[11px] font-mono h-60 overflow-y-auto leading-normal\">\n                {singleHtmlCode}\n              </pre>\n              <button\n                onClick={handleCopyCode}\n                className=\"absolute top-3 right-3 bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 shadow-sm transition\"\n              >\n                {copiedHtml ? <Check className=\"w-3.5 h-3.5\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>{copiedHtml ? \'\353\263\265\354\202\254 \354\231\204\353\243\214!\' : \'\354\240\204\354\262\264 \353\263\265\354\202\254\'}</span>\n              </button>\n            </div>\n\n            <div className=\"flex items-center justify-end gap-2 pt-2\">\n              <button\n                onClick={handleDownloadHtml}\n                className=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow-sm\"\n              >\n                <Download className=\"w-4 h-4\" />\n                <span>.html \355\214\214\354\235\274\353\241\234 \353\213\244\354\232\264\353\241\234\353\223\234</span>\n              </button>\n              <button\n                onClick={() => setShowExportModal(false)}\n                className=\"px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition\"\n              >\n                \353\213\253\352\270\260\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    }
