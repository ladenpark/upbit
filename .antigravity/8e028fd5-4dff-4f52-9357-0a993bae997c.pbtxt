        }
        lines {
          text: "      ctx.fillStyle = \'#2563eb\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.fillRect(w - pad.right + 4, curY - 10, pad.right - 8, 20);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.fillStyle = \'#ffffff\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.font = \'bold 10px monospace\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ctx.fillText(fmt(lastPt.price), w - pad.right + 8, curY + 4);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Tick Loop"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let timer = null;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    function step() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const meanReversion = (state.basePrice - state.price) * 0.05;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const noise = (Math.random() - 0.49) * state.atr * 0.45;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      state.price = Number((state.price + meanReversion + noise).toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const baseline = Number((state.basePrice + Math.sin(Date.now() / 8000) * (state.atr * 0.3)).toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const upper = Number((baseline + state.atr * state.atrMultiplier).toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const lower = Number((baseline - state.atr * state.atrMultiplier).toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      let stop = lower - state.atr * state.stopLossMultiplier;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (state.positionAmount > 0 && state.entryPrice) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        stop = state.entryPrice - state.atr * state.stopLossMultiplier;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Automated Strategy execution"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (state.isBotActive) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (state.positionAmount === 0 && state.price <= lower) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          // BUY"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const budget = state.balance * (state.orderRatio / 100);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const qty = Number((budget / state.price).toFixed(4));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          state.balance -= budget;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          state.positionAmount = qty;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
