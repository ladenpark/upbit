  planner_response {
    response: "```html\n<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>ATR Volatility Trading Bot - Interactive Prototype</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <!-- Lucide Icons CDN -->\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n  <!-- Google Fonts (Plus Jakarta Sans & JetBrains Mono) -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n  \n  <style>\n    body { font-family: \'Plus Jakarta Sans\', sans-serif; }\n    .mono { font-family: \'JetBrains Mono\', monospace; }\n    \n    @keyframes pulse-ring {\n      0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.7); }\n      70% { transform: scale(1); box-shadow: 0 0 0 12px rgba(37, 99, 235, 0); }\n      100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0); }\n    }\n    .pulse-dot {\n      animation: pulse-ring 1.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n    }\n    \n    /* Custom Scrollbar for Terminal Logs */\n    ::-webkit-scrollbar { width: 6px; height: 6px; }\n    ::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }\n    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }\n    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col selection:bg-blue-100 selection:text-blue-900\">\n\n  <!-- Top Header Navigation -->\n  <header class=\"bg-white border-b border-slate-200 px-6 py-3.5 sticky top-0 z-30 flex items-center justify-between shadow-sm\">\n    <!-- Brand Title -->\n    <div class=\"flex items-center gap-3\">\n      <div class=\"w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-sm ring-4 ring-blue-50 font-bold\">\n        <i data-lucide=\"activity\" class=\"w-5 h-5\"></i>\n      </div>\n      <div>\n        <div class=\"flex items-center gap-2\">\n          <h1 class=\"font-extrabold text-slate-900 text-base tracking-tight leading-none\">ATR QUANT BOT</h1>\n          <span class=\"text-[10px] font-bold px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200\">INTERACTIVE MOCKUP</span>\n        </div>\n        <p class=\"text-xs text-slate-500 font-medium mt-0.5\">\353\263\200\353\217\231\354\204\261 ATR \353\260\264\353\223\234 \352\270\260\353\260\230 \352\260\200\354\203\201 \354\236\220\353\217\231\353\247\244\353\247\244 \355\224\204\353\241\234\355\206\240\355\203\200\354\236\205</p>\n      </div>\n    </div>\n\n    <!-- Center & Right Controls -->\n    <div class=\"flex items-center gap-6\">\n      <!-- Coin Pair Selector -->\n      <div class=\"flex items-center gap-2 bg-slate-100/90 px-3 py-1.5 rounded-xl border border-slate-200\">\n        <span class=\"text-xs font-semibold text-slate-500\">\354\242\205\353\252\251:</span>\n        <select id=\"coinSelect\" class=\"bg-transparent font-bold text-sm text-slate-900 focus:outline-none cursor-pointer\">\n          <option value=\"BTC/USDT\">BTC / USDT</option>\n          <option value=\"ETH/USDT\">ETH / USDT</option>\n          <option value=\"SOL/USDT\">SOL / USDT</option>\n        </select>\n      </div>\n\n      <!-- Live Ticker Info -->\n      <div class=\"hidden md:flex items-center gap-4 border-l border-slate-200 pl-6\">\n        <div>\n          <div class=\"text-[11px] font-semibold text-slate-400\">\355\230\204\354\236\254 \354\213\234\354\236\245\352\260\200</div>\n          <div id=\"livePriceHeader\" class=\"text-base font-extrabold text-slate-900 mono\">$96,450.0</div>\n        </div>\n        <div>\n          <div class=\"text-[11px] font-semibold text-slate-400\">24H \353\263\200\353\217\231\353\245\240</div>\n          <div id=\"liveChangeHeader\" class=\"text-xs font-bold text-emerald-600\">+3.42%</div>\n        </div>\n      </div>\n\n      <!-- Bot ON/OFF Toggle -->\n      <button id=\"botToggleBtn\" class=\"flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-blue-600 hover:bg-blue-700 text-white transition-all shadow-sm ring-4 ring-blue-100\">\n        <i data-lucide=\"play\" class=\"w-4 h-4 fill-white\"></i>\n        <span id=\"botToggleLabel\">\353\264\207 \352\260\200\353\217\231 (START)</span>\n      </button>\n    </div>\n  </header>\n\n  <!-- Main Container -->\n  <main class=\"flex-1 max-w-7xl w-full mx-auto p-4 lg:p-6 space-y-6\">\n    \n    <!-- Stat Metrics Row -->\n    <div class=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n      <div class=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n        <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1 flex items-center justify-between\">\n          <span>\354\264\235 \354\236\220\354\202\260 \352\260\200\354\271\230 (Equity)</span>\n          <i data-lucide=\"wallet\" class=\"w-4 h-4 text-blue-600\"></i>\n        </div>\n        <div id=\"equityDisplay\" class=\"text-2xl font-extrabold mono text-slate-900\">$10,000.00</div>\n        <div class=\"flex items-center justify-between text-xs mt-1\">\n          <span id=\"cashDisplay\" class=\"text-slate-500\">\355\230\204\352\270\210: $10,000.00</span>\n          <span id=\"returnDisplay\" class=\"font-bold text-emerald-600\">+0.00%</span>\n        </div>\n      </div>\n\n      <div class=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n        <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1 flex items-center justify-between\">\n          <span>\353\263\264\354\234\240 \355\217\254\354\247\200\354\205\230 (Position)</span>\n          <i data-lucide=\"layers\" class=\"w-4 h-4 text-indigo-600\"></i>\n        </div>\n        <div id=\"positionDisplay\" class=\"text-xl font-extrabold mono text-slate-700\">FLAT (0.00)</div>\n        <div id=\"unrealizedPnlDisplay\" class=\"text-xs font-medium text-slate-500 mt-1\">\353\257\270\354\213\244\355\230\204 \354\206\220\354\235\265: $0.00 (0.00%)</div>\n      </div>\n\n      <div class=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n        <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1 flex items-center justify-between\">\n          <span>\355\230\204\354\236\254 ATR (\353\263\200\353\217\231\355\217\255)</span>\n          <i data-lucide=\"trending-up\" class=\"w-4 h-4 text-emerald-600\"></i>\n        </div>\n        <div id=\"atrDisplay\" class=\"text-2xl font-extrabold mono text-blue-600\">$1,250.0</div>\n        <div class=\"text-xs font-medium text-slate-500 mt-1\">\353\217\231\354\240\201 \354\261\204\353\204\220: \302\2612.0x ATR</div>\n      </div>\n\n      <div class=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n        <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1 flex items-center justify-between\">\n          <span>\353\210\204\354\240\201 \354\262\264\352\262\260 \353\260\217 \354\212\271\353\245\240</span>\n          <i data-lucide=\"pie-chart\" class=\"w-4 h-4 text-emerald-600\"></i>\n        </div>\n        <div id=\"winRateDisplay\" class=\"text-2xl font-extrabold mono text-emerald-600\">0.0% <span class=\"text-xs text-slate-500 font-normal\">(0\355\232\214)</span></div>\n        <div id=\"realizedPnlDisplay\" class=\"text-xs font-medium text-slate-500 mt-1\">\354\213\244\355\230\204 \354\206\220\354\235\265: $0.00</div>\n      </div>\n    </div>\n\n    <!-- Volatility ATR Chart Canvas Section -->\n    <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4\">\n      <div class=\"flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3\">\n        <div class=\"flex items-center gap-3\">\n          <div class=\"flex items-center gap-2\">\n            <i data-lucide=\"bar-chart-2\" class=\"w-5 h-5 text-blue-600\"></i>\n            <h2 class=\"font-bold text-slate-900 text-base\">ATR \353\263\200\353\217\231\354\204\261 \353\213\244\354\235\264\353\202\264\353\257\271 \353\260\264\353\223\234 \354\213\244\354\213\234\352\260\204 \354\260\250\355\212\270</h2>\n          </div>\n          <span id=\"botStatusBadge\" class=\"text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 flex items-center gap-1.5\">\n            <span class=\"w-2 h-2 rounded-full bg-slate-400\"></span>\n            \353\214\200\352\270\260 \354\244\221 (IDLE)\n          </span>\n        </div>\n\n        <!-- Band Legends -->\n        <div class=\"flex flex-wrap items-center gap-3 text-xs font-medium\">\n          <div class=\"flex items-center gap-1 text-emerald-700 bg-emerald-50 px-2 py-1 rounded-md border border-emerald-200\">\n            <span class=\"w-3 h-0.5 bg-emerald-500 inline-block\"></span>\n            <span>\354\203\201\353\213\250 \353\260\264\353\223\234 (\354\235\265\354\240\210\354\204\240 TP)</span>\n          </div>\n          <div class=\"flex items-center gap-1 text-slate-600 bg-slate-100 px-2 py-1 rounded-md border border-slate-200\">\n            <span class=\"w-3 h-0.5 bg-slate-400 inline-block\"></span>\n            <span>\354\244\221\354\213\254\354\204\240 (EMA Baseline)</span>\n          </div>\n          <div class=\"flex items-center gap-1 text-indigo-700 bg-indigo-50 px-2 py-1 rounded-md border border-indigo-200\">\n            <span class=\"w-3 h-0.5 bg-indigo-500 inline-block\"></span>\n            <span>\355\225\230\353\213\250 \353\260\264\353\223\234 (\353\247\244\354\210\230\354\204\240 BUY)</span>\n          </div>\n          <div class=\"flex items-center gap-1 text-rose-700 bg-rose-50 px-2 py-1 rounded-md border border-rose-200\">\n            <span class=\"w-3 h-0.5 bg-rose-500 inline-block\"></span>\n            <span>\353\217\231\354\240\201 \354\206\220\354\240\210\354\204\240 (Stop-Loss)</span>\n          </div>\n        </div>\n\n        <!-- Manual Quick Orders -->\n        <div class=\"flex items-center gap-2\">\n          <button id=\"manualBuyBtn\" class=\"px-3 py-1.5 text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-300 rounded-lg hover:bg-emerald-100 transition\">\n            + \354\210\230\353\217\231 \353\247\244\354\210\230\n          </button>\n          <button id=\"manualSellBtn\" class=\"px-3 py-1.5 text-xs font-bold bg-rose-50 text-rose-700 border border-rose-300 rounded-lg hover:bg-rose-100 transition\">\n            - \354\210\230\353\217\231 \354\262\255\354\202\260\n          </button>\n        </div>\n      </div>\n\n      <!-- Chart Container -->\n      <div class=\"relative w-full h-[380px] bg-slate-50/80 rounded-xl border border-slate-200 overflow-hidden\">\n        <canvas id=\"tradingChart\" class=\"w-full h-full block\"></canvas>\n        <div class=\"absolute bottom-2 left-4 text-[11px] text-slate-400 mono flex items-center gap-4\">\n          <span>\342\227\217 1\354\264\210 \354\213\244\354\213\234\352\260\204 \355\213\261 \352\260\261\354\213\240</span>\n          <span>\342\227\217 \355\216\204\354\212\244 \354\240\220: \354\213\244\354\213\234\352\260\204 \354\213\234\354\236\245\352\260\200</span>\n          <span>\342\227\217 \353\260\264\353\223\234 \355\204\260\354\271\230 \354\213\234 \354\236\220\353\217\231 \354\262\264\352\262\260</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Bottom Controls & Real-time Logs -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n      \n      <!-- Strategy Parameter Tuning Sliders -->\n      <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between space-y-4\">\n        <div class=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n          <h3 class=\"font-bold text-slate-900 text-sm flex items-center gap-2\">\n            <i data-lucide=\"sliders\" class=\"w-4 h-4 text-blue-600\"></i>\n            \354\240\204\353\236\265 \355\214\214\353\235\274\353\257\270\355\204\260 \354\241\260\354\240\210\n          </h3>\n          <button id=\"resetParamsBtn\" class=\"text-xs text-slate-400 hover:text-blue-600 font-medium\">\354\264\210\352\270\260\355\231\224</button>\n        </div>\n\n        <!-- ATR Multiplier Slider -->\n        <div class=\"space-y-1.5\">\n          <div class=\"flex justify-between text-xs font-semibold\">\n            <span class=\"text-slate-700\">ATR \353\260\264\353\223\234 \353\260\260\354\210\230 (Multiplier)</span>\n            <span id=\"atrMultiplierVal\" class=\"text-blue-600 mono font-bold\">2.0x</span>\n          </div>\n          <input id=\"atrMultiplierInput\" type=\"range\" min=\"1.0\" max=\"4.0\" step=\"0.1\" value=\"2.0\" class=\"w-full accent-blue-600 cursor-pointer h-1.5 bg-slate-200 rounded-lg appearance-none\">\n          <div class=\"flex justify-between text-[10px] text-slate-400 mono\">\n            <span>1.0x (\355\203\200\354\235\264\355\212\270\355\225\234 \354\261\204\353\204\220)</span>\n            <span>4.0x (\353\204\223\354\235\200 \354\261\204\353\204\220)</span>\n          </div>\n        </div>\n\n        <!-- Order Ratio Slider -->\n        <div class=\"space-y-1.5\">\n          <div class=\"flex justify-between text-xs font-semibold\">\n            <span class=\"text-slate-700\">1\355\232\214 \354\243\274\353\254\270 \354\236\220\354\202\260 \353\271\204\354\244\221 (Order Size)</span>\n            <span id=\"orderRatioVal\" class=\"text-blue-600 mono font-bold\">25%</span>\n          </div>\n          <input id=\"orderRatioInput\" type=\"range\" min=\"5\" max=\"100\" step=\"5\" value=\"25\" class=\"w-full accent-blue-600 cursor-pointer h-1.5 bg-slate-200 rounded-lg appearance-none\">\n          <div class=\"flex justify-between text-[10px] text-slate-400 mono\">\n            <span>5% (\353\266\204\355\225\240 \353\247\244\353\247\244)</span>\n            <span>100% (\354\240\204\354\225\241 \353\252\260\353\271\265)</span>\n          </div>\n        </div>\n\n        <!-- Stop Loss Multiplier Slider -->\n        <div class=\"space-y-1.5\">\n          <div class=\"flex justify-between text-xs font-semibold\">\n            <span class=\"text-slate-700\">\353\217\231\354\240\201 \354\206\220\354\240\210 \353\260\260\354\210\230 (Stop Loss ATR)</span>\n            <span id=\"stopLossVal\" class=\"text-rose-600 mono font-bold\">1.5x</span>\n          </div>\n          <input id=\"stopLossInput\" type=\"range\" min=\"0.5\" max=\"3.0\" step=\"0.1\" value=\"1.5\" class=\"w-full accent-rose-600 cursor-pointer h-1.5 bg-slate-200 rounded-lg appearance-none\">\n          <div class=\"flex justify-between text-[10px] text-slate-400 mono\">\n            <span>0.5x (\353\271\240\353\245\270 \354\206\220\354\240\210)</span>\n            <span>3.0x (\354\227\254\354\234\240 \353\260\251\354\226\264)</span>\n          </div>\n        </div>\n\n        <!-- Reset Simulation -->\n        <button id=\"resetSimBtn\" class=\"w-full py-2 px-3 text-xs font-bold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-xl transition flex items-center justify-center gap-1.5\">\n          <i data-lucide=\"refresh-cw\" class=\"w-3.5 h-3.5\"></i>\n          <span>\352\260\200\354\203\201 \354\236\220\354\202\260 \354\264\210\352\270\260\355\231\224 ($10,000)</span>\n        </button>\n      </div>\n\n      <!-- Real-time Virtual Trading Log Console -->\n      <div class=\"lg:col-span-2 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col h-[380px]\">\n        <div class=\"flex items-center justify-between border-b border-slate-100 pb-3 mb-3\">\n          <div class=\"flex items-center gap-2\">\n            <i data-lucide=\"terminal\" class=\"w-4 h-4 text-slate-700\"></i>\n            <h3 class=\"font-bold text-slate-900 text-sm\">\354\213\244\354\213\234\352\260\204 \352\260\200\354\203\201 \353\247\244\353\247\244 \353\260\217 \354\262\264\352\262\260 \353\241\234\352\267\270</h3>\n            <span id=\"logCountBadge\" class=\"text-[10px] font-mono font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full\">0\352\261\264</span>\n          </div>\n          <button id=\"clearLogsBtn\" class=\"text-xs text-slate-400 hover:text-slate-700 font-medium\">\354\247\200\354\232\260\352\270\260</button>\n        </div>\n\n        <!-- Scrollable Log List -->\n        <div id=\"logsContainer\" class=\"flex-1 overflow-y-auto space-y-2 pr-1 mono text-xs\">\n          <!-- Dynamically inserted via JavaScript -->\n        </div>\n      </div>\n\n    </div>\n  </main>\n\n  <script>\n    // Initialize Lucide Icons\n    lucide.createIcons();\n\n    // Configuration Data for Coins\n    const COINS = {\n      \'BTC/USDT\': { symbol: \'BTC/USDT\', price: 96450.0, basePrice: 96450.0, atr: 1250.0, change: 3.42 },\n      \'ETH/USDT\': { symbol: \'ETH/USDT\', price: 2780.5, basePrice: 2780.5, atr: 48.0, change: -1.15 },\n      \'SOL/USDT\': { symbol: \'SOL/USDT\', price: 194.2, basePrice: 194.2, atr: 4.8, change: 5.68 }\n    };\n\n    // State Variables\n    const state = {\n      isBotActive: false,\n      selectedCoin: \'BTC/USDT\',\n      price: COINS[\'BTC/USDT\'].price,\n      basePrice: COINS[\'BTC/USDT\'].basePrice,\n      atr: COINS[\'BTC/USDT\'].atr,\n      atrMultiplier: 2.0,\n      orderRatio: 25,\n      stopLossMultiplier: 1.5,\n      balance: 10000.0,\n      initialBalance: 10000.0,\n      positionAmount: 0,\n      entryPrice: null,\n      realizedPnl: 0,\n      totalTrades: 0,\n      winTrades: 0,\n      history: []\n    };\n\n    // DOM Elements\n    const coinSelect = document.getElementById(\'coinSelect\');\n    const livePriceHeader = document.getElementById(\'livePriceHeader\');\n    const liveChangeHeader = document.getElementById(\'liveChangeHeader\');\n    const botToggleBtn = document.getElementById(\'botToggleBtn\');\n    const botToggleLabel = document.getElementById(\'botToggleLabel\');\n    const botStatusBadge = document.getElementById(\'botStatusBadge\');\n    \n    const equityDisplay = document.getElementById(\'equityDisplay\');\n    const cashDisplay = document.getElementById(\'cashDisplay\');\n    const returnDisplay = document.getElementById(\'returnDisplay\');\n    const positionDisplay = document.getElementById(\'positionDisplay\');\n    const unrealizedPnlDisplay = document.getElementById(\'unrealizedPnlDisplay\');\n    const atrDisplay = document.getElementById(\'atrDisplay\');\n    const winRateDisplay = document.getElementById(\'winRateDisplay\');\n    const realizedPnlDisplay = document.getElementById(\'realizedPnlDisplay\');\n    \n    const logsContainer = document.getElementById(\'logsContainer\');\n    const logCountBadge = document.getElementById(\'logCountBadge\');\n    \n    const canvas = document.getElementById(\'tradingChart\');\n    const ctx = canvas.getContext(\'2d\');\n\n    // Slider Elements\n    const atrMultiplierInput = document.getElementById(\'atrMultiplierInput\');\n    const atrMultiplierVal = document.getElementById(\'atrMultiplierVal\');\n    const orderRatioInput = document.getElementById(\'orderRatioInput\');\n    const orderRatioVal = document.getElementById(\'orderRatioVal\');\n    const stopLossInput = document.getElementById(\'stopLossInput\');\n    const stopLossVal = document.getElementById(\'stopLossVal\');\n\n    // Utility: Format currency\n    function fmt(val) {\n      return \'$\' + Number(val).toLocaleString(\'en-US\', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n    }\n\n    // Append Trading Log\n    let logCounter = 0;\n    function addLog(type, message, price, pnl = null) {\n      logCounter++;\n      logCountBadge.textContent = logCounter + \'\352\261\264\';\n      const timeStr = new Date().toLocaleTimeString();\n      \n      let badgeClass = \'bg-slate-200 text-slate-800\';\n      let cardBorder = \'border-slate-200 bg-slate-50/70 text-slate-800\';\n\n      if (type === \'BUY\') {\n        badgeClass = \'bg-emerald-600 text-white\';\n        cardBorder = \'border-emerald-200 bg-emerald-50/70 text-emerald-950\';\n      } else if (type === \'SELL\') {\n        badgeClass = \'bg-blue-600 text-white\';\n        cardBorder = \'border-blue-200 bg-blue-50/70 text-blue-950\';\n      } else if (type === \'STOP_LOSS\') {\n        badgeClass = \'bg-rose-600 text-white\';\n        cardBorder = \'border-rose-200 bg-rose-50/70 text-rose-950\';\n      }\n\n      const row = document.createElement(\'div\');\n      row.className = `p-2.5 rounded-xl border text-[11px] flex items-start gap-2.5 transition-all ${cardBorder}`;\n      row.innerHTML = `\n        <span class=\"text-slate-400 shrink-0 text-[10px] mt-0.5\">${timeStr}</span>\n        <span class=\"px-1.5 py-0.5 rounded font-extrabold uppercase text-[9px] shrink-0 ${badgeClass}\">[${type}]</span>\n        <span class=\"flex-1 font-medium leading-relaxed\">${message}</span>\n        <div class=\"text-right shrink-0 font-bold\">\n          <div>${fmt(price)}</div>\n          ${pnl !== null ? `<div class=\"text-[10px] ${pnl >= 0 ? \'text-emerald-600\' : \'text-rose-600\'}\">${pnl >= 0 ? \'+\' : \'\'}${fmt(pnl)}</div>` : \'\'}\n        </div>\n      `;\n      logsContainer.insertBefore(row, logsContainer.firstChild);\n    }\n\n    // Build initial chart history\n    function initHistory() {\n      state.history = [];\n      const now = Date.now();\n      let cur = state.basePrice;\n      for (let i = 40; i >= 0; i--) {\n        const noise = (Math.random() - 0.5) * (state.atr * 0.4);\n        cur += noise;\n        const baseline = state.basePrice + Math.sin(i * 0.2) * (state.atr * 0.3);\n        const upper = baseline + state.atr * state.atrMultiplier;\n        const lower = baseline - state.atr * state.atrMultiplier;\n        const stop = lower - state.atr * state.stopLossMultiplier;\n\n        state.history.push({\n          time: now - i * 1000,\n          price: cur,\n          baseline,\n          upperBand: upper,\n          lowerBand: lower,\n          stopLoss: stop\n        });\n      }\n      state.price = state.history[state.history.length - 1].price;\n      addLog(\'SYSTEM\', `${state.selectedCoin} \352\260\200\354\203\201 \353\247\210\354\274\223 \353\215\260\354\235\264\355\204\260 \353\241\234\353\223\234 \354\231\204\353\243\214`, state.price);\n    }\n\n    // Canvas Chart Rendering\n    function renderChart() {\n      const rect = canvas.getBoundingClientRect();\n      const dpr = window.devicePixelRatio || 1;\n      canvas.width = rect.width * dpr;\n      canvas.height = rect.height * dpr;\n      ctx.scale(dpr, dpr);\n\n      const w = rect.width;\n      const h = rect.height;\n      const pad = { top: 28, right: 85, bottom: 28, left: 16 };\n      const cw = w - pad.left - pad.right;\n      const ch = h - pad.top - pad.bottom;\n\n      ctx.clearRect(0, 0, w, h);\n\n      if (state.history.length < 2) return;\n\n      let minP = Infinity, maxP = -Infinity;\n      state.history.forEach(pt => {\n        minP = Math.min(minP, pt.price, pt.lowerBand, pt.stopLoss);\n        maxP = Math.max(maxP, pt.price, pt.upperBand);\n      });\n      const range = (maxP - minP) || 1;\n      const pMin = minP - range * 0.08;\n      const pMax = maxP + range * 0.08;\n      const fRange = pMax - pMin;\n\n      const getY = (val) => pad.top + ch - ((val - pMin) / fRange) * ch;\n      const getX = (idx) => pad.left + (idx / (state.history.length - 1)) * cw;\n\n      // 1. Grid Lines\n      ctx.strokeStyle = \'#f1f5f9\';\n      ctx.lineWidth = 1;\n      for (let i = 0; i <= 4; i++) {\n        const y = pad.top + (i / 4) * ch;\n        ctx.beginPath();\n        ctx.moveTo(pad.left, y);\n        ctx.lineTo(w - pad.right, y);\n        ctx.stroke();\n\n        const pVal = pMax - (i / 4) * fRange;\n        ctx.fillStyle = \'#94a3b8\';\n        ctx.font = \'10px \"JetBrains Mono\", monospace\';\n        ctx.fillText(fmt(pVal), w - pad.right + 8, y + 3);\n      }\n\n      // 2. Shaded ATR Channel\n      ctx.beginPath();\n      for (let i = 0; i < state.history.length; i++) {\n        const x = getX(i);\n        const y = getY(state.history[i].upperBand);\n        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n      }\n      for (let i = state.history.length - 1; i >= 0; i--) {\n        const x = getX(i);\n        const y = getY(state.history[i].lowerBand);\n        ctx.lineTo(x, y);\n      }\n      ctx.closePath();\n      ctx.fillStyle = \'rgba(59, 130, 246, 0.04)\';\n      ctx.fill();\n\n      // 3. Draw Bands\n      const drawLine = (prop, color, dash = [], width = 1.6) => {\n        ctx.beginPath();\n        ctx.strokeStyle = color;\n        ctx.lineWidth = width;\n        ctx.setLineDash(dash);\n        state.history.forEach((pt, i) => {\n          const x = getX(i), y = getY(pt[prop]);\n          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n        });\n        ctx.stroke();\n        ctx.setLineDash([]);\n      };\n\n      drawLine(\'stopLoss\', \'#f43f5e\', [4, 4], 1.5);\n      drawLine(\'lowerBand\', \'#6366f1\', [5, 3], 1.8);\n      drawLine(\'baseline\', \'#94a3b8\', [], 1.2);\n      drawLine(\'upperBand\', \'#10b981\', [5, 3], 1.8);\n\n      // 4. Main Price Line\n      ctx.beginPath();\n      ctx.strokeStyle = \'#2563eb\';\n      ctx.lineWidth = 2.4;\n      state.history.forEach((pt, i) => {\n        const x = getX(i), y = getY(pt.price);\n        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n      });\n      ctx.stroke();\n\n      // 5. Draw Buy / Sell Trade Markers\n      state.history.forEach((pt, i) => {\n        if (!pt.event) return;\n        const x = getX(i);\n        const y = getY(pt.price);\n        ctx.save();\n        if (pt.event === \'BUY\') {\n          ctx.fillStyle = \'#10b981\';\n          ctx.beginPath();\n          ctx.moveTo(x, y + 12);\n          ctx.lineTo(x - 5, y + 22);\n          ctx.lineTo(x + 5, y + 22);\n          ctx.closePath();\n          ctx.fill();\n        } else if (pt.event === \'SELL\') {\n          ctx.fillStyle = \'#059669\';\n          ctx.beginPath();\n          ctx.moveTo(x, y - 12);\n          ctx.lineTo(x - 5, y - 22);\n          ctx.lineTo(x + 5, y - 22);\n          ctx.closePath();\n          ctx.fill();\n        } else if (pt.event === \'STOP_LOSS\') {\n          ctx.fillStyle = \'#e11d48\';\n          ctx.beginPath();\n          ctx.moveTo(x, y + 12);\n          ctx.lineTo(x - 5, y + 22);\n          ctx.lineTo(x + 5, y + 22);\n          ctx.closePath();\n          ctx.fill();\n        }\n        ctx.restore();\n      });\n\n      // 6. Current Price Pulsing Dot\n      const lastIdx = state.history.length - 1;\n      const lastPt = state.history[lastIdx];\n      const curX = getX(lastIdx);\n      const curY = getY(lastPt.price);\n\n      ctx.save();\n      // Outer Halo\n      ctx.beginPath();\n      ctx.arc(curX, curY, 8, 0, Math.PI * 2);\n      ctx.fillStyle = \'rgba(37, 99, 235, 0.25)\';\n      ctx.fill();\n      // Center Core Dot\n      ctx.beginPath();\n      ctx.arc(curX, curY, 4.5, 0, Math.PI * 2);\n      ctx.fillStyle = \'#2563eb\';\n      ctx.fill();\n      ctx.restore();\n\n      // 7. Right Axis Badge\n      ctx.fillStyle = \'#2563eb\';\n      ctx.beginPath();\n      ctx.roundRect(w - pad.right + 4, curY - 10, pad.right - 8, 20, 4);\n      ctx.fill();\n      ctx.fillStyle = \'#ffffff\';\n      ctx.font = \'bold 10px \"JetBrains Mono\", monospace\';\n      ctx.fillText(fmt(lastPt.price), w - pad.right + 8, curY + 4);\n    }\n\n    // Tick simulation step (1-second interval)\n    function tick() {\n      const meanRev = (state.basePrice - state.price) * 0.05;\n      const noise = (Math.random() - 0.49) * state.atr * 0.45;\n      state.price = Number((state.price + meanRev + noise).toFixed(2));\n\n      const baseline = Number((state.basePrice + Math.sin(Date.now() / 8000) * (state.atr * 0.3)).toFixed(2));\n      const upper = Number((baseline + state.atr * state.atrMultiplier).toFixed(2));\n      const lower = Number((baseline - state.atr * state.atrMultiplier).toFixed(2));\n      \n      let stop = lower - state.atr * state.stopLossMultiplier;\n      if (state.positionAmount > 0 && state.entryPrice) {\n        stop = state.entryPrice - state.atr * state.stopLossMultiplier;\n      }\n      stop = Number(stop.toFixed(2));\n\n      let eventType = null;\n\n      // Automated Strategy Execution Logic\n      if (state.isBotActive) {\n        // BUY: touches lower band\n        if (state.positionAmount === 0 && state.price <= lower) {\n          const budget = state.balance * (state.orderRatio / 100);\n          const qty = Number((budget / state.price).toFixed(4));\n          if (budget > 10) {\n            state.balance -= budget;\n            state.positionAmount = qty;\n            state.entryPrice = state.price;\n            eventType = \'BUY\';\n            addLog(\'BUY\', `\355\225\230\353\213\250 \353\260\264\353\223\234(${fmt(lower)}) \355\204\260\354\271\230 \353\247\244\354\210\230 \354\262\264\352\262\260 [\353\271\204\354\244\221 ${state.orderRatio}%]`, state.price);\n          }\n        }\n        // SELL: touches upper band (Take Profit)\n        else if (state.positionAmount > 0 && state.entryPrice && state.price >= upper) {\n          const proceeds = state.positionAmount * state.price;\n          const invested = state.positionAmount * state.entryPrice;\n          const pnl = proceeds - invested;\n          const pnlPct = ((state.price - state.entryPrice) / state.entryPrice) * 100;\n          state.balance += proceeds;\n          state.realizedPnl += pnl;\n          state.totalTrades++;\n          if (pnl > 0) state.winTrades++;\n          state.positionAmount = 0;\n          state.entryPrice = null;\n          eventType = \'SELL\';\n          addLog(\'SELL\', `\354\203\201\353\213\250 \353\260\264\353\223\234(${fmt(upper)}) \354\235\265\354\240\210 \354\262\255\354\202\260 \354\231\204\353\243\214 (+${pnlPct.toFixed(2)}%)`, state.price, pnl);\n        }\n        // STOP LOSS: breaks trailing stop\n        else if (state.positionAmount > 0 && state.entryPrice && state.price <= stop) {\n          const proceeds = state.positionAmount * state.price;\n          const invested = state.positionAmount * state.entryPrice;\n          const pnl = proceeds - invested;\n          const pnlPct = ((state.price - state.entryPrice) / state.entryPrice) * 100;\n          state.balance += proceeds;\n          state.realizedPnl += pnl;\n          state.totalTrades++;\n          state.positionAmount = 0;\n          state.entryPrice = null;\n          eventType = \'STOP_LOSS\';\n          addLog(\'STOP_LOSS\', `\353\217\231\354\240\201 \354\206\220\354\240\210\354\204\240(${fmt(stop)}) \354\235\264\355\203\210 \353\260\251\354\226\264 \354\206\220\354\240\210 (-${Math.abs(pnlPct).toFixed(2)}%)`, state.price, pnl);\n        }\n      }\n\n      state.history.push({\n        time: Date.now(),\n        price: state.price,\n        baseline,\n        upperBand: upper,\n        lowerBand: lower,\n        stopLoss: stop,\n        event: eventType\n      });\n      if (state.history.length > 50) state.history.shift();\n\n      updateUI();\n      renderChart();\n    }\n\n    // Refresh UI Metrics\n    function updateUI() {\n      livePriceHeader.textContent = fmt(state.price);\n      \n      const equity = state.balance + state.positionAmount * state.price;\n      equityDisplay.textContent = fmt(equity);\n      cashDisplay.textContent = \'\355\230\204\352\270\210: \' + fmt(state.balance);\n      \n      const ret = ((equity - state.initialBalance) / state.initialBalance) * 100;\n      returnDisplay.textContent = (ret >= 0 ? \'+\' : \'\') + ret.toFixed(2) + \'%\';\n      returnDisplay.className = `font-bold ${ret >= 0 ? \'text-emerald-600\' : \'text-rose-600\'}`;\n\n      if (state.positionAmount > 0 && state.entryPrice) {\n        positionDisplay.textContent = `LONG (${state.positionAmount})`;\n        positionDisplay.className = \'text-xl font-extrabold mono text-indigo-600\';\n        const unPnl = (state.price - state.entryPrice) * state.positionAmount;\n        const unPct = ((state.price - state.entryPrice) / state.entryPrice) * 100;\n        unrealizedPnlDisplay.textContent = `\353\257\270\354\213\244\355\230\204 \354\206\220\354\235\265: ${unPnl >= 0 ? \'+\' : \'\'}${fmt(unPnl)} (${unPct.toFixed(2)}%)`;\n        unrealizedPnlDisplay.className = unPnl >= 0 ? \'text-xs font-bold text-emerald-600 mt-1\' : \'text-xs font-bold text-rose-600 mt-1\';\n      } else {\n        positionDisplay.textContent = \'FLAT (\353\254\264\355\217\254\354\247\200\354\205\230)\';\n        positionDisplay.className = \'text-xl font-extrabold mono text-slate-700\';\n        unrealizedPnlDisplay.textContent = \'\353\257\270\354\213\244\355\230\204 \354\206\220\354\235\265: $0.00 (0.00%)\';\n        unrealizedPnlDisplay.className = \'text-xs font-medium text-slate-500 mt-1\';\n      }\n\n      atrDisplay.textContent = fmt(state.atr);\n      realizedPnlDisplay.textContent = \'\354\213\244\355\230\204 \354\206\220\354\235\265: \' + (state.realizedPnl >= 0 ? \'+\' : \'\') + fmt(state.realizedPnl);\n      realizedPnlDisplay.className = state.realizedPnl >= 0 ? \'text-xs font-bold text-emerald-600 mt-1\' : \'text-xs font-bold text-rose-600 mt-1\';\n      \n      const wr = state.totalTrades > 0 ? ((state.winTrades / state.totalTrades) * 100).toFixed(1) : \'0.0\';\n      winRateDisplay.innerHTML = `${wr}% <span class=\"text-xs text-slate-500 font-normal\">(${state.totalTrades}\355\232\214)</span>`;\n    }\n\n    // Toggle Bot Button\n    botToggleBtn.addEventListener(\'click\', () => {\n      state.isBotActive = !state.isBotActive;\n      if (state.isBotActive) {\n        botToggleBtn.className = \'flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-rose-600 hover:bg-rose-700 text-white transition-all shadow-sm ring-4 ring-rose-100\';\n        botToggleLabel.textContent = \'\353\264\207 \354\240\225\354\247\200 (STOP)\';\n        botStatusBadge.className = \'text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 ring-1 ring-emerald-300 flex items-center gap-1.5\';\n        botStatusBadge.innerHTML = \'<span class=\"w-2 h-2 rounded-full bg-emerald-500 animate-ping\"></span> \354\236\220\353\217\231 \352\260\200\353\217\231 \354\244\221 (ACTIVE)\';\n        addLog(\'SYSTEM\', `\354\236\220\353\217\231\353\247\244\353\247\244 \353\264\207 \355\231\234\354\204\261\355\231\224 [ATR: ${state.atrMultiplier}x | \354\243\274\353\254\270\353\271\204\354\244\221: ${state.orderRatio}%]`, state.price);\n      } else {\n        botToggleBtn.className = \'flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-blue-600 hover:bg-blue-700 text-white transition-all shadow-sm ring-4 ring-blue-100\';\n        botToggleLabel.textContent = \'\353\264\207 \352\260\200\353\217\231 (START)\';\n        botStatusBadge.className = \'text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 flex items-center gap-1.5\';\n        botStatusBadge.innerHTML = \'<span class=\"w-2 h-2 rounded-full bg-slate-400\"></span> \353\214\200\352\270\260 \354\244\221 (IDLE)\';\n        addLog(\'SYSTEM\', \'\354\236\220\353\217\231\353\247\244\353\247\244 \353\264\207 \354\235\274\354\213\234\354\240\225\354\247\200 (\353\214\200\352\270\260 \353\252\250\353\223\234)\', state.price);\n      }\n    });\n\n    // Coin Change Listener\n    coinSelect.addEventListener(\'change\', (e) => {\n      const cfg = COINS[e.target.value];\n      state.selectedCoin = cfg.symbol;\n      state.basePrice = cfg.basePrice;\n      state.atr = cfg.atr;\n      liveChangeHeader.textContent = (cfg.change >= 0 ? \'+\' : \'\') + cfg.change + \'%\';\n      liveChangeHeader.className = cfg.change >= 0 ? \'text-xs font-bold text-emerald-600\' : \'text-xs font-bold text-rose-600\';\n      initHistory();\n      renderChart();\n      updateUI();\n    });\n\n    // Sliders Listeners\n    atrMultiplierInput.addEventListener(\'input\', (e) => {\n      state.atrMultiplier = parseFloat(e.target.value);\n      atrMultiplierVal.textContent = state.atrMultiplier.toFixed(1) + \'x\';\n    });\n    orderRatioInput.addEventListener(\'input\', (e) => {\n      state.orderRatio = parseInt(e.target.value);\n      orderRatioVal.textContent = state.orderRatio + \'%\';\n    });\n    stopLossInput.addEventListener(\'input\', (e) => {\n      state.stopLossMultiplier = parseFloat(e.target.value);\n      stopLossVal.textContent = state.stopLossMultiplier.toFixed(1) + \'x\';\n    });\n\n    // Manual Buy Button\n    document.getElementById(\'manualBuyBtn\').addEventListener(\'click\', () => {\n      if (state.positionAmount > 0) return;\n      const budget = state.balance * (state.orderRatio / 100);\n      const qty = Number((budget / state.price).toFixed(4));\n      state.balance -= budget;\n      state.positionAmount = qty;\n      state.entryPrice = state.price;\n      addLog(\'BUY\', `[\354\210\230\353\217\231 \354\243\274\353\254\270] \354\213\234\354\236\245\352\260\200 \353\247\244\354\210\230 \354\262\264\352\262\260 - \355\210\254\354\236\220\352\270\210 ${fmt(budget)}`, state.price);\n      updateUI();\n    });\n\n    // Manual Sell Button\n    document.getElementById(\'manualSellBtn\').addEventListener(\'click\', () => {\n      if (state.positionAmount === 0 || !state.entryPrice) return;\n      const proceeds = state.positionAmount * state.price;\n      const invested = state.positionAmount * state.entryPrice;\n      const pnl = proceeds - invested;\n      state.balance += proceeds;\n      state.realizedPnl += pnl;\n      state.totalTrades++;\n      if (pnl > 0) state.winTrades++;\n      state.positionAmount = 0;\n      state.entryPrice = null;\n      addLog(\'SELL\', `[\354\210\230\353\217\231 \354\262\255\354\202\260] \354\213\234\354\236\245\352\260\200 \354\240\204\353\237\211 \353\247\244\353\217\204 \354\231\204\353\243\214`, state.price, pnl);\n      updateUI();\n    });\n\n    // Clear Logs Button\n    document.getElementById(\'clearLogsBtn\').addEventListener(\'click\', () => {\n      logsContainer.innerHTML = \'\';\n      logCounter = 0;\n      logCountBadge.textContent = \'0\352\261\264\';\n    });\n\n    // Reset Simulation\n    document.getElementById(\'resetSimBtn\').addEventListener(\'click\', () => {\n      state.balance = 10000;\n      state.positionAmount = 0;\n      state.entryPrice = null;\n      state.realizedPnl = 0;\n      state.totalTrades = 0;\n      state.winTrades = 0;\n      addLog(\'SYSTEM\', \'\354\213\234\353\256\254\353\240\210\354\235\264\354\205\230 \352\263\204\354\242\214 \353\260\217 \353\247\244\353\247\244 \355\206\265\352\263\204 \354\264\210\352\270\260\355\231\224 ($10,000 USD)\', state.price);\n      updateUI();\n    });\n\n    // Reset Parameters Button\n    document.getElementById(\'resetParamsBtn\').addEventListener(\'click\', () => {\n      state.atrMultiplier = 2.0;\n      state.orderRatio = 25;\n      state.stopLossMultiplier = 1.5;\n      atrMultiplierInput.value = 2.0;\n      atrMultiplierVal.textContent = \'2.0x\';\n      orderRatioInput.value = 25;\n      orderRatioVal.textContent = \'25%\';\n      stopLossInput.value = 1.5;\n      stopLossVal.textContent = \'1.5x\';\n    });\n\n    // Initial Launch\n    initHistory();\n    renderChart();\n    updateUI();\n    window.addEventListener(\'resize\', renderChart);\n\n    // 1-second interval for real-time simulation tick\n    setInterval(tick, 1000);\n  </script>\n</body>\n</html>\n```"
    modified_response: "```html\n<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>ATR Volatility Trading Bot - Interactive Prototype</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <!-- Lucide Icons CDN -->\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n  <!-- Google Fonts (Plus Jakarta Sans & JetBrains Mono) -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n  \n  <style>\n    body { font-family: \'Plus Jakarta Sans\', sans-serif; }\n    .mono { font-family: \'JetBrains Mono\', monospace; }\n    \n    @keyframes pulse-ring {\n      0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.7); }\n      70% { transform: scale(1); box-shadow: 0 0 0 12px rgba(37, 99, 235, 0); }\n      100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0); }\n    }\n    .pulse-dot {\n      animation: pulse-ring 1.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n    }\n    \n    /* Custom Scrollbar for Terminal Logs */\n    ::-webkit-scrollbar { width: 6px; height: 6px; }\n    ::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }\n    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }\n    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col selection:bg-blue-100 selection:text-blue-900\">\n\n  <!-- Top Header Navigation -->\n  <header class=\"bg-white border-b border-slate-200 px-6 py-3.5 sticky top-0 z-30 flex items-center justify-between shadow-sm\">\n    <!-- Brand Title -->\n    <div class=\"flex items-center gap-3\">\n      <div class=\"w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-sm ring-4 ring-blue-50 font-bold\">\n        <i data-lucide=\"activity\" class=\"w-5 h-5\"></i>\n      </div>\n      <div>\n        <div class=\"flex items-center gap-2\">\n          <h1 class=\"font-extrabold text-slate-900 text-base tracking-tight leading-none\">ATR QUANT BOT</h1>\n          <span class=\"text-[10px] font-bold px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200\">INTERACTIVE MOCKUP</span>\n        </div>\n        <p class=\"text-xs text-slate-500 font-medium mt-0.5\">\353\263\200\353\217\231\354\204\261 ATR \353\260\264\353\223\234 \352\270\260\353\260\230 \352\260\200\354\203\201 \354\236\220\353\217\231\353\247\244\353\247\244 \355\224\204\353\241\234\355\206\240\355\203\200\354\236\205</p>\n      </div>\n    </div>\n\n    <!-- Center & Right Controls -->\n    <div class=\"flex items-center gap-6\">\n      <!-- Coin Pair Selector -->\n      <div class=\"flex items-center gap-2 bg-slate-100/90 px-3 py-1.5 rounded-xl border border-slate-200\">\n        <span class=\"text-xs font-semibold text-slate-500\">\354\242\205\353\252\251:</span>\n        <select id=\"coinSelect\" class=\"bg-transparent font-bold text-sm text-slate-900 focus:outline-none cursor-pointer\">\n          <option value=\"BTC/USDT\">BTC / USDT</option>\n          <option value=\"ETH/USDT\">ETH / USDT</option>\n          <option value=\"SOL/USDT\">SOL / USDT</option>\n        </select>\n      </div>\n\n      <!-- Live Ticker Info -->\n      <div class=\"hidden md:flex items-center gap-4 border-l border-slate-200 pl-6\">\n        <div>\n          <div class=\"text-[11px] font-semibold text-slate-400\">\355\230\204\354\236\254 \354\213\234\354\236\245\352\260\200</div>\n          <div id=\"livePriceHeader\" class=\"text-base font-extrabold text-slate-900 mono\">$96,450.0</div>\n        </div>\n        <div>\n          <div class=\"text-[11px] font-semibold text-slate-400\">24H \353\263\200\353\217\231\353\245\240</div>\n          <div id=\"liveChangeHeader\" class=\"text-xs font-bold text-emerald-600\">+3.42%</div>\n        </div>\n      </div>\n\n      <!-- Bot ON/OFF Toggle -->\n      <button id=\"botToggleBtn\" class=\"flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-blue-600 hover:bg-blue-700 text-white transition-all shadow-sm ring-4 ring-blue-100\">\n        <i data-lucide=\"play\" class=\"w-4 h-4 fill-white\"></i>\n        <span id=\"botToggleLabel\">\353\264\207 \352\260\200\353\217\231 (START)</span>\n      </button>\n    </div>\n  </header>\n\n  <!-- Main Container -->\n  <main class=\"flex-1 max-w-7xl w-full mx-auto p-4 lg:p-6 space-y-6\">\n    \n    <!-- Stat Metrics Row -->\n    <div class=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n      <div class=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n        <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1 flex items-center justify-between\">\n          <span>\354\264\235 \354\236\220\354\202\260 \352\260\200\354\271\230 (Equity)</span>\n          <i data-lucide=\"wallet\" class=\"w-4 h-4 text-blue-600\"></i>\n        </div>\n        <div id=\"equityDisplay\" class=\"text-2xl font-extrabold mono text-slate-900\">$10,000.00</div>\n        <div class=\"flex items-center justify-between text-xs mt-1\">\n          <span id=\"cashDisplay\" class=\"text-slate-500\">\355\230\204\352\270\210: $10,000.00</span>\n          <span id=\"returnDisplay\" class=\"font-bold text-emerald-600\">+0.00%</span>\n        </div>\n      </div>\n\n      <div class=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n        <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1 flex items-center justify-between\">\n          <span>\353\263\264\354\234\240 \355\217\254\354\247\200\354\205\230 (Position)</span>\n          <i data-lucide=\"layers\" class=\"w-4 h-4 text-indigo-600\"></i>\n        </div>\n        <div id=\"positionDisplay\" class=\"text-xl font-extrabold mono text-slate-700\">FLAT (0.00)</div>\n        <div id=\"unrealizedPnlDisplay\" class=\"text-xs font-medium text-slate-500 mt-1\">\353\257\270\354\213\244\355\230\204 \354\206\220\354\235\265: $0.00 (0.00%)</div>\n      </div>\n\n      <div class=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n        <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1 flex items-center justify-between\">\n          <span>\355\230\204\354\236\254 ATR (\353\263\200\353\217\231\355\217\255)</span>\n          <i data-lucide=\"trending-up\" class=\"w-4 h-4 text-emerald-600\"></i>\n        </div>\n        <div id=\"atrDisplay\" class=\"text-2xl font-extrabold mono text-blue-600\">$1,250.0</div>\n        <div class=\"text-xs font-medium text-slate-500 mt-1\">\353\217\231\354\240\201 \354\261\204\353\204\220: \302\2612.0x ATR</div>\n      </div>\n\n      <div class=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n        <div class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1 flex items-center justify-between\">\n          <span>\353\210\204\354\240\201 \354\262\264\352\262\260 \353\260\217 \354\212\271\353\245\240</span>\n          <i data-lucide=\"pie-chart\" class=\"w-4 h-4 text-emerald-600\"></i>\n        </div>\n        <div id=\"winRateDisplay\" class=\"text-2xl font-extrabold mono text-emerald-600\">0.0% <span class=\"text-xs text-slate-500 font-normal\">(0\355\232\214)</span></div>\n        <div id=\"realizedPnlDisplay\" class=\"text-xs font-medium text-slate-500 mt-1\">\354\213\244\355\230\204 \354\206\220\354\235\265: $0.00</div>\n      </div>\n    </div>\n\n    <!-- Volatility ATR Chart Canvas Section -->\n    <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4\">\n      <div class=\"flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3\">\n        <div class=\"flex items-center gap-3\">\n          <div class=\"flex items-center gap-2\">\n            <i data-lucide=\"bar-chart-2\" class=\"w-5 h-5 text-blue-600\"></i>\n            <h2 class=\"font-bold text-slate-900 text-base\">ATR \353\263\200\353\217\231\354\204\261 \353\213\244\354\235\264\353\202\264\353\257\271 \353\260\264\353\223\234 \354\213\244\354\213\234\352\260\204 \354\260\250\355\212\270</h2>\n          </div>\n          <span id=\"botStatusBadge\" class=\"text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 flex items-center gap-1.5\">\n            <span class=\"w-2 h-2 rounded-full bg-slate-400\"></span>\n            \353\214\200\352\270\260 \354\244\221 (IDLE)\n          </span>\n        </div>\n\n        <!-- Band Legends -->\n        <div class=\"flex flex-wrap items-center gap-3 text-xs font-medium\">\n          <div class=\"flex items-center gap-1 text-emerald-700 bg-emerald-50 px-2 py-1 rounded-md border border-emerald-200\">\n            <span class=\"w-3 h-0.5 bg-emerald-500 inline-block\"></span>\n            <span>\354\203\201\353\213\250 \353\260\264\353\223\234 (\354\235\265\354\240\210\354\204\240 TP)</span>\n          </div>\n          <div class=\"flex items-center gap-1 text-slate-600 bg-slate-100 px-2 py-1 rounded-md border border-slate-200\">\n            <span class=\"w-3 h-0.5 bg-slate-400 inline-block\"></span>\n            <span>\354\244\221\354\213\254\354\204\240 (EMA Baseline)</span>\n          </div>\n          <div class=\"flex items-center gap-1 text-indigo-700 bg-indigo-50 px-2 py-1 rounded-md border border-indigo-200\">\n            <span class=\"w-3 h-0.5 bg-indigo-500 inline-block\"></span>\n            <span>\355\225\230\353\213\250 \353\260\264\353\223\234 (\353\247\244\354\210\230\354\204\240 BUY)</span>\n          </div>\n          <div class=\"flex items-center gap-1 text-rose-700 bg-rose-50 px-2 py-1 rounded-md border border-rose-200\">\n            <span class=\"w-3 h-0.5 bg-rose-500 inline-block\"></span>\n            <span>\353\217\231\354\240\201 \354\206\220\354\240\210\354\204\240 (Stop-Loss)</span>\n          </div>\n        </div>\n\n        <!-- Manual Quick Orders -->\n        <div class=\"flex items-center gap-2\">\n          <button id=\"manualBuyBtn\" class=\"px-3 py-1.5 text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-300 rounded-lg hover:bg-emerald-100 transition\">\n            + \354\210\230\353\217\231 \353\247\244\354\210\230\n          </button>\n          <button id=\"manualSellBtn\" class=\"px-3 py-1.5 text-xs font-bold bg-rose-50 text-rose-700 border border-rose-300 rounded-lg hover:bg-rose-100 transition\">\n            - \354\210\230\353\217\231 \354\262\255\354\202\260\n          </button>\n        </div>\n      </div>\n\n      <!-- Chart Container -->\n      <div class=\"relative w-full h-[380px] bg-slate-50/80 rounded-xl border border-slate-200 overflow-hidden\">\n        <canvas id=\"tradingChart\" class=\"w-full h-full block\"></canvas>\n        <div class=\"absolute bottom-2 left-4 text-[11px] text-slate-400 mono flex items-center gap-4\">\n          <span>\342\227\217 1\354\264\210 \354\213\244\354\213\234\352\260\204 \355\213\261 \352\260\261\354\213\240</span>\n          <span>\342\227\217 \355\216\204\354\212\244 \354\240\220: \354\213\244\354\213\234\352\260\204 \354\213\234\354\236\245\352\260\200</span>\n          <span>\342\227\217 \353\260\264\353\223\234 \355\204\260\354\271\230 \354\213\234 \354\236\220\353\217\231 \354\262\264\352\262\260</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Bottom Controls & Real-time Logs -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n      \n      <!-- Strategy Parameter Tuning Sliders -->\n      <div class=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between space-y-4\">\n        <div class=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n          <h3 class=\"font-bold text-slate-900 text-sm flex items-center gap-2\">\n            <i data-lucide=\"sliders\" class=\"w-4 h-4 text-blue-600\"></i>\n            \354\240\204\353\236\265 \355\214\214\353\235\274\353\257\270\355\204\260 \354\241\260\354\240\210\n          </h3>\n          <button id=\"resetParamsBtn\" class=\"text-xs text-slate-400 hover:text-blue-600 font-medium\">\354\264\210\352\270\260\355\231\224</button>\n        </div>\n\n        <!-- ATR Multiplier Slider -->\n        <div class=\"space-y-1.5\">\n          <div class=\"flex justify-between text-xs font-semibold\">\n            <span class=\"text-slate-700\">ATR \353\260\264\353\223\234 \353\260\260\354\210\230 (Multiplier)</span>\n            <span id=\"atrMultiplierVal\" class=\"text-blue-600 mono font-bold\">2.0x</span>\n          </div>\n          <input id=\"atrMultiplierInput\" type=\"range\" min=\"1.0\" max=\"4.0\" step=\"0.1\" value=\"2.0\" class=\"w-full accent-blue-600 cursor-pointer h-1.5 bg-slate-200 rounded-lg appearance-none\">\n          <div class=\"flex justify-between text-[10px] text-slate-400 mono\">\n            <span>1.0x (\355\203\200\354\235\264\355\212\270\355\225\234 \354\261\204\353\204\220)</span>\n            <span>4.0x (\353\204\223\354\235\200 \354\261\204\353\204\220)</span>\n          </div>\n        </div>\n\n        <!-- Order Ratio Slider -->\n        <div class=\"space-y-1.5\">\n          <div class=\"flex justify-between text-xs font-semibold\">\n            <span class=\"text-slate-700\">1\355\232\214 \354\243\274\353\254\270 \354\236\220\354\202\260 \353\271\204\354\244\221 (Order Size)</span>\n            <span id=\"orderRatioVal\" class=\"text-blue-600 mono font-bold\">25%</span>\n          </div>\n          <input id=\"orderRatioInput\" type=\"range\" min=\"5\" max=\"100\" step=\"5\" value=\"25\" class=\"w-full accent-blue-600 cursor-pointer h-1.5 bg-slate-200 rounded-lg appearance-none\">\n          <div class=\"flex justify-between text-[10px] text-slate-400 mono\">\n            <span>5% (\353\266\204\355\225\240 \353\247\244\353\247\244)</span>\n            <span>100% (\354\240\204\354\225\241 \353\252\260\353\271\265)</span>\n          </div>\n        </div>\n\n        <!-- Stop Loss Multiplier Slider -->\n        <div class=\"space-y-1.5\">\n          <div class=\"flex justify-between text-xs font-semibold\">\n            <span class=\"text-slate-700\">\353\217\231\354\240\201 \354\206\220\354\240\210 \353\260\260\354\210\230 (Stop Loss ATR)</span>\n            <span id=\"stopLossVal\" class=\"text-rose-600 mono font-bold\">1.5x</span>\n          </div>\n          <input id=\"stopLossInput\" type=\"range\" min=\"0.5\" max=\"3.0\" step=\"0.1\" value=\"1.5\" class=\"w-full accent-rose-600 cursor-pointer h-1.5 bg-slate-200 rounded-lg appearance-none\">\n          <div class=\"flex justify-between text-[10px] text-slate-400 mono\">\n            <span>0.5x (\353\271\240\353\245\270 \354\206\220\354\240\210)</span>\n            <span>3.0x (\354\227\254\354\234\240 \353\260\251\354\226\264)</span>\n          </div>\n        </div>\n\n        <!-- Reset Simulation -->\n        <button id=\"resetSimBtn\" class=\"w-full py-2 px-3 text-xs font-bold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-xl transition flex items-center justify-center gap-1.5\">\n          <i data-lucide=\"refresh-cw\" class=\"w-3.5 h-3.5\"></i>\n          <span>\352\260\200\354\203\201 \354\236\220\354\202\260 \354\264\210\352\270\260\355\231\224 ($10,000)</span>\n        </button>\n      </div>\n\n      <!-- Real-time Virtual Trading Log Console -->\n      <div class=\"lg:col-span-2 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col h-[380px]\">\n        <div class=\"flex items-center justify-between border-b border-slate-100 pb-3 mb-3\">\n          <div class=\"flex items-center gap-2\">\n            <i data-lucide=\"terminal\" class=\"w-4 h-4 text-slate-700\"></i>\n            <h3 class=\"font-bold text-slate-900 text-sm\">\354\213\244\354\213\234\352\260\204 \352\260\200\354\203\201 \353\247\244\353\247\244 \353\260\217 \354\262\264\352\262\260 \353\241\234\352\267\270</h3>\n            <span id=\"logCountBadge\" class=\"text-[10px] font-mono font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full\">0\352\261\264</span>\n          </div>\n          <button id=\"clearLogsBtn\" class=\"text-xs text-slate-400 hover:text-slate-700 font-medium\">\354\247\200\354\232\260\352\270\260</button>\n        </div>\n\n        <!-- Scrollable Log List -->\n        <div id=\"logsContainer\" class=\"flex-1 overflow-y-auto space-y-2 pr-1 mono text-xs\">\n          <!-- Dynamically inserted via JavaScript -->\n        </div>\n      </div>\n\n    </div>\n  </main>\n\n  <script>\n    // Initialize Lucide Icons\n    lucide.createIcons();\n\n    // Configuration Data for Coins\n    const COINS = {\n      \'BTC/USDT\': { symbol: \'BTC/USDT\', price: 96450.0, basePrice: 96450.0, atr: 1250.0, change: 3.42 },\n      \'ETH/USDT\': { symbol: \'ETH/USDT\', price: 2780.5, basePrice: 2780.5, atr: 48.0, change: -1.15 },\n      \'SOL/USDT\': { symbol: \'SOL/USDT\', price: 194.2, basePrice: 194.2, atr: 4.8, change: 5.68 }\n    };\n\n    // State Variables\n    const state = {\n      isBotActive: false,\n      selectedCoin: \'BTC/USDT\',\n      price: COINS[\'BTC/USDT\'].price,\n      basePrice: COINS[\'BTC/USDT\'].basePrice,\n      atr: COINS[\'BTC/USDT\'].atr,\n      atrMultiplier: 2.0,\n      orderRatio: 25,\n      stopLossMultiplier: 1.5,\n      balance: 10000.0,\n      initialBalance: 10000.0,\n      positionAmount: 0,\n      entryPrice: null,\n      realizedPnl: 0,\n      totalTrades: 0,\n      winTrades: 0,\n      history: []\n    };\n\n    // DOM Elements\n    const coinSelect = document.getElementById(\'coinSelect\');\n    const livePriceHeader = document.getElementById(\'livePriceHeader\');\n    const liveChangeHeader = document.getElementById(\'liveChangeHeader\');\n    const botToggleBtn = document.getElementById(\'botToggleBtn\');\n    const botToggleLabel = document.getElementById(\'botToggleLabel\');\n    const botStatusBadge = document.getElementById(\'botStatusBadge\');\n    \n    const equityDisplay = document.getElementById(\'equityDisplay\');\n    const cashDisplay = document.getElementById(\'cashDisplay\');\n    const returnDisplay = document.getElementById(\'returnDisplay\');\n    const positionDisplay = document.getElementById(\'positionDisplay\');\n    const unrealizedPnlDisplay = document.getElementById(\'unrealizedPnlDisplay\');\n    const atrDisplay = document.getElementById(\'atrDisplay\');\n    const winRateDisplay = document.getElementById(\'winRateDisplay\');\n    const realizedPnlDisplay = document.getElementById(\'realizedPnlDisplay\');\n    \n    const logsContainer = document.getElementById(\'logsContainer\');\n    const logCountBadge = document.getElementById(\'logCountBadge\');\n    \n    const canvas = document.getElementById(\'tradingChart\');\n    const ctx = canvas.getContext(\'2d\');\n\n    // Slider Elements\n    const atrMultiplierInput = document.getElementById(\'atrMultiplierInput\');\n    const atrMultiplierVal = document.getElementById(\'atrMultiplierVal\');\n    const orderRatioInput = document.getElementById(\'orderRatioInput\');\n    const orderRatioVal = document.getElementById(\'orderRatioVal\');\n    const stopLossInput = document.getElementById(\'stopLossInput\');\n    const stopLossVal = document.getElementById(\'stopLossVal\');\n\n    // Utility: Format currency\n    function fmt(val) {\n      return \'$\' + Number(val).toLocaleString(\'en-US\', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n    }\n\n    // Append Trading Log\n    let logCounter = 0;\n    function addLog(type, message, price, pnl = null) {\n      logCounter++;\n      logCountBadge.textContent = logCounter + \'\352\261\264\';\n      const timeStr = new Date().toLocaleTimeString();\n      \n      let badgeClass = \'bg-slate-200 text-slate-800\';\n      let cardBorder = \'border-slate-200 bg-slate-50/70 text-slate-800\';\n\n      if (type === \'BUY\') {\n        badgeClass = \'bg-emerald-600 text-white\';\n        cardBorder = \'border-emerald-200 bg-emerald-50/70 text-emerald-950\';\n      } else if (type === \'SELL\') {\n        badgeClass = \'bg-blue-600 text-white\';\n        cardBorder = \'border-blue-200 bg-blue-50/70 text-blue-950\';\n      } else if (type === \'STOP_LOSS\') {\n        badgeClass = \'bg-rose-600 text-white\';\n        cardBorder = \'border-rose-200 bg-rose-50/70 text-rose-950\';\n      }\n\n      const row = document.createElement(\'div\');\n      row.className = `p-2.5 rounded-xl border text-[11px] flex items-start gap-2.5 transition-all ${cardBorder}`;\n      row.innerHTML = `\n        <span class=\"text-slate-400 shrink-0 text-[10px] mt-0.5\">${timeStr}</span>\n        <span class=\"px-1.5 py-0.5 rounded font-extrabold uppercase text-[9px] shrink-0 ${badgeClass}\">[${type}]</span>\n        <span class=\"flex-1 font-medium leading-relaxed\">${message}</span>\n        <div class=\"text-right shrink-0 font-bold\">\n          <div>${fmt(price)}</div>\n          ${pnl !== null ? `<div class=\"text-[10px] ${pnl >= 0 ? \'text-emerald-600\' : \'text-rose-600\'}\">${pnl >= 0 ? \'+\' : \'\'}${fmt(pnl)}</div>` : \'\'}\n        </div>\n      `;\n      logsContainer.insertBefore(row, logsContainer.firstChild);\n    }\n\n    // Build initial chart history\n    function initHistory() {\n      state.history = [];\n      const now = Date.now();\n      let cur = state.basePrice;\n      for (let i = 40; i >= 0; i--) {\n        const noise = (Math.random() - 0.5) * (state.atr * 0.4);\n        cur += noise;\n        const baseline = state.basePrice + Math.sin(i * 0.2) * (state.atr * 0.3);\n        const upper = baseline + state.atr * state.atrMultiplier;\n        const lower = baseline - state.atr * state.atrMultiplier;\n        const stop = lower - state.atr * state.stopLossMultiplier;\n\n        state.history.push({\n          time: now - i * 1000,\n          price: cur,\n          baseline,\n          upperBand: upper,\n          lowerBand: lower,\n          stopLoss: stop\n        });\n      }\n      state.price = state.history[state.history.length - 1].price;\n      addLog(\'SYSTEM\', `${state.selectedCoin} \352\260\200\354\203\201 \353\247\210\354\274\223 \353\215\260\354\235\264\355\204\260 \353\241\234\353\223\234 \354\231\204\353\243\214`, state.price);\n    }\n\n    // Canvas Chart Rendering\n    function renderChart() {\n      const rect = canvas.getBoundingClientRect();\n      const dpr = window.devicePixelRatio || 1;\n      canvas.width = rect.width * dpr;\n      canvas.height = rect.height * dpr;\n      ctx.scale(dpr, dpr);\n\n      const w = rect.width;\n      const h = rect.height;\n      const pad = { top: 28, right: 85, bottom: 28, left: 16 };\n      const cw = w - pad.left - pad.right;\n      const ch = h - pad.top - pad.bottom;\n\n      ctx.clearRect(0, 0, w, h);\n\n      if (state.history.length < 2) return;\n\n      let minP = Infinity, maxP = -Infinity;\n      state.history.forEach(pt => {\n        minP = Math.min(minP, pt.price, pt.lowerBand, pt.stopLoss);\n        maxP = Math.max(maxP, pt.price, pt.upperBand);\n      });\n      const range = (maxP - minP) || 1;\n      const pMin = minP - range * 0.08;\n      const pMax = maxP + range * 0.08;\n      const fRange = pMax - pMin;\n\n      const getY = (val) => pad.top + ch - ((val - pMin) / fRange) * ch;\n      const getX = (idx) => pad.left + (idx / (state.history.length - 1)) * cw;\n\n      // 1. Grid Lines\n      ctx.strokeStyle = \'#f1f5f9\';\n      ctx.lineWidth = 1;\n      for (let i = 0; i <= 4; i++) {\n        const y = pad.top + (i / 4) * ch;\n        ctx.beginPath();\n        ctx.moveTo(pad.left, y);\n        ctx.lineTo(w - pad.right, y);\n        ctx.stroke();\n\n        const pVal = pMax - (i / 4) * fRange;\n        ctx.fillStyle = \'#94a3b8\';\n        ctx.font = \'10px \"JetBrains Mono\", monospace\';\n        ctx.fillText(fmt(pVal), w - pad.right + 8, y + 3);\n      }\n\n      // 2. Shaded ATR Channel\n      ctx.beginPath();\n      for (let i = 0; i < state.history.length; i++) {\n        const x = getX(i);\n        const y = getY(state.history[i].upperBand);\n        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n      }\n      for (let i = state.history.length - 1; i >= 0; i--) {\n        const x = getX(i);\n        const y = getY(state.history[i].lowerBand);\n        ctx.lineTo(x, y);\n      }\n      ctx.closePath();\n      ctx.fillStyle = \'rgba(59, 130, 246, 0.04)\';\n      ctx.fill();\n\n      // 3. Draw Bands\n      const drawLine = (prop, color, dash = [], width = 1.6) => {\n        ctx.beginPath();\n        ctx.strokeStyle = color;\n        ctx.lineWidth = width;\n        ctx.setLineDash(dash);\n        state.history.forEach((pt, i) => {\n          const x = getX(i), y = getY(pt[prop]);\n          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n        });\n        ctx.stroke();\n        ctx.setLineDash([]);\n      };\n\n      drawLine(\'stopLoss\', \'#f43f5e\', [4, 4], 1.5);\n      drawLine(\'lowerBand\', \'#6366f1\', [5, 3], 1.8);\n      drawLine(\'baseline\', \'#94a3b8\', [], 1.2);\n      drawLine(\'upperBand\', \'#10b981\', [5, 3], 1.8);\n\n      // 4. Main Price Line\n      ctx.beginPath();\n      ctx.strokeStyle = \'#2563eb\';\n      ctx.lineWidth = 2.4;\n      state.history.forEach((pt, i) => {\n        const x = getX(i), y = getY(pt.price);\n        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n      });\n      ctx.stroke();\n\n      // 5. Draw Buy / Sell Trade Markers\n      state.history.forEach((pt, i) => {\n        if (!pt.event) return;\n        const x = getX(i);\n        const y = getY(pt.price);\n        ctx.save();\n        if (pt.event === \'BUY\') {\n          ctx.fillStyle = \'#10b981\';\n          ctx.beginPath();\n          ctx.moveTo(x, y + 12);\n          ctx.lineTo(x - 5, y + 22);\n          ctx.lineTo(x + 5, y + 22);\n          ctx.closePath();\n          ctx.fill();\n        } else if (pt.event === \'SELL\') {\n          ctx.fillStyle = \'#059669\';\n          ctx.beginPath();\n          ctx.moveTo(x, y - 12);\n          ctx.lineTo(x - 5, y - 22);\n          ctx.lineTo(x + 5, y - 22);\n          ctx.closePath();\n          ctx.fill();\n        } else if (pt.event === \'STOP_LOSS\') {\n          ctx.fillStyle = \'#e11d48\';\n          ctx.beginPath();\n          ctx.moveTo(x, y + 12);\n          ctx.lineTo(x - 5, y + 22);\n          ctx.lineTo(x + 5, y + 22);\n          ctx.closePath();\n          ctx.fill();\n        }\n        ctx.restore();\n      });\n\n      // 6. Current Price Pulsing Dot\n      const lastIdx = state.history.length - 1;\n      const lastPt = state.history[lastIdx];\n      const curX = getX(lastIdx);\n      const curY = getY(lastPt.price);\n\n      ctx.save();\n      // Outer Halo\n      ctx.beginPath();\n      ctx.arc(curX, curY, 8, 0, Math.PI * 2);\n      ctx.fillStyle = \'rgba(37, 99, 235, 0.25)\';\n      ctx.fill();\n      // Center Core Dot\n      ctx.beginPath();\n      ctx.arc(curX, curY, 4.5, 0, Math.PI * 2);\n      ctx.fillStyle = \'#2563eb\';\n      ctx.fill();\n      ctx.restore();\n\n      // 7. Right Axis Badge\n      ctx.fillStyle = \'#2563eb\';\n      ctx.beginPath();\n      ctx.roundRect(w - pad.right + 4, curY - 10, pad.right - 8, 20, 4);\n      ctx.fill();\n      ctx.fillStyle = \'#ffffff\';\n      ctx.font = \'bold 10px \"JetBrains Mono\", monospace\';\n      ctx.fillText(fmt(lastPt.price), w - pad.right + 8, curY + 4);\n    }\n\n    // Tick simulation step (1-second interval)\n    function tick() {\n      const meanRev = (state.basePrice - state.price) * 0.05;\n      const noise = (Math.random() - 0.49) * state.atr * 0.45;\n      state.price = Number((state.price + meanRev + noise).toFixed(2));\n\n      const baseline = Number((state.basePrice + Math.sin(Date.now() / 8000) * (state.atr * 0.3)).toFixed(2));\n      const upper = Number((baseline + state.atr * state.atrMultiplier).toFixed(2));\n      const lower = Number((baseline - state.atr * state.atrMultiplier).toFixed(2));\n      \n      let stop = lower - state.atr * state.stopLossMultiplier;\n      if (state.positionAmount > 0 && state.entryPrice) {\n        stop = state.entryPrice - state.atr * state.stopLossMultiplier;\n      }\n      stop = Number(stop.toFixed(2));\n\n      let eventType = null;\n\n      // Automated Strategy Execution Logic\n      if (state.isBotActive) {\n        // BUY: touches lower band\n        if (state.positionAmount === 0 && state.price <= lower) {\n          const budget = state.balance * (state.orderRatio / 100);\n          const qty = Number((budget / state.price).toFixed(4));\n          if (budget > 10) {\n            state.balance -= budget;\n            state.positionAmount = qty;\n            state.entryPrice = state.price;\n            eventType = \'BUY\';\n            addLog(\'BUY\', `\355\225\230\353\213\250 \353\260\264\353\223\234(${fmt(lower)}) \355\204\260\354\271\230 \353\247\244\354\210\230 \354\262\264\352\262\260 [\353\271\204\354\244\221 ${state.orderRatio}%]`, state.price);\n          }\n        }\n        // SELL: touches upper band (Take Profit)\n        else if (state.positionAmount > 0 && state.entryPrice && state.price >= upper) {\n          const proceeds = state.positionAmount * state.price;\n          const invested = state.positionAmount * state.entryPrice;\n          const pnl = proceeds - invested;\n          const pnlPct = ((state.price - state.entryPrice) / state.entryPrice) * 100;\n          state.balance += proceeds;\n          state.realizedPnl += pnl;\n          state.totalTrades++;\n          if (pnl > 0) state.winTrades++;\n          state.positionAmount = 0;\n          state.entryPrice = null;\n          eventType = \'SELL\';\n          addLog(\'SELL\', `\354\203\201\353\213\250 \353\260\264\353\223\234(${fmt(upper)}) \354\235\265\354\240\210 \354\262\255\354\202\260 \354\231\204\353\243\214 (+${pnlPct.toFixed(2)}%)`, state.price, pnl);\n        }\n        // STOP LOSS: breaks trailing stop\n        else if (state.positionAmount > 0 && state.entryPrice && state.price <= stop) {\n          const proceeds = state.positionAmount * state.price;\n          const invested = state.positionAmount * state.entryPrice;\n          const pnl = proceeds - invested;\n          const pnlPct = ((state.price - state.entryPrice) / state.entryPrice) * 100;\n          state.balance += proceeds;\n          state.realizedPnl += pnl;\n          state.totalTrades++;\n          state.positionAmount = 0;\n          state.entryPrice = null;\n          eventType = \'STOP_LOSS\';\n          addLog(\'STOP_LOSS\', `\353\217\231\354\240\201 \354\206\220\354\240\210\354\204\240(${fmt(stop)}) \354\235\264\355\203\210 \353\260\251\354\226\264 \354\206\220\354\240\210 (-${Math.abs(pnlPct).toFixed(2)}%)`, state.price, pnl);\n        }\n      }\n\n      state.history.push({\n        time: Date.now(),\n        price: state.price,\n        baseline,\n        upperBand: upper,\n        lowerBand: lower,\n        stopLoss: stop,\n        event: eventType\n      });\n      if (state.history.length > 50) state.history.shift();\n\n      updateUI();\n      renderChart();\n    }\n\n    // Refresh UI Metrics\n    function updateUI() {\n      livePriceHeader.textContent = fmt(state.price);\n      \n      const equity = state.balance + state.positionAmount * state.price;\n      equityDisplay.textContent = fmt(equity);\n      cashDisplay.textContent = \'\355\230\204\352\270\210: \' + fmt(state.balance);\n      \n      const ret = ((equity - state.initialBalance) / state.initialBalance) * 100;\n      returnDisplay.textContent = (ret >= 0 ? \'+\' : \'\') + ret.toFixed(2) + \'%\';\n      returnDisplay.className = `font-bold ${ret >= 0 ? \'text-emerald-600\' : \'text-rose-600\'}`;\n\n      if (state.positionAmount > 0 && state.entryPrice) {\n        positionDisplay.textContent = `LONG (${state.positionAmount})`;\n        positionDisplay.className = \'text-xl font-extrabold mono text-indigo-600\';\n        const unPnl = (state.price - state.entryPrice) * state.positionAmount;\n        const unPct = ((state.price - state.entryPrice) / state.entryPrice) * 100;\n        unrealizedPnlDisplay.textContent = `\353\257\270\354\213\244\355\230\204 \354\206\220\354\235\265: ${unPnl >= 0 ? \'+\' : \'\'}${fmt(unPnl)} (${unPct.toFixed(2)}%)`;\n        unrealizedPnlDisplay.className = unPnl >= 0 ? \'text-xs font-bold text-emerald-600 mt-1\' : \'text-xs font-bold text-rose-600 mt-1\';\n      } else {\n        positionDisplay.textContent = \'FLAT (\353\254\264\355\217\254\354\247\200\354\205\230)\';\n        positionDisplay.className = \'text-xl font-extrabold mono text-slate-700\';\n        unrealizedPnlDisplay.textContent = \'\353\257\270\354\213\244\355\230\204 \354\206\220\354\235\265: $0.00 (0.00%)\';\n        unrealizedPnlDisplay.className = \'text-xs font-medium text-slate-500 mt-1\';\n      }\n\n      atrDisplay.textContent = fmt(state.atr);\n      realizedPnlDisplay.textContent = \'\354\213\244\355\230\204 \354\206\220\354\235\265: \' + (state.realizedPnl >= 0 ? \'+\' : \'\') + fmt(state.realizedPnl);\n      realizedPnlDisplay.className = state.realizedPnl >= 0 ? \'text-xs font-bold text-emerald-600 mt-1\' : \'text-xs font-bold text-rose-600 mt-1\';\n      \n      const wr = state.totalTrades > 0 ? ((state.winTrades / state.totalTrades) * 100).toFixed(1) : \'0.0\';\n      winRateDisplay.innerHTML = `${wr}% <span class=\"text-xs text-slate-500 font-normal\">(${state.totalTrades}\355\232\214)</span>`;\n    }\n\n    // Toggle Bot Button\n    botToggleBtn.addEventListener(\'click\', () => {\n      state.isBotActive = !state.isBotActive;\n      if (state.isBotActive) {\n        botToggleBtn.className = \'flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-rose-600 hover:bg-rose-700 text-white transition-all shadow-sm ring-4 ring-rose-100\';\n        botToggleLabel.textContent = \'\353\264\207 \354\240\225\354\247\200 (STOP)\';\n        botStatusBadge.className = \'text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 ring-1 ring-emerald-300 flex items-center gap-1.5\';\n        botStatusBadge.innerHTML = \'<span class=\"w-2 h-2 rounded-full bg-emerald-500 animate-ping\"></span> \354\236\220\353\217\231 \352\260\200\353\217\231 \354\244\221 (ACTIVE)\';\n        addLog(\'SYSTEM\', `\354\236\220\353\217\231\353\247\244\353\247\244 \353\264\207 \355\231\234\354\204\261\355\231\224 [ATR: ${state.atrMultiplier}x | \354\243\274\353\254\270\353\271\204\354\244\221: ${state.orderRatio}%]`, state.price);\n      } else {\n        botToggleBtn.className = \'flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-blue-600 hover:bg-blue-700 text-white transition-all shadow-sm ring-4 ring-blue-100\';\n        botToggleLabel.textContent = \'\353\264\207 \352\260\200\353\217\231 (START)\';\n        botStatusBadge.className = \'text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 flex items-center gap-1.5\';\n        botStatusBadge.innerHTML = \'<span class=\"w-2 h-2 rounded-full bg-slate-400\"></span> \353\214\200\352\270\260 \354\244\221 (IDLE)\';\n        addLog(\'SYSTEM\', \'\354\236\220\353\217\231\353\247\244\353\247\244 \353\264\207 \354\235\274\354\213\234\354\240\225\354\247\200 (\353\214\200\352\270\260 \353\252\250\353\223\234)\', state.price);\n      }\n    });\n\n    // Coin Change Listener\n    coinSelect.addEventListener(\'change\', (e) => {\n      const cfg = COINS[e.target.value];\n      state.selectedCoin = cfg.symbol;\n      state.basePrice = cfg.basePrice;\n      state.atr = cfg.atr;\n      liveChangeHeader.textContent = (cfg.change >= 0 ? \'+\' : \'\') + cfg.change + \'%\';\n      liveChangeHeader.className = cfg.change >= 0 ? \'text-xs font-bold text-emerald-600\' : \'text-xs font-bold text-rose-600\';\n      initHistory();\n      renderChart();\n      updateUI();\n    });\n\n    // Sliders Listeners\n    atrMultiplierInput.addEventListener(\'input\', (e) => {\n      state.atrMultiplier = parseFloat(e.target.value);\n      atrMultiplierVal.textContent = state.atrMultiplier.toFixed(1) + \'x\';\n    });\n    orderRatioInput.addEventListener(\'input\', (e) => {\n      state.orderRatio = parseInt(e.target.value);\n      orderRatioVal.textContent = state.orderRatio + \'%\';\n    });\n    stopLossInput.addEventListener(\'input\', (e) => {\n      state.stopLossMultiplier = parseFloat(e.target.value);\n      stopLossVal.textContent = state.stopLossMultiplier.toFixed(1) + \'x\';\n    });\n\n    // Manual Buy Button\n    document.getElementById(\'manualBuyBtn\').addEventListener(\'click\', () => {\n      if (state.positionAmount > 0) return;\n      const budget = state.balance * (state.orderRatio / 100);\n      const qty = Number((budget / state.price).toFixed(4));\n      state.balance -= budget;\n      state.positionAmount = qty;\n      state.entryPrice = state.price;\n      addLog(\'BUY\', `[\354\210\230\353\217\231 \354\243\274\353\254\270] \354\213\234\354\236\245\352\260\200 \353\247\244\354\210\230 \354\262\264\352\262\260 - \355\210\254\354\236\220\352\270\210 ${fmt(budget)}`, state.price);\n      updateUI();\n    });\n\n    // Manual Sell Button\n    document.getElementById(\'manualSellBtn\').addEventListener(\'click\', () => {\n      if (state.positionAmount === 0 || !state.entryPrice) return;\n      const proceeds = state.positionAmount * state.price;\n      const invested = state.positionAmount * state.entryPrice;\n      const pnl = proceeds - invested;\n      state.balance += proceeds;\n      state.realizedPnl += pnl;\n      state.totalTrades++;\n      if (pnl > 0) state.winTrades++;\n      state.positionAmount = 0;\n      state.entryPrice = null;\n      addLog(\'SELL\', `[\354\210\230\353\217\231 \354\262\255\354\202\260] \354\213\234\354\236\245\352\260\200 \354\240\204\353\237\211 \353\247\244\353\217\204 \354\231\204\353\243\214`, state.price, pnl);\n      updateUI();\n    });\n\n    // Clear Logs Button\n    document.getElementById(\'clearLogsBtn\').addEventListener(\'click\', () => {\n      logsContainer.innerHTML = \'\';\n      logCounter = 0;\n      logCountBadge.textContent = \'0\352\261\264\';\n    });\n\n    // Reset Simulation\n    document.getElementById(\'resetSimBtn\').addEventListener(\'click\', () => {\n      state.balance = 10000;\n      state.positionAmount = 0;\n      state.entryPrice = null;\n      state.realizedPnl = 0;\n      state.totalTrades = 0;\n      state.winTrades = 0;\n      addLog(\'SYSTEM\', \'\354\213\234\353\256\254\353\240\210\354\235\264\354\205\230 \352\263\204\354\242\214 \353\260\217 \353\247\244\353\247\244 \355\206\265\352\263\204 \354\264\210\352\270\260\355\231\224 ($10,000 USD)\', state.price);\n      updateUI();\n    });\n\n    // Reset Parameters Button\n    document.getElementById(\'resetParamsBtn\').addEventListener(\'click\', () => {\n      state.atrMultiplier = 2.0;\n      state.orderRatio = 25;\n      state.stopLossMultiplier = 1.5;\n      atrMultiplierInput.value = 2.0;\n      atrMultiplierVal.textContent = \'2.0x\';\n      orderRatioInput.value = 25;\n      orderRatioVal.textContent = \'25%\';\n      stopLossInput.value = 1.5;\n      stopLossVal.textContent = \'1.5x\';\n    });\n\n    // Initial Launch\n    initHistory();\n    renderChart();\n    updateUI();\n    window.addEventListener(\'resize\', renderChart);\n\n    // 1-second interval for real-time simulation tick\n    setInterval(tick, 1000);\n  </script>\n</body>\n</html>\n```"
    stop_reason: STOP_REASON_STOP_PATTERN
  }
}
