  user_input {
    user_response: "# Role & Objective\n\353\213\271\354\213\240\354\235\200 \355\212\270\353\240\210\354\235\264\353\224\251 UI/UX \353\260\217 \355\222\200\354\212\244\355\203\235 \355\224\204\353\241\234\355\206\240\355\203\200\354\236\205 \354\240\204\353\254\270\352\260\200\354\236\205\353\213\210\353\213\244.\nAntigravity \354\227\220\354\235\264\354\240\204\355\212\270\354\227\220\352\262\214 \354\240\204\354\262\264 \355\222\200\354\212\244\355\203\235 \355\224\204\353\241\234\354\240\235\355\212\270\353\245\274 \353\271\214\353\223\234\355\225\230\353\217\204\353\241\235 \354\247\200\354\213\234\355\225\230\352\270\260 \354\240\204, \353\270\214\353\235\274\354\232\260\354\240\200\354\227\220\354\204\234 \353\260\224\353\241\234 \354\227\264\354\226\264 \353\240\210\354\235\264\354\225\204\354\233\203\352\263\274 \353\217\231\354\236\221\354\235\204 \352\262\200\354\246\235\355\225\240 \354\210\230 \354\236\210\353\212\224 \"\353\213\250\354\235\274 \355\214\214\354\235\274(Single HTML) \354\235\270\355\204\260\353\236\231\355\213\260\353\270\214 \353\252\251\354\227\205\"\354\235\204 \354\236\221\354\204\261\355\225\264\354\243\274\354\204\270\354\232\224.\n\n# Requirements\n1. Tech Stack:\n   - Single HTML file (Tailwind CSS CDN, Chart.js or Recharts via CDN/Babel, Lucide Icons).\n2. Features to Mock:\n   - \353\235\274\354\235\264\355\212\270 \355\205\214\353\247\210 \353\214\200\354\213\234\353\263\264\353\223\234 \353\240\210\354\235\264\354\225\204\354\233\203 (\355\227\244\353\215\224, \354\275\224\354\235\270 \354\204\240\355\203\235\352\270\260, \353\264\207 ON/OFF \355\206\240\352\270\200).\n   - \353\263\200\353\217\231\354\204\261 ATR \354\260\250\355\212\270 \354\230\201\354\227\255: \354\203\201\353\213\250 \353\260\264\353\223\234(\354\235\265\354\240\210\354\204\240), \352\270\260\354\244\200\354\204\240, \355\225\230\353\213\250 \353\260\264\353\223\234(\353\247\244\354\210\230\354\204\240), \353\217\231\354\240\201 \354\206\220\354\240\210\354\204\240\354\235\264 \355\221\234\354\213\234\353\220\230\352\263\240, \355\230\204\354\236\254\352\260\200\352\260\200 \355\216\204\354\212\244 \354\225\240\353\213\210\353\251\224\354\235\264\354\205\230(Pulsing Dot)\354\234\274\353\241\234 \354\233\200\354\247\201\354\235\264\353\212\224 \354\213\234\352\260\201\355\231\224.\n   - \355\225\230\353\213\250 \355\214\214\353\235\274\353\257\270\355\204\260 \354\241\260\354\240\210 \354\212\254\353\235\274\354\235\264\353\215\224(ATR \353\260\260\354\210\230, \354\243\274\353\254\270 \353\271\204\354\234\250) \353\260\217 \354\213\244\354\213\234\352\260\204 \352\260\200\354\203\201 \353\247\244\353\247\244 \353\241\234\352\267\270 \354\266\234\353\240\245 \354\230\201\354\227\255.\n3. Interactive Demo:\n   - \'\353\264\207 ON\' \355\206\240\352\270\200\354\235\204 \354\274\234\353\251\264 1\354\264\210\353\247\210\353\213\244 \352\260\200\354\203\201 \352\260\200\352\262\251 \353\215\260\354\235\264\355\204\260\352\260\200 \352\260\261\354\213\240\353\220\230\353\251\260 \355\216\204\354\212\244 \354\240\220\354\235\264 \354\203\201/\355\225\230\353\213\250 \353\260\264\353\223\234 \354\202\254\354\235\264\353\245\274 \354\233\200\354\247\201\354\235\264\352\263\240, \353\260\264\353\223\234 \355\204\260\354\271\230 \354\213\234 \353\241\234\352\267\270 \354\260\275\354\227\220 [BUY], [SELL] \353\241\234\352\267\270\352\260\200 \354\260\215\355\236\210\353\217\204\353\241\235 \352\260\204\353\213\250\355\225\234 \354\236\220\353\260\224\354\212\244\355\201\254\353\246\275\355\212\270 \355\203\200\354\235\264\353\250\270\353\245\274 \353\202\264\354\236\245\355\225\230\354\204\270\354\232\224.\n\n# Output Format\n- \353\263\204\353\217\204\354\235\230 \354\204\244\353\252\205 \354\227\206\354\235\264 \353\260\224\353\241\234 .html\353\241\234 \354\240\200\354\236\245\355\225\264 \353\270\214\353\235\274\354\232\260\354\240\200\354\227\220\354\204\234 \354\227\264\354\226\264\353\263\274 \354\210\230 \354\236\210\353\212\224 \354\231\204\354\204\261\353\220\234 \353\213\250\354\235\274 HTML \354\275\224\353\223\234\353\247\214 \354\266\234\353\240\245\355\225\230\354\204\270\354\232\224."
    items {
      text: "# Role & Objective\n\353\213\271\354\213\240\354\235\200 \355\212\270\353\240\210\354\235\264\353\224\251 UI/UX \353\260\217 \355\222\200\354\212\244\355\203\235 \355\224\204\353\241\234\355\206\240\355\203\200\354\236\205 \354\240\204\353\254\270\352\260\200\354\236\205\353\213\210\353\213\244.\nAntigravity \354\227\220\354\235\264\354\240\204\355\212\270\354\227\220\352\262\214 \354\240\204\354\262\264 \355\222\200\354\212\244\355\203\235 \355\224\204\353\241\234\354\240\235\355\212\270\353\245\274 \353\271\214\353\223\234\355\225\230\353\217\204\353\241\235 \354\247\200\354\213\234\355\225\230\352\270\260 \354\240\204, \353\270\214\353\235\274\354\232\260\354\240\200\354\227\220\354\204\234 \353\260\224\353\241\234 \354\227\264\354\226\264 \353\240\210\354\235\264\354\225\204\354\233\203\352\263\274 \353\217\231\354\236\221\354\235\204 \352\262\200\354\246\235\355\225\240 \354\210\230 \354\236\210\353\212\224 \"\353\213\250\354\235\274 \355\214\214\354\235\274(Single HTML) \354\235\270\355\204\260\353\236\231\355\213\260\353\270\214 \353\252\251\354\227\205\"\354\235\204 \354\236\221\354\204\261\355\225\264\354\243\274\354\204\270\354\232\224.\n\n# Requirements\n1. Tech Stack:\n   - Single HTML file (Tailwind CSS CDN, Chart.js or Recharts via CDN/Babel, Lucide Icons).\n2. Features to Mock:\n   - \353\235\274\354\235\264\355\212\270 \355\205\214\353\247\210 \353\214\200\354\213\234\353\263\264\353\223\234 \353\240\210\354\235\264\354\225\204\354\233\203 (\355\227\244\353\215\224, \354\275\224\354\235\270 \354\204\240\355\203\235\352\270\260, \353\264\207 ON/OFF \355\206\240\352\270\200).\n   - \353\263\200\353\217\231\354\204\261 ATR \354\260\250\355\212\270 \354\230\201\354\227\255: \354\203\201\353\213\250 \353\260\264\353\223\234(\354\235\265\354\240\210\354\204\240), \352\270\260\354\244\200\354\204\240, \355\225\230\353\213\250 \353\260\264\353\223\234(\353\247\244\354\210\230\354\204\240), \353\217\231\354\240\201 \354\206\220\354\240\210\354\204\240\354\235\264 \355\221\234\354\213\234\353\220\230\352\263\240, \355\230\204\354\236\254\352\260\200\352\260\200 \355\216\204\354\212\244 \354\225\240\353\213\210\353\251\224\354\235\264\354\205\230(Pulsing Dot)\354\234\274\353\241\234 \354\233\200\354\247\201\354\235\264\353\212\224 \354\213\234\352\260\201\355\231\224.\n   - \355\225\230\353\213\250 \355\214\214\353\235\274\353\257\270\355\204\260 \354\241\260\354\240\210 \354\212\254\353\235\274\354\235\264\353\215\224(ATR \353\260\260\354\210\230, \354\243\274\353\254\270 \353\271\204\354\234\250) \353\260\217 \354\213\244\354\213\234\352\260\204 \352\260\200\354\203\201 \353\247\244\353\247\244 \353\241\234\352\267\270 \354\266\234\353\240\245 \354\230\201\354\227\255.\n3. Interactive Demo:\n   - \'\353\264\207 ON\' \355\206\240\352\270\200\354\235\204 \354\274\234\353\251\264 1\354\264\210\353\247\210\353\213\244 \352\260\200\354\203\201 \352\260\200\352\262\251 \353\215\260\354\235\264\355\204\260\352\260\200 \352\260\261\354\213\240\353\220\230\353\251\260 \355\216\204\354\212\244 \354\240\220\354\235\264 \354\203\201/\355\225\230\353\213\250 \353\260\264\353\223\234 \354\202\254\354\235\264\353\245\274 \354\233\200\354\247\201\354\235\264\352\263\240, \353\260\264\353\223\234 \355\204\260\354\271\230 \354\213\234 \353\241\234\352\267\270 \354\260\275\354\227\220 [BUY], [SELL] \353\241\234\352\267\270\352\260\200 \354\260\215\355\236\210\353\217\204\353\241\235 \352\260\204\353\213\250\355\225\234 \354\236\220\353\260\224\354\212\244\355\201\254\353\246\275\355\212\270 \355\203\200\354\235\264\353\250\270\353\245\274 \353\202\264\354\236\245\355\225\230\354\204\270\354\232\224.\n\n# Output Format\n- \353\263\204\353\217\204\354\235\230 \354\204\244\353\252\205 \354\227\206\354\235\264 \353\260\224\353\241\234 .html\353\241\234 \354\240\200\354\236\245\355\225\264 \353\270\214\353\235\274\354\232\260\354\240\200\354\227\220\354\204\234 \354\227\264\354\226\264\353\263\274 \354\210\230 \354\236\210\353\212