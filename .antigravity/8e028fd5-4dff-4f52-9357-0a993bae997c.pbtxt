  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef, useMemo } from \'react\';\nimport {\n  Play,\n  Square,\n  TrendingUp,\n  TrendingDown,\n  Activity,\n  Sliders,\n  Terminal,\n  RefreshCw,\n  Zap,\n  ArrowUpRight,\n  ArrowDownRight,\n  ShieldAlert,\n  Wallet,\n  DollarSign,\n  PieChart,\n  Copy,\n  Check,\n  Code,\n  Download,\n  AlertCircle,\n  BarChart2,\n  ChevronDown,\n  Volume2,\n  VolumeX,\n  Layers,\n  Smartphone,\n  Maximize2,\n  Minimize2,\n  Cpu,\n  History,\n  Settings\n} from \'lucide-react\';\n\ninterface TradeLog {\n  id: string;\n  time: string;\n  type: \'BUY\' | \'SELL\' | \'STOP_LOSS\' | \'SYSTEM\';\n  price: number;\n  reason: string;\n  amount?: number;\n  pnl?: number;\n  pnlPercent?: number;\n}\n\ninterface MarketData {\n  symbol: string;\n  name: string;\n  price: number;\n  basePrice: number;\n  atr: number;\n  change24h: number;\n  high24h: number;\n  low24h: number;\n}\n\ninterface PricePoint {\n  time: number;\n  timeLabel: string;\n  price: number;\n  upperBand: number;\n  baseline: number;\n  lowerBand: number;\n  stopLoss: number;\n  event?: \'BUY\' | \'SELL\' | \'STOP_LOSS\';\n}\n\nconst COIN_CONFIGS: Record<string, MarketData> = {\n  \'BTC/USDT\': {\n    symbol: \'BTC/USDT\',\n    name: \'Bitcoin\',\n    price: 96450.0,\n    basePrice: 96450.0,\n    atr: 1250.0,\n    change24h: 3.42,\n    high24h: 97800.0,\n    low24h: 94100.0\n  },\n  \'ETH/USDT\': {\n    symbol: \'ETH/USDT\',\n    name: \'Ethereum\',\n    price: 2780.5,\n    basePrice: 2780.5,\n    atr: 48.0,\n    change24h: -1.15,\n    high24h: 2840.0,\n    low24h: 2710.0\n  },\n  \'SOL/USDT\': {\n    symbol: \'SOL/USDT\',\n    name: \'Solana\',\n    price: 194.2,\n    basePrice: 194.2,\n    atr: 4.8,\n    change24h: 5.68,\n    high24h: 198.5,\n    low24h: 182.0\n  }\n};\n\nexport default function App() {\n  // Mobile Tab view: \'chart\' | \'bot\' | \'logs\' | \'account\'\n  const [activeTab, setActiveTab] = useState<\'chart\' | \'bot\' | \'logs\' | \'account\'>(\'chart\');\n  const [deviceFrameMode, setDeviceFrameMode] = useState<boolean>(true);\n\n  // Market & Coin state\n  const [selectedCoin, setSelectedCoin] = useState<string>(\'BTC/USDT\');\n  const market = COIN_CONFIGS[selectedCoin];\n\n  // Bot Parameters\n  const [isBotActive, setIsBotActive] = useState<boolean>(false);\n  const [atrMultiplier, setAtrMultiplier] = useState<number>(2.0);\n  const [orderRatio, setOrderRatio] = useState<number>(25); // %\n  const [stopLossMultiplier, setStopLossMultiplier] = useState<number>(1.5);\n  const [tickSpeed, setTickSpeed] = useState<number>(1000);\n  const [soundEnabled, setSoundEnabled] = useState<boolean>(true);\n\n  // Financial State\n  const [balance, setBalance] = useState<number>(10000.0);\n  const [initialBalance] = useState<number>(10000.0);\n  const [positionAmount, setPositionAmount] = useState<number>(0);\n  const [entryPrice, setEntryPrice] = useState<number | null>(null);\n  const [totalRealizedPnl, setTotalRealizedPnl] = useState<number>(0);\n  const [totalTrades, setTotalTrades] = useState<number>(0);\n  const [winTrades, setWinTrades] = useState<number>(0);\n\n  // Price & History\n  const [currentPrice, setCurrentPrice] = useState<number>(market.price);\n  const [priceHistory, setPriceHistory] = useState<PricePoint[]>([]);\n  const [logs, setLogs] = useState<TradeLog[]>([]);\n  const [copiedCode, setCopiedCode] = useState<boolean>(false);\n\n  // Refs for loop\n  const currentPriceRef = useRef<number>(market.price);\n  const positionRef = useRef({ amount: positionAmount, entryPrice });\n  const paramsRef = useRef({ atrMultiplier, orderRatio, stopLossMultiplier, isBotActive, balance });\n  const canvasRef = useRef<HTMLCanvasElement>(null);\n\n  useEffect(() => {\n    currentPriceRef.current = currentPrice;\n  }, [currentPrice]);\n\n  useEffect(() => {\n    positionRef.current = { amount: positionAmount, entryPrice };\n  }, [positionAmount, entryPrice]);\n\n  useEffect(() => {\n    paramsRef.current = { atrMultiplier, orderRatio, stopLossMultiplier, isBotActive, balance };\n  }, [atrMultiplier, orderRatio, stopLossMultiplier, isBotActive, balance]);\n\n  const formatPrice = (p: number, coin = selectedCoin) => {\n    if (coin.includes(\'SOL\')) return `$${p.toFixed(2)}`;\n    if (coin.includes(\'ETH\')) return `$${p.toLocaleString(\'en-US\', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\n    return `$${p.toLocaleString(\'en-US\', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}`;\n  };\n\n  // Sound effects\n  const playBeep = (type: \'BUY\' | \'SELL\' | \'STOP\') => {\n    if (!soundEnabled) return;\n    try {\n      const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof window.AudioContext }).webkitAudioContext;\n      if (!AudioCtx) return;\n      const ctx = new AudioCtx();\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.connect(gain);\n      gain.connect(ctx.destination);\n\n      if (type === \'BUY\') {\n        osc.frequency.setValueAtTime(600, ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(900, ctx.currentTime + 0.12);\n        gain.gain.setValueAtTime(0.1, ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);\n        osc.start();\n        osc.stop(ctx.currentTime + 0.15);\n      } else if (type === \'SELL\') {\n        osc.frequency.setValueAtTime(900, ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(1200, ctx.currentTime + 0.15);\n        gain.gain.setValueAtTime(0.12, ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.2);\n        osc.start();\n        osc.stop(ctx.currentTime + 0.2);\n      } else {\n        osc.frequency.setValueAtTime(400, ctx.currentTime);\n        osc.frequency.exponentialRampToValueAtTime(200, ctx.currentTime + 0.18);\n        gain.gain.setValueAtTime(0.12, ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.2);\n        osc.start();\n        osc.stop(ctx.currentTime + 0.2);\n      }\n    } catch {\n      // Audio permission\n    }\n  };\n\n  // Init history\n  useEffect(() => {\n    const base = market.price;\n    const atr = market.atr;\n    const initialPoints: PricePoint[] = [];\n    const now = Date.now();\n\n    let tempPrice = base;\n    for (let i = 35; i >= 0; i--) {\n      const time = now - i * 1000;\n      const noise = (Math.random() - 0.5) * (atr * 0.35);\n      tempPrice = Math.max(tempPrice + noise, base * 0.85);\n\n      const baseline = base + Math.sin(i * 0.2) * (atr * 0.4);\n      const upper = baseline + atr * atrMultiplier;\n      const lower = baseline - atr * atrMultiplier;\n      const stop = lower - atr * stopLossMultiplier;\n\n      const dateObj = new Date(time);\n      const timeLabel = `${dateObj.getHours().toString().padStart(2, \'0\')}:${dateObj.getMinutes().toString().padStart(2, \'0\')}:${dateObj.getSeconds().toString().padStart(2, \'0\')}`;\n\n      initialPoints.push({\n        time,\n        timeLabel,\n        price: Number(tempPrice.toFixed(2)),\n        baseline: Number(baseline.toFixed(2)),\n        upperBand: Number(upper.toFixed(2)),\n        lowerBand: Number(lower.toFixed(2)),\n        stopLoss: Number(stop.toFixed(2))\n      });\n    }\n\n    setPriceHistory(initialPoints);\n    setCurrentPrice(tempPrice);\n    currentPriceRef.current = tempPrice;\n    setPositionAmount(0);\n    setEntryPrice(null);\n\n    setLogs([\n      {\n        id: Math.random().toString(36).substring(7),\n        time: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\', second: \'2-digit\' }),\n        type: \'SYSTEM\',\n        price: tempPrice,\n        reason: `${selectedCoin} \355\216\230\354\226\264 \353\241\234\353\223\234 \354\231\204\353\243\214 (ATR: ${market.atr})`\n      }\n    ]);\n  }, [selectedCoin]);\n\n  const addLog = (log: Omit<TradeLog, \'id\' | \'time\'>) => {\n    const newLog: TradeLog = {\n      ...log,\n      id: Math.random().toString(36).substring(7),\n      time: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\', second: \'2-digit\' })\n    };\n    setLogs((prev) => [newLog, ...prev.slice(0, 50)]);\n  };\n\n  // Bot Tick Engine\n  useEffect(() => {\n    const interval = setInterval(() => {\n      const base = market.basePrice;\n      const atr = market.atr;\n      const prevPrice = currentPriceRef.current;\n\n      const meanReversion = (base - prevPrice) * 0.05;\n      const volatilityStep = (Math.random() - 0.49) * atr * 0.45;\n      const nextPrice = Number((prevPrice + meanReversion + volatilityStep).toFixed(2));\n\n      const baseline = Number((base + Math.sin(Date.now() / 8000) * (atr * 0.3)).toFixed(2));\n      const currentUpper = Number((baseline + atr * paramsRef.current.atrMultiplier).toFixed(2));\n      const currentLower = Number((baseline - atr * paramsRef.current.atrMultiplier).toFixed(2));\n\n      let currentStopLoss = currentLower - atr * paramsRef.current.stopLossMultiplier;\n      if (positionRef.current.amount > 0 && positionRef.current.entryPrice) {\n        currentStopLoss = positionRef.current.entryPrice - atr * paramsRef.current.stopLossMultiplier;\n      }\n      currentStopLoss = Number(currentStopLoss.toFixed(2));\n\n      let eventType: \'BUY\' | \'SELL\' | \'STOP_LOSS\' | undefined = undefined;\n\n      // Strategy\n      if (paramsRef.current.isBotActive) {\n        const { amount, entryPrice: posEntry } = positionRef.current;\n\n        // BUY: touches lower band\n        if (amount === 0 && nextPrice <= currentLower) {\n          const allocateBudget = paramsRef.current.balance * (paramsRef.current.orderRatio / 100);\n          const buyQty = Number((allocateBudget / nextPrice).toFixed(4));\n\n          if (allocateBudget > 10 && buyQty > 0) {\n            setBalance((b) => Number((b - allocateBudget).toFixed(2)));\n            setPositionAmount(buyQty);\n            setEntryPrice(nextPrice);\n            eventType = \'BUY\';\n            playBeep(\'BUY\');\n\n            addLog({\n              type: \'BUY\',\n              price: nextPrice,\n              amount: buyQty,\n              reason: `\355\225\230\353\213\250 \353\260\264\353\223\234(${formatPrice(currentLower)}) \355\204\260\354\271\230 \353\247\244\354\210\230 \354\262\264\352\262\260 [${paramsRef.current.orderRatio}%]`\n            });\n          }\n        }\n        // TAKE PROFIT: touches upper band\n        else if (amount > 0 && posEntry && nextPrice >= currentUpper) {\n          const sellProceeds = amount * nextPrice;\n          const invested = amount * posEntry;\n          const pnl = sellProceeds - invested;\n          const pnlPercent = ((nextPrice - posEntry) / posEntry) * 100;\n\n          setBalance((b) => Number((b + sellProceeds).toFixed(2)));\n          setTotalRealizedPnl((prev) => Number((prev + pnl).toFixed(2)));\n          setTotalTrades((t) => t + 1);\n          if (pnl > 0) setWinTrades((w) => w + 1);\n          setPositionAmount(0);\n          setEntryPrice(null);\n          eventType = \'SELL\';\n          playBeep(\'SELL\');\n\n          addLog({\n            type: \'SELL\',\n            price: nextPrice,\n            amount,\n            pnl,\n            pnlPercent,\n            reason: `\354\203\201\353\213\250 \353\260\264\353\223\234(${formatPrice(currentUpper)}) \354\235\265\354\240\210 \354\262\255\354\202\260 \354\231\204\353\243\214 (+${pnlPercent.toFixed(2)}%)`\n          });\n        }\n        // STOP LOSS\n        else if (amount > 0 && posEntry && nextPrice <= currentStopLoss) {\n          const sellProceeds = amount * nextPrice;\n          const invested = amount * posEntry;\n          const pnl = sellProceeds - invested;\n          const pnlPercent = ((nextPrice - posEntry) / posEntry) * 100;\n\n          setBalance((b) => Number((b + sellProceeds).toFixed(2)));\n          setTotalRealizedPnl((prev) => Number((prev + pnl).toFixed(2)));\n          setTotalTrades((t) => t + 1);\n          setPositionAmount(0);\n          setEntryPrice(null);\n          eventType = \'STOP_LOSS\';\n          playBeep(\'STOP\');\n\n          addLog({\n            type: \'STOP_LOSS\',\n            price: nextPrice,\n            amount,\n            pnl,\n            pnlPercent,\n            reason: `\353\217\231\354\240\201 \354\206\220\354\240\210\354\204\240(${formatPrice(currentStopLoss)}) \353\260\251\354\226\264 \354\206\220\354\240\210 (-${Math.abs(pnlPercent).toFixed(2)}%)`\n          });\n        }\n      }\n\n      const now = Date.now();\n      const dateObj = new Date(now);\n      const timeLabel = `${dateObj.getHours().toString().padStart(2, \'0\')}:${dateObj.getMinutes().toString().padStart(2, \'0\')}:${dateObj.getSeconds().toString().padStart(2, \'0\')}`;\n\n      setCurrentPrice(nextPrice);\n      setPriceHistory((prev) => [\n        ...prev.slice(-35),\n        {\n          time: now,\n          timeLabel,\n          price: nextPrice,\n          baseline,\n          upperBand: currentUpper,\n          lowerBand: currentLower,\n          stopLoss: currentStopLoss,\n          event: eventType\n        }\n      ]);\n    }, tickSpeed);\n\n    return () => clearInterval(interval);\n  }, [market, tickSpeed, selectedCoin]);\n\n  // Canvas mobile chart\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    const rect = canvas.getBoundingClientRect();\n    const dpr = window.devicePixelRatio || 1;\n    canvas.width = rect.width * dpr;\n    canvas.height = rect.height * dpr;\n    ctx.scale(dpr, dpr);\n\n    const width = rect.width;\n    const height = rect.height;\n    const padding = { top: 22, right: 62, bottom: 22, left: 10 };\n    const chartWidth = width - padding.left - padding.right;\n    const chartHeight = height - padding.top - padding.bottom;\n\n    ctx.clearRect(0, 0, width, height);\n    if (priceHistory.length < 2) return;\n\n    let minPrice = Infinity;\n    let maxPrice = -Infinity;\n    priceHistory.forEach((p) => {\n      minPrice = Math.min(minPrice, p.price, p.lowerBand, p.stopLoss);\n      maxPrice = Math.max(maxPrice, p.price, p.upperBand);\n    });\n\n    const priceRange = maxPrice - minPrice || 1;\n    const paddedMin = minPrice - priceRange * 0.08;\n    const paddedMax = maxPrice + priceRange * 0.08;\n    const fullRange = paddedMax - paddedMin;\n\n    const getY = (val: number) => padding.top + chartHeight - ((val - paddedMin) / fullRange) * chartHeight;\n    const getX = (index: number) => padding.left + (index / (priceHistory.length - 1)) * chartWidth;\n\n    // Grid lines\n    ctx.strokeStyle = \'#f1f5f9\';\n    ctx.lineWidth = 1;\n    for (let i = 0; i <= 3; i++) {\n      const y = padding.top + (i / 3) * chartHeight;\n      ctx.beginPath();\n      ctx.moveTo(padding.left, y);\n      ctx.lineTo(width - padding.right, y);\n      ctx.stroke();\n\n      const priceVal = paddedMax - (i / 3) * fullRange;\n      ctx.fillStyle = \'#94a3b8\';\n      ctx.font = \'9px \"JetBrains Mono\", monospace\';\n      ctx.textAlign = \'left\';\n      ctx.fillText(formatPrice(priceVal, selectedCoin), width - padding.right + 6, y + 3);\n    }\n\n    // Shaded ATR Channel\n    ctx.beginPath();\n    for (let i = 0; i < priceHistory.length; i++) {\n      const x = getX(i);\n      const y = getY(priceHistory[i].upperBand);\n      if (i === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    }\n    for (let i = priceHistory.length - 1; i >= 0; i--) {\n      const x = getX(i);\n      const y = getY(priceHistory[i].lowerBand);\n      ctx.lineTo(x, y);\n    }\n    ctx.closePath();\n    ctx.fillStyle = \'rgba(59, 130, 246, 0.05)\';\n    ctx.fill();\n\n    // Bands\n    const drawLine = (prop: keyof PricePoint, color: string, dash: number[] = [], w = 1.4) => {\n      ctx.beginPath();\n      ctx.strokeStyle = color;\n      ctx.lineWidth = w;\n      ctx.setLineDash(dash);\n      priceHistory.forEach((p, idx) => {\n        const x = getX(idx);\n        const y = getY(Number(p[prop]));\n        if (idx === 0) ctx.moveTo(x, y);\n        else ctx.lineTo(x, y);\n      });\n      ctx.stroke();\n      ctx.setLineDash([]);\n    };\n\n    drawLine(\'stopLoss\', \'#f43f5e\', [3, 3], 1.2);\n    drawLine(\'lowerBand\', \'#6366f1\', [4, 3], 1.5);\n    drawLine(\'baseline\', \'#cbd5e1\', [], 1);\n    drawLine(\'upperBand\', \'#10b981\', [4, 3], 1.5);\n\n    // Price Line\n    ctx.beginPath();\n    ctx.strokeStyle = \'#2563eb\';\n    ctx.lineWidth = 2.2;\n    ctx.lineJoin = \'round\';\n    priceHistory.forEach((p, idx) => {\n      const x = getX(idx);\n      const y = getY(p.price);\n      if (idx === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    });\n    ctx.stroke();\n\n    // Markers\n    priceHistory.forEach((p, idx) => {\n      if (!p.event) return;\n      const x = getX(idx);\n      const y = getY(p.price);\n      ctx.save();\n      if (p.event === \'BUY\') {\n        ctx.fillStyle = \'#10b981\';\n        ctx.beginPath();\n        ctx.arc(x, y, 4, 0, Math.PI * 2);\n        ctx.fill();\n      } else if (p.event === \'SELL\') {\n        ctx.fillStyle = \'#059669\';\n        ctx.beginPath();\n        ctx.arc(x, y, 4, 0, Math.PI * 2);\n        ctx.fill();\n      } else if (p.event === \'STOP_LOSS\') {\n        ctx.fillStyle = \'#e11d48\';\n        ctx.beginPath();\n        ctx.arc(x, y, 4, 0, Math.PI * 2);\n        ctx.fill();\n      }\n      ctx.restore();\n    });\n\n    // Current Price Pulsing Dot\n    const lastIdx = priceHistory.length - 1;\n    const lastPoint = priceHistory[lastIdx];\n    const curX = getX(lastIdx);\n    const curY = getY(lastPoint.price);\n\n    ctx.save();\n    ctx.beginPath();\n    ctx.arc(curX, curY, 8, 0, Math.PI * 2);\n    ctx.fillStyle = \'rgba(37, 99, 235, 0.25)\';\n    ctx.fill();\n\n    ctx.beginPath();\n    ctx.arc(curX, curY, 4, 0, Math.PI * 2);\n    ctx.fillStyle = \'#2563eb\';\n    ctx.fill();\n    ctx.restore();\n\n    // Right Axis Label\n    ctx.fillStyle = \'#2563eb\';\n    ctx.beginPath();\n    ctx.roundRect(width - padding.right + 4, curY - 9, padding.right - 8, 18, 4);\n    ctx.fill();\n    ctx.fillStyle = \'#ffffff\';\n    ctx.font = \'bold 9.5px \"JetBrains Mono\", monospace\';\n    ctx.textAlign = \'left\';\n    ctx.fillText(formatPrice(lastPoint.price, selectedCoin), width - padding.right + 7, curY + 3.5);\n  }, [priceHistory, selectedCoin]);\n\n  // Position calculations\n  const unrealizedPnl = useMemo(() => {\n    if (positionAmount === 0 || !entryPrice) return 0;\n    return (currentPrice - entryPrice) * positionAmount;\n  }, [positionAmount, entryPrice, currentPrice]);\n\n  const unrealizedPnlPercent = useMemo(() => {\n    if (positionAmount === 0 || !entryPrice) return 0;\n    return ((currentPrice - entryPrice) / entryPrice) * 100;\n  }, [positionAmount, entryPrice, currentPrice]);\n\n  const currentEquity = balance + positionAmount * currentPrice;\n  const totalReturnPercent = ((currentEquity - initialBalance) / initialBalance) * 100;\n  const winRate = totalTrades > 0 ? ((winTrades / totalTrades) * 100).toFixed(1) : \'0.0\';\n\n  const handleManualBuy = () => {\n    if (positionAmount > 0) return;\n    const allocateBudget = balance * (orderRatio / 100);\n    const buyQty = Number((allocateBudget / currentPrice).toFixed(4));\n    if (allocateBudget <= 0) return;\n\n    setBalance((b) => Number((b - allocateBudget).toFixed(2)));\n    setPositionAmount(buyQty);\n    setEntryPrice(currentPrice);\n    playBeep(\'BUY\');\n    addLog({\n      type: \'BUY\',\n      price: currentPrice,\n      amount: buyQty,\n      reason: `[\354\210\230\353\217\231 \354\243\274\353\254\270] \354\213\234\354\236\245\352\260\200 \353\247\244\354\210\230 \354\262\264\352\262\260 - \355\210\254\354\236\220\352\270\210 $${allocateBudget.toFixed(2)}`\n    });\n  };\n\n  const handleManualSell = () => {\n    if (positionAmount === 0 || !entryPrice) return;\n    const proceeds = positionAmount * currentPrice;\n    const invested = positionAmount * entryPrice;\n    const pnl = proceeds - invested;\n    const pnlPercent = ((currentPrice - entryPrice) / entryPrice) * 100;\n\n    setBalance((b) => Number((b + proceeds).toFixed(2)));\n    setTotalRealizedPnl((prev) => Number((prev + pnl).toFixed(2)));\n    setTotalTrades((t) => t + 1);\n    if (pnl > 0) setWinTrades((w) => w + 1);\n    setPositionAmount(0);\n    setEntryPrice(null);\n    playBeep(\'SELL\');\n\n    addLog({\n      type: \'SELL\',\n      price: currentPrice,\n      amount: positionAmount,\n      pnl,\n      pnlPercent,\n      reason: `[\354\210\230\353\217\231 \354\262\255\354\202\260] \354\213\234\354\236\245\352\260\200 \354\240\204\353\237\211 \353\247\244\353\217\204 \354\262\264\352\262\260 (${pnl >= 0 ? \'+\' : \'\'}$${pnl.toFixed(2)})`\n    });\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-100 flex flex-col items-center justify-center sm:p-4 text-slate-900 font-[\'Plus_Jakarta_Sans\',sans-serif]\">\n      {/* Top Device Switcher Banner (on Desktop) */}\n      <div className=\"hidden sm:flex items-center justify-between max-w-sm w-full mb-3 px-2 text-xs text-slate-500 font-medium\">\n        <div className=\"flex items-center gap-1.5 font-bold text-slate-700\">\n          <Smartphone className=\"w-4 h-4 text-blue-600\" />\n          <span>\353\252\250\353\260\224\354\235\274 \354\212\244\353\247\210\355\212\270\355\217\260 \353\267\260\355\217\254\355\212\270 \354\265\234\354\240\201\355\231\224 (390\303\227844)</span>\n        </div>\n        <button\n          onClick={() => setDeviceFrameMode(!deviceFrameMode)}\n          className=\"flex items-center gap-1 px-2.5 py-1 rounded-md bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold shadow-2xs transition\"\n        >\n          {deviceFrameMode ? <Maximize2 className=\"w-3 h-3\" /> : <Minimize2 className=\"w-3 h-3\" />}\n          <span>{deviceFrameMode ? \'\354\240\204\354\262\264\355\231\224\353\251\264\' : \'\355\224\204\353\240\210\354\236\204 \353\252\250\353\223\234\'}</span>\n        </button>\n      </div>\n\n      {/* Main Mobile Screen Container (390px iPhone standard ratio or full width on real mobile) */}\n      <div\n        className={`w-full bg-slate-50 flex flex-col transition-all overflow-hidden ${\n          deviceFrameMode\n            ? \'sm:max-w-[400px] sm:h-[840px] sm:rounded-[40px] sm:border-[8px] sm:border-slate-800 sm:shadow-2xl\'\n            : \'max-w-md min-h-screen sm:rounded-2xl sm:shadow-xl sm:border border-slate-200\'\n        }`}\n      >\n        {/* Mobile Status Bar (Notch / Time / Icons) */}\n        <div className=\"bg-white px-5 pt-3 pb-1.5 flex items-center justify-between text-xs font-bold text-slate-800 select-none border-b border-slate-100\">\n          <span>9:41</span>\n          <div className=\"w-20 h-4 bg-slate-900 rounded-full sm:block hidden opacity-90\"></div>\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"text-[10px] font-bold text-blue-600\">5G</span>\n            <div className=\"w-5 h-2.5 border border-slate-800 rounded-xs p-0.5 flex items-center\">\n              <div className=\"w-full h-full bg-slate-800 rounded-2xs\"></div>\n            </div>\n          </div>\n        </div>\n\n        {/* Mobile App Header */}\n        <header className=\"bg-white px-4 py-2.5 flex items-center justify-between border-b border-slate-200 shadow-2xs shrink-0\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center text-white font-bold shadow-2xs\">\n              <Activity className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-1.5\">\n                <h1 className=\"font-extrabold text-slate-900 text-sm leading-none\">ATR BOT</h1>\n                <span\n                  className={`text-[9px] font-bold px-1.5 py-0.2 rounded-full ${\n                    isBotActive ? \'bg-emerald-100 text-emerald-800 animate-pulse\' : \'bg-slate-100 text-slate-600\'\n                  }`}\n                >\n                  {isBotActive ? \'RUNNING\' : \'IDLE\'}\n                </span>\n              </div>\n              <p className=\"text-[10px] text-slate-400 font-medium mt-0.5\">\353\263\200\353\217\231\354\204\261 \353\260\264\353\223\234 \354\236\220\353\217\231\353\247\244\353\247\244</p>\n            </div>\n          </div>\n\n          {/* Coin Selector Dropdown */}\n          <div className=\"flex items-center gap-2\">\n            <select\n              value={selectedCoin}\n              onChange={(e) => setSelectedCoin(e.target.value)}\n              className=\"bg-slate-100 font-bold text-xs text-slate-800 px-2.5 py-1.5 rounded-lg border border-slate-200 focus:outline-none cursor-pointer\"\n            >\n              <option value=\"BTC/USDT\">BTC/USDT</option>\n              <option value=\"ETH/USDT\">ETH/USDT</option>\n              <option value=\"SOL/USDT\">SOL/USDT</option>\n            </select>\n\n            <button\n              onClick={() => setSoundEnabled(!soundEnabled)}\n              className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-700 bg-slate-100 border border-slate-200\"\n              title=\"\354\202\254\354\232\264\353\223\234 \355\206\240\352\270\200\"\n            >\n              {soundEnabled ? <Volume2 className=\"w-3.5 h-3.5 text-blue-600\" /> : <VolumeX className=\"w-3.5 h-3.5\" />}\n            </button>\n          </div>\n        </header>\n\n        {/* Live Price Header Card (Mobile Compact) */}\n        <div className=\"bg-white px-4 py-3 border-b border-slate-200 flex items-center justify-between shrink-0\">\n          <div>\n            <div className=\"text-[10px] font-semibold text-slate-400 uppercase tracking-wider\">\354\213\244\354\213\234\352\260\204 \354\213\234\354\204\270</div>\n            <div className=\"text-xl font-extrabold mono text-slate-900 tracking-tight leading-tight\">\n              {formatPrice(currentPrice)}\n            </div>\n          </div>\n          <div className=\"text-right\">\n            <div\n              className={`text-xs font-bold flex items-center justify-end gap-0.5 ${\n                market.change24h >= 0 ? \'text-emerald-600\' : \'text-rose-600\'\n              }`}\n            >\n              {market.change24h >= 0 ? <ArrowUpRight className=\"w-3.5 h-3.5\" /> : <ArrowDownRight className=\"w-3.5 h-3.5\" />}\n              <span>{market.change24h >= 0 ? `+${market.change24h}%` : `${market.change24h}%`}</span>\n            </div>\n            <div className=\"text-[10px] text-slate-400 mono\">ATR: {formatPrice(market.atr)}</div>\n          </div>\n        </div>\n\n        {/* Main Scrollable Content Area based on Active Tab */}\n        <div className=\"flex-1 overflow-y-auto p-3 space-y-3\">\n          {activeTab === \'chart\' && (\n            <>\n              {/* Asset & Position Quick Cards */}\n              <div className=\"grid grid-cols-2 gap-2\">\n                <div className=\"bg-white p-3 rounded-xl border border-slate-200 shadow-2xs\">\n                  <div className=\"text-[10px] font-semibold text-slate-400\">\354\264\235 \354\236\220\354\202\260 (Equity)</div>\n                  <div className=\"text-base font-extrabold mono text-slate-900 mt-0.5\">${currentEquity.toLocaleString(\'en-US\', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}</div>\n                  <div className={`text-[10px] font-bold ${totalReturnPercent >= 0 ? \'text-emerald-600\' : \'text-rose-600\'}`}>\n                    \354\210\230\354\235\265\353\245\240: {totalReturnPercent >= 0 ? \'+\' : \'\'}{totalReturnPercent.toFixed(2)}%\n                  </div>\n                </div>\n\n                <div className=\"bg-white p-3 rounded-xl border border-slate-200 shadow-2xs\">\n                  <div className=\"text-[10px] font-semibold text-slate-400\">\355\230\204\354\236\254 \355\217\254\354\247\200\354\205\230</div>\n                  <div className=\"text-sm font-extrabold mono text-indigo-700 mt-0.5 truncate\">\n                    {positionAmount > 0 ? `LONG ${positionAmount}` : \'FLAT (\353\254\264\355\217\254\354\247\200\354\205\230)\'}\n                  </div>\n                  <div className={`text-[10px] font-bold ${unrealizedPnl >= 0 ? \'text-emerald-600\' : \'text-rose-600\'}`}>\n                    \354\206\220\354\235\265: {unrealizedPnl >= 0 ? \'+\' : \'\'}${unrealizedPnl.toFixed(2)} ({unrealizedPnlPercent.toFixed(1)}%)\n                  </div>\n                </div>\n              </div>\n\n              {/* Chart Card */}\n              <div className=\"bg-white p-3 rounded-2xl border border-slate-200 shadow-2xs space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <BarChart2 className=\"w-3.5 h-3.5 text-blue-600\" />\n                    <span className=\"text-xs font-bold text-slate-800\">ATR \353\260\264\353\223\234 \354\213\244\354\213\234\352\260\204 \354\260\250\355\212\270</span>\n                  </div>\n                  {/* Legend chips */}\n                  <div className=\"flex items-center gap-2 text-[9px] font-semibold\">\n                    <span className=\"text-emerald-600 flex items-center gap-1\"><span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500\"></span>\354\235\265\354\240\210\354\204\240</span>\n                    <span className=\"text-indigo-600 flex items-center gap-1\"><span className=\"w-1.5 h-1.5 rounded-full bg-indigo-500\"></span>\353\247\244\354\210\230\354\204\240</span>\n                    <span className=\"text-rose-600 flex items-center gap-1\"><span className=\"w-1.5 h-1.5 rounded-full bg-rose-500\"></span>\354\206\220\354\240\210\354\204\240</span>\n                  </div>\n                </div>\n\n                {/* Mobile Canvas Height */}\n                <div className=\"relative w-full h-[220px] bg-slate-50/80 rounded-xl border border-slate-200 overflow-hidden\">\n                  <canvas ref={canvasRef} className=\"w-full h-full block\" />\n                  <div className=\"absolute top-1.5 left-2 text-[9px] text-slate-400 mono\">\n                    1s \354\213\244\354\213\234\352\260\204 \355\213\261\n                  </div>\n                </div>\n\n                {/* Quick Manual Action Buttons */}\n                <div className=\"grid grid-cols-2 gap-2 pt-1\">\n                  <button\n                    onClick={handleManualBuy}\n                    disabled={positionAmount > 0}\n                    className=\"py-2 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 disabled:opacity-40 text-white font-bold text-xs flex items-center justify-center gap-1 shadow-2xs active:scale-98 transition\"\n                  >\n                    <ArrowUpRight className=\"w-3.5 h-3.5\" />\n                    <span>\354\210\230\353\217\231 \353\247\244\354\210\230 (BUY)</span>\n                  </button>\n                  <button\n                    onClick={handleManualSell}\n                    disabled={positionAmount === 0}\n                    className=\"py-2 px-3 rounded-xl bg-rose-600 hover:bg-rose-700 disabled:opacity-40 text-white font-bold text-xs flex items-center justify-center gap-1 shadow-2xs active:scale-98 transition\"\n                  >\n                    <ArrowDownRight className=\"w-3.5 h-3.5\" />\n                    <span>\354\240\204\353\237\211 \354\262\255\354\202\260 (SELL)</span>\n                  </button>\n                </div>\n              </div>\n\n              {/* Bot Control Card */}\n              <div className=\"bg-white p-3.5 rounded-2xl border border-slate-200 shadow-2xs flex items-center justify-between\">\n                <div>\n                  <div className=\"text-xs font-extrabold text-slate-900\">ATR \354\236\220\353\217\231 \355\212\270\353\240\210\354\235\264\353\224\251 \353\264\207</div>\n                  <div className=\"text-[10px] text-slate-500 mt-0.5\">\n                    \353\260\264\353\223\234 \355\204\260\354\271\230 \354\213\234 \354\236\220\353\217\231 \353\247\244\354\210\230/\354\235\265\354\240\210/\354\206\220\354\240\210\n                  </div>\n                </div>\n                <button\n                  onClick={() => setIsBotActive(!isBotActive)}\n                  className={`px-4 py-2.5 rounded-xl font-bold text-xs flex items-center gap-1.5 shadow-sm active:scale-95 transition ${\n                    isBotActive\n                      ? \'bg-rose-600 hover:bg-rose-700 text-white ring-2 ring-rose-200\'\n                      : \'bg-blue-600 hover:bg-blue-700 text-white ring-2 ring-blue-200\'\n                  }`}\n                >\n                  {isBotActive ? <Square className=\"w-3.5 h-3.5 fill-white\" /> : <Play className=\"w-3.5 h-3.5 fill-white\" />}\n                  <span>{isBotActive ? \'\353\264\207 \354\240\225\354\247\200\' : \'\353\264\207 \352\260\200\353\217\231 (ON)\'}</span>\n                </button>\n              </div>\n\n              {/* Mini Recent Log Feed */}\n              <div className=\"bg-white p-3 rounded-2xl border border-slate-200 shadow-2xs space-y-2\">\n                <div className=\"flex items-center justify-between text-xs font-bold text-slate-800\">\n                  <span className=\"flex items-center gap-1\">\n                    <Terminal className=\"w-3.5 h-3.5 text-slate-600\" />\n                    \354\265\234\352\267\274 \353\247\244\353\247\244 \353\241\234\352\267\270\n                  </span>\n                  <button onClick={() => setActiveTab(\'logs\')} className=\"text-[11px] text-blue-600 font-semibold\">\n                    \354\240\204\354\262\264\353\263\264\352\270\260 ({logs.length})\n                  </button>\n                </div>\n                <div className=\"space-y-1.5 text-[11px] mono\">\n                  {logs.slice(0, 3).map((log) => (\n                    <div\n                      key={log.id}\n                      className={`p-2 rounded-lg border flex items-center justify-between ${\n                        log.type === \'BUY\'\n                          ? \'bg-emerald-50/70 border-emerald-200 text-emerald-900\'\n                          : log.type === \'SELL\'\n                          ? \'bg-blue-50/70 border-blue-200 text-blue-900\'\n                          : log.type === \'STOP_LOSS\'\n                          ? \'bg-rose-50/70 border-rose-200 text-rose-900\'\n                          : \'bg-slate-50 border-slate-200 text-slate-700\'\n                      }`}\n                    >\n                      <div className=\"flex items-center gap-1.5 truncate\">\n                        <span className=\"font-bold text-[9px] px-1 py-0.2 rounded bg-white/80 border\">\n                          {log.type}\n                        </span>\n                        <span className=\"truncate\">{log.reason}</span>\n                      </div>\n                      <span className=\"shrink-0 font-bold ml-2\">{formatPrice(log.price)}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </>\n          )}\n\n          {activeTab === \'bot\' && (\n            <div className=\"space-y-3\">\n              {/* Bot Parameter Tuning Form */}\n              <div className=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs space-y-4\">\n                <div className=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <Sliders className=\"w-4 h-4 text-blue-600\" />\n                    <h2 className=\"font-bold text-sm text-slate-900\">\353\264\207 \355\214\214\353\235\274\353\257\270\355\204\260 \353\257\270\354\204\270\354\241\260\354\240\210</h2>\n                  </div>\n                  <span className=\"text-[10px] text-slate-400 font-mono\">Real-time Apply</span>\n                </div>\n\n                {/* ATR Multiplier Slider */}\n                <div className=\"space-y-1.5\">\n                  <div className=\"flex justify-between text-xs font-bold\">\n                    <span className=\"text-slate-700\">ATR \353\260\264\353\223\234 \353\260\260\354\210\230</span>\n                    <span className=\"text-blue-600 mono\">{atrMultiplier.toFixed(1)}x</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"1.0\"\n                    max=\"4.0\"\n                    step=\"0.1\"\n                    value={atrMultiplier}\n                    onChange={(e) => setAtrMultiplier(parseFloat(e.target.value))}\n                    className=\"w-full accent-blue-600 cursor-pointer h-2 bg-slate-200 rounded-lg appearance-none\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-slate-400\">\n                    <span>1.0x (\355\203\200\354\235\264\355\212\270)</span>\n                    <span>2.0x (\355\221\234\354\244\200)</span>\n                    <span>4.0x (\354\231\200\354\235\264\353\223\234)</span>\n                  </div>\n                </div>\n\n                {/* Order Ratio Slider */}\n                <div className=\"space-y-1.5\">\n                  <div className=\"flex justify-between text-xs font-bold\">\n                    <span className=\"text-slate-700\">1\355\232\214 \354\247\204\354\236\205 \353\271\204\354\244\221</span>\n                    <span className=\"text-blue-600 mono\">{orderRatio}%</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"5\"\n                    max=\"100\"\n                    step=\"5\"\n                    value={orderRatio}\n                    onChange={(e) => setOrderRatio(parseInt(e.target.value))}\n                    className=\"w-full accent-blue-600 cursor-pointer h-2 bg-slate-200 rounded-lg appearance-none\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-slate-400\">\n                    <span>5% (\353\266\204\355\225\240)</span>\n                    <span>25% (\354\266\224\354\262\234)</span>\n                    <span>100% (\354\230\254\354\235\270)</span>\n                  </div>\n                </div>\n\n                {/* Stop Loss Multiplier Slider */}\n                <div className=\"space-y-1.5\">\n                  <div className=\"flex justify-between text-xs font-bold\">\n                    <span className=\"text-slate-700\">\353\217\231\354\240\201 \354\206\220\354\240\210 \353\260\260\354\210\230 (SL)</span>\n                    <span className=\"text-rose-600 mono\">{stopLossMultiplier.toFixed(1)}x</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0.5\"\n                    max=\"3.0\"\n                    step=\"0.1\"\n                    value={stopLossMultiplier}\n                    onChange={(e) => setStopLossMultiplier(parseFloat(e.target.value))}\n                    className=\"w-full accent-rose-600 cursor-pointer h-2 bg-slate-200 rounded-lg appearance-none\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-slate-400\">\n                    <span>0.5x (\354\271\274\354\206\220\354\240\210)</span>\n                    <span>1.5x (\352\266\214\354\236\245)</span>\n                    <span>3.0x (\354\227\254\354\234\240)</span>\n                  </div>\n                </div>\n\n                {/* Tick Speed Toggle */}\n                <div className=\"pt-2 border-t border-slate-100 flex items-center justify-between\">\n                  <span className=\"text-xs font-bold text-slate-700\">\355\213\261 \352\260\261\354\213\240 \354\243\274\352\270\260</span>\n                  <div className=\"flex gap-1\">\n                    <button\n                      onClick={() => setTickSpeed(1000)}\n                      className={`px-3 py-1 text-xs font-bold rounded-lg ${\n                        tickSpeed === 1000 ? \'bg-blue-600 text-white\' : \'bg-slate-100 text-slate-600\'\n                      }`}\n                    >\n                      1\354\264\210\n                    </button>\n                    <button\n                      onClick={() => setTickSpeed(500)}\n                      className={`px-3 py-1 text-xs font-bold rounded-lg ${\n                        tickSpeed === 500 ? \'bg-blue-600 text-white\' : \'bg-slate-100 text-slate-600\'\n                      }`}\n                    >\n                      0.5\354\264\210 (Fast)\n                    </button>\n                  </div>\n                </div>\n              </div>\n\n              {/* Bot Control Big Button */}\n              <button\n                onClick={() => setIsBotActive(!isBotActive)}\n                className={`w-full py-3.5 rounded-2xl font-extrabold text-sm flex items-center justify-center gap-2 shadow-sm transition active:scale-98 ${\n                  isBotActive\n                    ? \'bg-rose-600 hover:bg-rose-700 text-white\'\n                    : \'bg-blue-600 hover:bg-blue-700 text-white\'\n                }`}\n              >\n                {isBotActive ? <Square className=\"w-4 h-4 fill-white\" /> : <Play className=\"w-4 h-4 fill-white\" />}\n                <span>{isBotActive ? \'\354\236\220\353\217\231 \353\264\207 \354\240\225\354\247\200 (IDLE)\' : \'\354\236\220\353\217\231 \353\264\207 \352\260\200\353\217\231 \354\213\234\354\236\221 (START)\'}</span>\n              </button>\n            </div>\n          )}\n\n          {activeTab === \'logs\' && (\n            <div className=\"bg-white p-3 rounded-2xl border border-slate-200 shadow-2xs space-y-2 flex flex-col h-[520px]\">\n              <div className=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n                <div className=\"flex items-center gap-1.5 font-bold text-xs text-slate-900\">\n                  <Terminal className=\"w-4 h-4 text-slate-600\" />\n                  <span>\354\213\244\354\213\234\352\260\204 \354\262\264\352\262\260 \353\260\217 \354\213\234\354\212\244\355\205\234 \353\241\234\352\267\270 ({logs.length})</span>\n                </div>\n                <button\n                  onClick={() => setLogs([])}\n                  className=\"text-[11px] text-slate-400 hover:text-slate-700 font-semibold\"\n                >\n                  \354\247\200\354\232\260\352\270\260\n                </button>\n              </div>\n\n              <div className=\"flex-1 overflow-y-auto space-y-1.5 pr-1 mono text-[11px]\">\n                {logs.length === 0 ? (\n                  <div className=\"text-center py-10 text-slate-400\">\354\262\264\352\262\260 \353\241\234\352\267\270\352\260\200 \354\227\206\354\212\265\353\213\210\353\213\244.</div>\n                ) : (\n                  logs.map((log) => (\n                    <div\n                      key={log.id}\n                      className={`p-2.5 rounded-xl border flex items-start gap-2 ${\n                        log.type === \'BUY\'\n                          ? \'bg-emerald-50/80 border-emerald-200 text-emerald-950\'\n                          : log.type === \'SELL\'\n                          ? \'bg-blue-50/80 border-blue-200 text-blue-950\'\n                          : log.type === \'STOP_LOSS\'\n                          ? \'bg-rose-50/80 border-rose-200 text-rose-950\'\n                          : \'bg-slate-50 border-slate-200 text-slate-700\'\n                      }`}\n                    >\n                      <span className=\"text-[10px] text-slate-400 shrink-0 mt-0.5\">{log.time}</span>\n                      <span\n                        className={`text-[9px] font-extrabold px-1.5 py-0.5 rounded uppercase shrink-0 ${\n                          log.type === \'BUY\'\n                            ? \'bg-emerald-600 text-white\'\n                            : log.type === \'SELL\'\n                            ? \'bg-blue-600 text-white\'\n                            : log.type === \'STOP_LOSS\'\n                            ? \'bg-rose-600 text-white\'\n                            : \'bg-slate-200 text-slate-700\'\n                        }`}\n                      >\n                        {log.type}\n                      </span>\n                      <div className=\"flex-1 leading-tight font-medium\">\n                        <div>{log.reason}</div>\n                        {log.pnl !== undefined && (\n                          <div className={`text-[10px] font-bold mt-0.5 ${log.pnl >= 0 ? \'text-emerald-600\' : \'text-rose-600\'}`}>\n                            \354\206\220\354\235\265: {log.pnl >= 0 ? \'+\' : \'\'}${log.pnl.toFixed(2)} ({log.pnlPercent?.toFixed(2)}%)\n                          </div>\n                        )}\n                      </div>\n                      <span className=\"font-bold shrink-0\">{formatPrice(log.price)}</span>\n                    </div>\n                  ))\n                )}\n              </div>\n            </div>\n          )}\n\n          {activeTab === \'account\' && (\n            <div className=\"space-y-3\">\n              {/* Account Overview */}\n              <div className=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs space-y-3\">\n                <h3 className=\"font-bold text-sm text-slate-900 flex items-center gap-1.5\">\n                  <Wallet className=\"w-4 h-4 text-blue-600\" />\n                  <span>\352\260\200\354\203\201 \352\263\204\354\242\214 \353\260\217 \352\261\260\353\236\230 \354\204\261\352\263\274</span>\n                </h3>\n\n                <div className=\"space-y-2 text-xs\">\n                  <div className=\"flex justify-between py-1.5 border-b border-slate-100\">\n                    <span className=\"text-slate-500\">\354\264\210\352\270\260 \355\210\254\354\236\220 \354\233\220\352\270\210</span>\n                    <span className=\"font-bold mono\">$10,000.00</span>\n                  </div>\n                  <div className=\"flex justify-between py-1.5 border-b border-slate-100\">\n                    <span className=\"text-slate-500\">\355\230\204\354\236\254 \354\264\235 \355\217\211\352\260\200\354\225\241</span>\n                    <span className=\"font-bold mono text-blue-600\">${currentEquity.toFixed(2)}</span>\n                  </div>\n                  <div className=\"flex justify-between py-1.5 border-b border-slate-100\">\n                    <span className=\"text-slate-500\">\353\210\204\354\240\201 \354\213\244\355\230\204 \354\206\220\354\235\265</span>\n                    <span className={`font-bold mono ${totalRealizedPnl >= 0 ? \'text-emerald-600\' : \'text-rose-600\'}`}>\n                      {totalRealizedPnl >= 0 ? \'+\' : \'\'}${totalRealizedPnl.toFixed(2)}\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between py-1.5 border-b border-slate-100\">\n                    <span className=\"text-slate-500\">\354\264\235 \354\262\264\352\262\260 \355\232\237\354\210\230</span>\n                    <span className=\"font-bold mono\">{totalTrades}\355\232\214</span>\n                  </div>\n                  <div className=\"flex justify-between py-1.5\">\n                    <span className=\"text-slate-500\">\354\212\271\353\245\240 (Win Rate)</span>\n                    <span className=\"font-bold mono text-emerald-600\">{winRate}%</span>\n                  </div>\n                </div>\n\n                <button\n                  onClick={() => {\n                    setBalance(10000);\n                    setPositionAmount(0);\n                    setEntryPrice(null);\n                    setTotalRealizedPnl(0);\n                    setTotalTrades(0);\n                    setWinTrades(0);\n                    addLog({\n                      type: \'SYSTEM\',\n                      price: currentPrice,\n                      reason: \'\352\260\200\354\203\201 \352\263\204\354\242\214 \354\236\220\354\202\260 \354\264\210\352\270\260\355\231\224 ($10,000 USD)\'\n                    });\n                  }}\n                  className=\"w-full py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 flex items-center justify-center gap-1.5\"\n                >\n                  <RefreshCw className=\"w-3.5 h-3.5\" />\n                  <span>\352\260\200\354\203\201 \352\263\204\354\242\214 \354\264\210\352\270\260\355\231\224</span>\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Mobile Bottom Tab Bar (Thumb friendly navigation) */}\n        <nav className=\"bg-white border-t border-slate-200 px-3 py-2 flex items-center justify-around shrink-0 shadow-sm\">\n          <button\n            onClick={() => setActiveTab(\'chart\')}\n            className={`flex flex-col items-center gap-1 px-3 py-1 rounded-xl transition ${\n              activeTab === \'chart\' ? \'text-blue-600 font-bold\' : \'text-slate-400 font-medium\'\n            }`}\n          >\n            <BarChart2 className=\"w-5 h-5\" />\n            <span className=\"text-[10px]\">\354\260\250\355\212\270 & \353\247\244\353\247\244</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'bot\')}\n            className={`flex flex-col items-center gap-1 px-3 py-1 rounded-xl transition ${\n              activeTab === \'bot\' ? \'text-blue-600 font-bold\' : \'text-slate-400 font-medium\'\n            }`}\n          >\n            <Sliders className=\"w-5 h-5\" />\n            <span className=\"text-[10px]\">\353\264\207 \354\204\244\354\240\225</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'logs\')}\n            className={`flex flex-col items-center gap-1 px-3 py-1 rounded-xl transition relative ${\n              activeTab === \'logs\' ? \'text-blue-600 font-bold\' : \'text-slate-400 font-medium\'\n            }`}\n          >\n            <Terminal className=\"w-5 h-5\" />\n            <span className=\"text-[10px]\">\354\262\264\352\262\260 \353\241\234\352\267\270</span>\n            {logs.length > 0 && (\n              <span className=\"absolute top-0 right-2 w-2 h-2 rounded-full bg-blue-600\"></span>\n            )}\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'account\')}\n            className={`flex flex-col items-center gap-1 px-3 py-1 rounded-xl transition ${\n              activeTab === \'account\' ? \'text-blue-600 font-bold\' : \'text-slate-400 font-medium\'\n            }`}\n          >\n            <Wallet className=\"w-5 h-5\" />\n            <span className=\"text-[10px]\">\353\202\264 \352\263\204\354\242\214</span>\n          </button>\n        </nav>\n      </div>\n    </div>\n  );\n}\n"
    }
